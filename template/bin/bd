#!/bin/sh
# Project-local bd: finds its project from its own location; nothing outside the project is used.
[ "${1:-}" = serve ] || [ "${MM_TRACE_SELF:-}" = "$0" ] || MM_TRACE_SELF=$0 exec "$(dirname "$(readlink -f "$0")")/trace" "bd ${1:-}" -- "$0" "$@"  # bd serve is a service: not one span
P=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# Structured content (sy-rfup): bd msg, bd task and bd card build a checked block (bin/structured) and post it through
# this same bd, so every gate below still runs on it.
case "${1:-}" in msg|task|card) exec "$P/bin/structured" "$@" ;; esac
# A board write names its writer (sy-28ev): --actor <name>, or BEADS_ACTOR / BD_ACTOR. Without one bd would record the
# machine user (`mm`), which reads as a person. comment(s add), update, close, create, q, reopen, delete, assign, edit,
# set-state, label add|remove, dep add|remove|relate|unrelate are refused with no actor; reads (list, show, ready,
# comments <id>, label list, dep list|tree, ...) need none. Arguments after `--` are text, never read here.
actor=${BEADS_ACTOR:-${BD_ACTOR:-}} cmd='' sub='' next=''
for a in "$@"; do
  if [ -n "$next" ]; then actor=$a; next=''; continue; fi
  case "$a" in
    --) break ;;
    --actor) next=1 ;;
    --actor=*) actor=${a#--actor=} ;;
    -*) ;;
    *) if [ -z "$cmd" ]; then cmd=$a; elif [ -z "$sub" ]; then sub=$a; fi ;;
  esac
done
case "$cmd:$sub" in
  comment:*|update:*|close:*|create:*|q:*|reopen:*|delete:*|assign:*|edit:*|set-state:*|comments:add|label:add|label:remove|dep:add|dep:remove|dep:rm|dep:relate|dep:unrelate)
    [ -n "$actor" ] || { echo "bd: refused: a board write (bd $cmd${sub:+ $sub}) needs an actor: pass --actor <name> or set BEADS_ACTOR (without one bd records \"mm\", which reads as a person)" >&2; exit 1; } ;;
esac
# Only review signs off (sy-9bss): signed-off and signed-head:<repo>@<sha> are added or removed by the actor review (or
# review/<worker>: the role is the part before /) only. For any other actor, a label call whose arguments name one (or
# set the labels: --set-labels drops a sign-off it leaves out) is checked by bin/owner-card signoff, which reads the
# item (bd show) only for --set-labels. Every other call costs only this loop.
case "$cmd" in
  create|q|new|update|edit|label)
    case "${actor%%/*}" in review) ;; *)
      for a in "$@"; do case "$a" in --) break ;; *signed-off*|*signed-head:*|--set-labels|--set-labels=*) "$P/bin/owner-card" signoff -- "$@" || exit 1; break ;; esac; done ;;
    esac ;;
esac
# needs-you only with a valid owner card (sy-z5lz): a call that adds it (label add, update --add-label/-l/--set-labels,
# create/q -l/--labels) is checked by bin/owner-card gate, which reads the item (bd show) only then. Every other call,
# and removing the label, costs nothing more than this loop over the arguments.
case "$cmd:$sub" in
  create:*|q:*|new:*|update:*|edit:*|label:add)
    # ...and adding t2 to an item that waits on the owner (sy-l9uc): t2 is matched as a whole label, never inside an id
    for a in "$@"; do case "$a" in --) break ;; *needs-you*|t2|t2,*|*,t2|*,t2,*|*=t2|*=t2,*) "$P/bin/owner-card" gate -- "$@" || exit 1; break ;; esac; done ;;
esac
# A lead's comment is one message (sy-0gsw): bd comments add / bd comment by a role of leads/roles.json (or its worker
# <role>/<name>) is checked by bin/message gate, which refuses free text with the reasons and the format. wake,
# watchdog, bridge, mm-upstream and the people are not roles: their comments pass unread.
case "$cmd:$sub" in
  comments:add|comment:*) "$P/bin/message" gate "$actor" -- "$@" || exit 1 ;;
esac
# A lead's item has a Task (sy-lusk): bd create / q / new, and bd update / edit that sets a description, by a role (or
# its worker) is checked by bin/task gate, which refuses a description with no valid Task (Act: an activity of
# leads/raci.json). Other actors pass unread there; an update that names no description costs only this loop.
case "$cmd" in
  create|q|new) "$P/bin/task" gate "$actor" -- "$@" || exit 1 ;;
  update|edit)
    for a in "$@"; do case "$a" in --) break ;; -d|--description|--description=*|--body-file|--body-file=*|--stdin) "$P/bin/task" gate "$actor" -- "$@" || exit 1; break ;; esac; done ;;
esac
unset actor cmd sub next
export BEADS_DIR="$P/control/.beads" XDG_CONFIG_HOME="$P/.config" DOLT_ROOT_PATH="$P/.dolt-root" PATH="$P/tools:$PATH"
# Talk to Dolt through its Unix socket when it runs with one (services.json); otherwise the TCP port in metadata.
[ -S "$P/.dolt/mysql.sock" ] && export BEADS_DOLT_SERVER_SOCKET="$P/.dolt/mysql.sock"
# bd never starts a Dolt of its own (sy-a0ac): the process manager runs this board's Dolt. With it down, bd fails fast
# ("auto-start is disabled") instead of starting a server that outlives the call and locks mm's Dolt out of the
# database. Only bin/init, which has no Dolt yet, asks for one (BEADS_DOLT_AUTO_START=1); bd-quiet then sets
# dolt.auto-start: false in .beads/config.yaml, which wins over the env.
export BEADS_DOLT_AUTO_START="${BEADS_DOLT_AUTO_START:-0}"
export GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=beads.role GIT_CONFIG_VALUE_0=maintainer
# Metrics off for every call (sy-8s1, sy-nsnp). bd keeps metrics state per HOME, not under XDG_CONFIG_HOME: while they
# are on, each call writes ~/.beads/eventsData and ~/.beads/machine-id and bootstraps ~/.config/bd/config.yaml (bd
# prefers that path to $XDG_CONFIG_HOME/bd). The env turns them off without a config write; metrics.* in `bd config`
# are user-global keys, so setting them would write ~/.config/bd too.
export BD_DISABLE_METRICS=1 BD_DISABLE_EVENT_FLUSH=1
exec "$P/tools/bd" "$@"
