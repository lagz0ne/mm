#!/usr/bin/env node
// raci — who is Responsible, Accountable (approves), Consulted, Informed for each kind of work (leads/raci.json).
// Participants: the roles in leads/roles.json, plus `human` (the people on the board). Items carry `act:<activity>`.
//   raci                                   show the matrix
//   raci add <activity> "<title>"          add an activity (row)
//   raci rm <activity>                     remove an activity
//   raci set <activity> <who>=<letters>... set cells, e.g. raci set release code=R human=A qa=C design=I  (letters: R A C I; '-' clears)
//   raci render                            write leads/RACI.md (the leads read it through leads/CLAUDE.md)
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { cli } from './lib/obs.mjs'
cli('raci')

const P = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const FILE = path.join(P, 'leads', 'raci.json'), MD = path.join(P, 'leads', 'RACI.md')
const roles = () => JSON.parse(fs.readFileSync(path.join(P, 'leads', 'roles.json'), 'utf8')).roles
const who = () => [...roles().map((r) => r.id), 'human']
const load = () => { try { return JSON.parse(fs.readFileSync(FILE, 'utf8')) } catch { return { activities: [] } } }
const die = (m) => { console.error(`raci: ${m}`); process.exit(2) }

/** Problems with a matrix: exactly one A and at least one R per activity; only known participants and letters. */
export function problems(d, participants) {
  const out = []
  const ids = new Set()
  for (const a of d.activities || []) {
    if (!/^[a-z][a-z0-9-]{0,31}$/.test(a.id || '')) out.push(`bad activity id ${a.id}`)
    if (ids.has(a.id)) out.push(`duplicate activity ${a.id}`); ids.add(a.id)
    const cells = Object.entries(a.raci || {})
    for (const [p, l] of cells) {
      if (!participants.includes(p)) out.push(`${a.id}: unknown participant ${p}`)
      if (!/^[RACI]{1,2}$/.test(l) || new Set(l).size !== l.length) out.push(`${a.id}: bad letters ${p}=${l}`)
    }
    const A = cells.filter(([, l]) => l.includes('A')).length
    if (A !== 1) out.push(`${a.id}: needs exactly one Accountable (has ${A})`)
    if (!cells.some(([, l]) => l.includes('R'))) out.push(`${a.id}: needs at least one Responsible`)
  }
  return out
}

function render(d) {
  const ps = who()
  const title = Object.fromEntries([...roles().map((r) => [r.id, r.title]), ['human', 'Human']])
  const lines = [
    '# RACI: who does, approves, is consulted on, and is told about each kind of work',
    '', '<!-- Generated by `raci render` from leads/raci.json. Do not edit by hand. -->', '',
    'R = Responsible (does it) · A = Accountable (approves; exactly one) · C = Consulted (asked before) · I = Informed (told after).',
    'Label every item with its activity: `bd label add ID act:<activity>`. The board then wakes Consulted roles when it is',
    'created, and Informed roles when it is closed.', '',
    `| Activity | ${ps.map((p) => title[p]).join(' | ')} |`, `| --- | ${ps.map(() => ':-:').join(' | ')} |`,
    ...d.activities.map((a) => `| **${a.title}** \`act:${a.id}\` | ${ps.map((p) => a.raci[p] || '').join(' | ')} |`),
    '', '## What this means for you', '',
    '- **R**: you do the work; set the `act:` label when you create or claim the item.',
    '- **A**: nothing in that activity is done until you approve it.',
    '  - If A is `human`: ask with `needs-you` + `blocked` before closing.',
    '  - If A is another role: comment asking for approval. That role answers "approved" or with changes.',
    '- **C**: give your input on the item when the board asks. Keep it short; say "no input" if you have none.',
    '- **I**: read the closing note when the board tells you. Act only if it affects your work.',
  ]
  fs.writeFileSync(MD, lines.join('\n') + '\n')
}

const [cmd, a, ...rest] = process.argv.slice(2)
if (!cmd || cmd === 'show') {
  const d = load(), ps = who()
  console.log(['activity'.padEnd(16), ...ps.map((p) => p.slice(0, 11).padEnd(12))].join(''))
  for (const x of d.activities) console.log([x.id.padEnd(16), ...ps.map((p) => (x.raci[p] || '·').padEnd(12))].join(''))
  const pr = problems(d, ps); if (pr.length) console.log(`\nproblems:\n- ${pr.join('\n- ')}`)
} else if (cmd === 'add') {
  const d = load(); const title = rest.join(' ').trim()
  if (!/^[a-z][a-z0-9-]{0,31}$/.test(a || '') || !title) die('usage: raci add <activity-id> "<title>"')
  if (d.activities.some((x) => x.id === a)) die(`activity ${a} exists`)
  d.activities.push({ id: a, title, raci: {} }); fs.writeFileSync(FILE, JSON.stringify(d, null, 2) + '\n'); console.log(`added ${a}; now set its cells (raci set ${a} …)`)
} else if (cmd === 'rm') {
  const d = load(); const n = d.activities.length
  d.activities = d.activities.filter((x) => x.id !== a)
  if (d.activities.length === n) die(`no activity ${a}`)
  fs.writeFileSync(FILE, JSON.stringify(d, null, 2) + '\n'); render(d); console.log(`removed ${a}`)
} else if (cmd === 'set') {
  const d = load(); const x = d.activities.find((y) => y.id === a)
  if (!x) die(`no activity ${a}`)
  for (const kv of rest) {
    const [p, l] = kv.split('=')
    if (!who().includes(p)) die(`unknown participant ${p} (roles or human)`)
    if (l === '-') delete x.raci[p]; else x.raci[p] = String(l).toUpperCase()
  }
  const pr = problems(d, who()).filter((m) => m.startsWith(`${a}:`))
  fs.writeFileSync(FILE, JSON.stringify(d, null, 2) + '\n'); render(d)
  console.log(pr.length ? `saved, but: ${pr.join('; ')}` : `saved ${a}`)
} else if (cmd === 'render') { render(load()); console.log('wrote leads/RACI.md') }
else console.log(fs.readFileSync(fileURLToPath(import.meta.url), 'utf8').split('\n').slice(1, 9).map((l) => l.replace(/^\/\/ ?/, '')).join('\n'))
