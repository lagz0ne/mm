#!/usr/bin/env node
// raci — who is Responsible, Verifies, Accountable (approves), Consulted, Informed for each kind of work, and when each
// is involved (leads/raci.json; the letters and rules: bin/lib/raci.mjs). Participants: the roles in leads/roles.json,
// plus `human` (the people on the board). Items carry `act:<activity>`.
//   raci                                   show the matrix, and each row's consult cases
//   raci add <activity> "<title>"          add an activity (row)
//   raci rm <activity>                     remove an activity
//   raci set <activity> <who>=<letters>... set cells, e.g. raci set release code=R qa=V human=A ops=C (letters: R A V C I; '-' clears)
//   raci consult <activity> "<case>"...    set the row's consult cases (when C is asked: "<role>: <when>"); none clears
//   raci render                            write leads/RACI.md (the leads read it through leads/CLAUDE.md)
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { cli } from './lib/obs.mjs'
import { MEANS, problems as rp } from './lib/raci.mjs'
cli('raci')

const P = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const FILE = path.join(P, 'leads', 'raci.json'), MD = path.join(P, 'leads', 'RACI.md')
const roles = () => JSON.parse(fs.readFileSync(path.join(P, 'leads', 'roles.json'), 'utf8')).roles
const who = () => [...roles().map((r) => r.id), 'human']
const load = () => { try { return JSON.parse(fs.readFileSync(FILE, 'utf8')) } catch { return { activities: [] } } }
const die = (m) => { console.error(`raci: ${m}`); process.exit(2) }

/** Problems with a matrix (bin/lib/raci.mjs): exactly one A and at least one R per activity; known participants and
 * letters (R A V C I); a person only A or I; a row with a C lists its consult cases. */
export const problems = rp
/** A cell as the leads read it: RA -> R·A. */
const cell = (l) => [...String(l || '')].join('·')

function render(d) {
  const ps = who()
  const title = Object.fromEntries([...roles().map((r) => [r.id, r.title]), ['human', 'Human']])
  const cases = d.activities.filter((a) => (a.consult || []).length)
  const lines = [
    '# RACI: who does, verifies, approves, is asked and is told, for each kind of work',
    '', '<!-- Generated by `raci render` from leads/raci.json. Do not edit by hand. -->', '',
    ...['R', 'V', 'A', 'C', 'I'].map((l) => `- **${l}** ${MEANS[l]}`), '',
    'R, V and A are the gate; C and I never block. Every item carries its activity: the Task\'s `Act` and the label',
    '`act:<activity>`. The board wakes C only on an ASK to it, V on a HANDOFF of a new head, and I once, when the item closes.', '',
    `| Activity | ${ps.map((p) => title[p]).join(' | ')} |`, `| --- | ${ps.map(() => ':-:').join(' | ')} |`,
    ...d.activities.map((a) => `| **${a.title}** \`act:${a.id}\` | ${ps.map((p) => cell(a.raci[p])).join(' | ')} |`),
    ...(cases.length ? ['', '## When C is asked (and only then)', '', ...cases.map((a) => `- \`${a.id}\`: ${a.consult.join('; ')}`)] : []),
  ]
  fs.writeFileSync(MD, lines.join('\n') + '\n')
}

const [cmd, a, ...rest] = process.argv.slice(2)
if (!cmd || cmd === 'show') {
  const d = load(), ps = who()
  console.log(['activity'.padEnd(20), ...ps.map((p) => p.slice(0, 11).padEnd(12))].join(''))
  for (const x of d.activities) console.log([x.id.padEnd(20), ...ps.map((p) => (cell(x.raci[p]) || '·').padEnd(12))].join(''))
  const cases = d.activities.filter((x) => (x.consult || []).length)
  if (cases.length) console.log(`\nconsult (when C is asked):\n${cases.map((x) => `- ${x.id}: ${x.consult.join('; ')}`).join('\n')}`)
  const pr = problems(d, ps); if (pr.length) console.log(`\nproblems:\n- ${pr.join('\n- ')}`)
} else if (cmd === 'add') {
  const d = load(); const title = rest.join(' ').trim()
  if (!/^[a-z][a-z0-9-]{0,31}$/.test(a || '') || !title) die('usage: raci add <activity-id> "<title>"')
  if (d.activities.some((x) => x.id === a)) die(`activity ${a} exists`)
  d.activities.push({ id: a, title, raci: {} }); fs.writeFileSync(FILE, JSON.stringify(d, null, 2) + '\n'); console.log(`added ${a}; now set its cells (raci set ${a} …)`)
} else if (cmd === 'rm') {
  const d = load(); const n = d.activities.length
  d.activities = d.activities.filter((x) => x.id !== a)
  if (d.activities.length === n) die(`no activity ${a}`)
  fs.writeFileSync(FILE, JSON.stringify(d, null, 2) + '\n'); render(d); console.log(`removed ${a}`)
} else if (cmd === 'set') {
  const d = load(); const x = d.activities.find((y) => y.id === a)
  if (!x) die(`no activity ${a}`)
  for (const kv of rest) {
    const [p, l] = kv.split('=')
    if (!who().includes(p)) die(`unknown participant ${p} (roles or human)`)
    if (l === '-') delete x.raci[p]; else x.raci[p] = String(l).toUpperCase()
  }
  const pr = problems(d, who()).filter((m) => m.startsWith(`${a}:`))
  fs.writeFileSync(FILE, JSON.stringify(d, null, 2) + '\n'); render(d)
  console.log(pr.length ? `saved, but: ${pr.join('; ')}` : `saved ${a}`)
} else if (cmd === 'consult') {
  const d = load(); const x = d.activities.find((y) => y.id === a)
  if (!x) die(`no activity ${a}`)
  const cs = rest.map((c) => c.trim()).filter(Boolean)
  if (cs.length) x.consult = cs; else delete x.consult
  const pr = problems(d, who()).filter((m) => m.startsWith(`${a}:`))
  fs.writeFileSync(FILE, JSON.stringify(d, null, 2) + '\n'); render(d)
  console.log(pr.length ? `saved, but: ${pr.join('; ')}` : `saved ${a} (${cs.length} consult case${cs.length === 1 ? '' : 's'})`)
} else if (cmd === 'render') { render(load()); console.log('wrote leads/RACI.md') }
else console.log(fs.readFileSync(fileURLToPath(import.meta.url), 'utf8').split('\n').slice(1, 10).map((l) => l.replace(/^\/\/ ?/, '')).join('\n'))
