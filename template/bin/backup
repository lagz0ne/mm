#!/bin/sh
# backup — nightly copy of everything this project can't rebuild, outside the project folder:
#   <the machine's backups folder>/<project>/<UTC date>/  ($MM_HOME/backups, or ~/.local/share/backups on older boxes)
#     board.dolt/        full Dolt backup of the Beads database (history included; restore: dolt backup restore)
#     board.jsonl        readable export of all items, comments, labels, dependencies
#     code.bundle        git bundle of the product repo (all branches)
#     config.bundle      git bundle of the project config repo (briefs, skills, permissions, scripts)
#     releases           the release log
#     doop.tar.gz        the project's Doop: canvases and assets (data/doop/), when it has one
#     data/              the app's data (release/data/: what the app slot keeps, e.g. accounts and sessions), when it has one
# Everything is user-only (dirs 0700, files 0600): data/ can hold password and session hashes.
# Keeps the newest 14. Same disk (RAID1): protects against mistakes and corruption, not disk loss; off-site is separate.
[ "${MM_TRACE_SELF:-}" = "$0" ] || MM_TRACE_SELF=$0 exec "$(dirname "$(readlink -f "$0")")/trace" backup -- "$0" "$@"
set -eu
umask 077
P=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
PROJECT=$(sed -n 's/^project:[[:space:]]*\([A-Za-z0-9._-]*\).*/\1/p' "$P/.mm-answers.yaml" 2>/dev/null || true); PROJECT=${PROJECT:-$(basename "$P")}; NAME=$PROJECT
# the machine's backups folder: where mm says (.run/endpoints.json "dirs", else its env), else the older layout
BK=$(sed -n 's/.*"backups": *"\([^"]*\)".*/\1/p' "$P/.run/endpoints.json" 2>/dev/null | head -1); BK=${BK:-${MM_BACKUPS:-$HOME/.local/share/backups}}
ROOT=${BACKUP_DIR:-$BK/$NAME}
D=$ROOT/$(date -u +%Y-%m-%dT%H%MZ)
mkdir -p "$D"; chmod 700 "$ROOT"
# Dolt's TCP port: where the process manager runs it (.run/services.json), else bd's own config
PORT=$(sed -n 's/.*"dolt_port": *\([0-9]*\).*/\1/p' "$P/.run/services.json" 2>/dev/null | head -1)
[ -n "$PORT" ] || PORT=$(sed -n 's/^ *port: *\([0-9]*\).*/\1/p' "$P/control/.beads/dolt-server-config.yaml" | head -1)
DB=$(sed -n 's/.*"dolt_database": *"\([^"]*\)".*/\1/p' "$P/control/.beads/metadata.json")
export DOLT_ROOT_PATH="$P/.dolt-root" XDG_CONFIG_HOME="$P/.config" DOLT_CLI_PASSWORD=""
"$P/tools/dolt" --host 127.0.0.1 --port "$PORT" --no-tls -u root --use-db "$DB" sql -q "CALL dolt_backup('sync-url', 'file://$D/board.dolt')" >/dev/null
(cd "$P/control" && "$P/bin/bd" export --all -o "$D/board.jsonl" >/dev/null 2>&1 || "$P/bin/bd" export --all > "$D/board.jsonl")
[ ! -d "$P/code/.git" ] || git -C "$P/code" bundle create -q "$D/code.bundle" --all   # boards without a product repo (system) have no code/
git -C "$P" bundle create -q "$D/config.bundle" --all
[ -f "$P/.releases" ] && cp "$P/.releases" "$D/releases"
# the app's data, copied file by file while it runs: it replaces each file by atomic rename, so every copy is whole.
# Skips its *.tmp write files and files that vanish mid-copy; umask 077 makes the copies 0600 whatever the source modes.
if [ -d "$P/release/data" ]; then
  (cd "$P/release/data" && find . -type f ! -name '*.tmp' -exec sh -c '
    for f; do mkdir -p "$0/${f%/*}"; cp --preserve=timestamps "$f" "$0/$f" 2>/dev/null || [ ! -e "$f" ]; done' "$D/data" {} +)
fi
# the project's Doop (plans/doop.md): its canvases and assets. Its secrets stay out (they are re-made at the next start).
# (bin/doop-run backup: Doop runs as its own uid, and its database files are 0600, so while it runs its own tar reads them)
[ ! -d "$P/data/doop" ] || "$P/bin/doop-run" backup "$D/doop.tar.gz"
ls -1d "$ROOT"/20*/ 2>/dev/null | head -n -14 | xargs -r rm -rf
echo "backup $D: $(du -sh "$D" | cut -f1), $(wc -l < "$D/board.jsonl") items, $(find "$D/data" -type f 2>/dev/null | wc -l) data files"
