#!/bin/sh
# bd-quiet — bd stays quiet on this board (the owner, sy-8s1): no git hooks, no git operations of its own, and no Dolt
# server of its own (dolt.auto-start false, sy-a0ac: the process manager runs the board's Dolt). Metrics are off
# through bin/bd's env (BD_DISABLE_METRICS), not here: metrics.disabled is a user-global key that bd writes in
# ~/.config/bd/config.yaml, outside the project (sy-nsnp).
# Idempotent: bin/init runs it once, `mm update` after every update. Sets only what isn't set yet, and says so.
# It needs the board's Dolt up (bd reads and writes its config through it); with it down it fails and starts none.
[ "${MM_TRACE_SELF:-}" = "$0" ] || MM_TRACE_SELF=$0 exec "$(dirname "$(readlink -f "$0")")/trace" bd-quiet -- "$0" "$@"
set -eu
P=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
cd "$P/control"
# mm update may have just restarted the board's Dolt (a new command): wait up to 60 s for it to answer, so bd finds the
# process manager's Dolt (bd never starts one of its own, sy-a0ac). bin/init runs this with bd's own start on: no wait.
if [ "${BEADS_DOLT_AUTO_START:-0}" != 1 ]; then
  end=$(( $(date +%s) + 60 ))
  until "$P/bin/bd" config get no-hooks >/dev/null 2>&1; do
    [ "$(date +%s)" -lt "$end" ] || { echo "bd-quiet: bd reached no Dolt in 60 s (the board's Dolt is down; it starts none of its own)" >&2; exit 1; }; sleep 1
  done
fi
for kv in no-hooks=true no-git-ops=true dolt.auto-start=false; do
  k=${kv%%=*}; v=${kv#*=}
  [ "$("$P/bin/bd" config get "$k" 2>/dev/null | tail -1)" = "$v" ] && continue
  "$P/bin/bd" config set "$k" "$v" >/dev/null
  echo "bd-quiet: $k = $v"
done
