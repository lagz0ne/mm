#!/usr/bin/env node
// owner-card — check the owner card of an item (sy-z5lz; the format: bin/lib/owner-card.mjs, the leads' brief "Asking
// the owner: the owner card"). Every item that needs the owner (label needs-you) starts its description with one.
//   owner-card check <id>          the item's card, read with this project's bin/bd show --json: exit 0 ok, 1 invalid
//                                  or missing (the reasons on stderr)
//   owner-card check - [--t2]      a description on stdin (--t2: as with the label t2: If yes, If no, Risk required)
//   owner-card gate -- <bd args>   bin/bd runs it when its arguments name needs-you: refuses (exit 1, the reasons) a
//                                  call that adds needs-you (label add, update --add-label/-l/--set-labels, create/q
//                                  -l/--labels) to an item whose description (the one in the call, else the item's own)
//                                  has no valid card. With t2 (on the item or in the call) a go ask (You: Tap
//                                  Approve) also needs signed-off (sy-l9uc: plan -> review's sign-off -> needs-you); a
//                                  non-go ask (Reply:/Check:/Nothing, sy-t9tg) does not; adding t2 to an item that has
//                                  needs-you is checked the same way. When the card names a Head (sy-hzmu), review's
//                                  sign-off must name that head too (label signed-head:<repo>@<sha>; headRefusal).
//                                  A t2 go ask's Task also has a Rollback and a Safeguard line (sy-w5az; task.mjs
//                                  goTaskRefusal); a non-go ask needs neither. A card whose You is "Nothing" asks
//                                  the owner nothing: needs-you on it is refused (sy-e234).
//                                  Removing needs-you, or any other call: exit 0.
//   owner-card signoff -- <bd args> bin/bd runs it when its actor is not review and its arguments name signed-off or
//                                  signed-head: (or set labels): refuses (exit 1) a call that adds or removes one
//                                  (sy-9bss: only review signs off). For review it runs when an argument names
//                                  signed-head:: a signed-head:<repo>@<sha> it adds, for a repo of gates.json (default
//                                  mm), needs artifacts/<item>/gates-<sha7>.txt showing all passed (sy-n4f5;
//                                  bin/lib/gates-file.mjs). Any other call: exit 0.
// The card's words follow the writing rules (sy-ko6r; bin/lib/writing.mjs, glossary.yaml, glossary.local.yaml,
// bin/lib/words.txt): check always reads them; gate only for a lead's call (its actor, --actor or BEADS_ACTOR, is a role
// of leads/roles.json), never a person's. Before the glossary's refuse_from (or with none) a problem is a warning on
// stderr; from that day on it refuses.
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { readGlossary } from './lib/glossary.mjs'
import { signedHeadRefusal } from './lib/gates-file.mjs'
import { FORMAT, SIGNED_HEAD, headRefusal, isGoAsk, parseCard, youKind } from './lib/owner-card.mjs'
import { goTaskRefusal } from './lib/task.mjs'
import { sayWriting } from './lib/writing.mjs'

const P = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const LABEL = 'needs-you', T2 = 't2', SIGNED = 'signed-off'
const die = (m, code = 2) => { console.error(`owner-card: ${m}`); process.exit(code) }

/** The item as bd shows it: { description, labels }. Throws with a short reason. */
function show(id) {
  let out
  try { out = execFileSync(path.join(P, 'bin', 'bd'), ['show', id, '--json'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 30000, maxBuffer: 16 << 20 }) }
  catch (e) { throw new Error(`cannot read ${id} (bd show: ${String(e.stderr || e.message).trim().split('\n').pop().slice(0, 200)})`) }
  let j; try { j = JSON.parse(out) } catch { throw new Error(`cannot read ${id} (bd show gave no JSON)`) }
  const i = Array.isArray(j) ? j[0] : j
  if (!i || typeof i !== 'object') throw new Error(`no item ${id}`)
  return { description: typeof i.description === 'string' ? i.description : '', labels: Array.isArray(i.labels) ? i.labels : [] }
}
/** The writing check's setting: the board's glossary (both files), the word list and the role ids. */
function writing() {
  const g = readGlossary((f) => { try { return fs.readFileSync(path.join(P, f), 'utf8') } catch { return null } })
  let roles = []
  try { roles = (JSON.parse(fs.readFileSync(path.join(P, 'leads', 'roles.json'), 'utf8')).roles || []).map((r) => r?.id).filter((x) => typeof x === 'string') } catch {}
  return { terms: g.terms, words: g.words, refuseFrom: g.refuseFrom, roles }
}
function warn(r, w, who) {
  if (!r.writing?.length) return
  console.error(`owner-card: writing (ASD-STE100) of ${who}'s card: ${r.writing.length} warning(s)${w.refuseFrom ? ` (from ${w.refuseFrom} the hard ones are refused)` : ''}:\n${sayWriting(r.writing)}\nOnly approved words (bin/lib/words.txt) and glossary terms (glossary.yaml); to add a term, see the leads' brief, "Glossary".`)
}
const say = (r) => r.errors.map((e) => `  - ${e}`).join('\n')

// bd's flags that take a value (everything else is a switch); a value is never a command, an id or a label
const VALUED = new Set(['--actor', '--db', '-d', '--description', '--body-file', '-l', '--labels', '--add-label', '--remove-label', '--set-labels',
  '-p', '--priority', '-t', '--type', '-a', '--assignee', '-s', '--status', '--title', '--parent', '--notes', '--design', '--acceptance',
  '-e', '--estimate', '--due', '--defer', '--external-ref', '--id', '--deps', '-f', '--file', '--reason', '--if-status', '--if-assignee',
  '--owner', '--spec-id', '--metadata', '--append-notes', '--repo', '--rig', '--prefix', '--waits-for', '--waits-for-gate', '--sandbox-dir'])
const GATE_HELP = `The format: ${FORMAT}. Write the card first (bd update <id> --body-file <file>), then add ${LABEL}.`

/** bd's arguments: the command, its positional words, and readers of the flags' values. */
function parse(argv) {
  const pos = [], flags = []
  for (let k = 0; k < argv.length; k++) {
    const a = argv[k]
    if (a === '--') break // text from here on
    if (a.startsWith('-') && a.length > 1) {
      const eq = a.indexOf('=')
      if (a.startsWith('--') && eq > 0) flags.push([a.slice(0, eq), a.slice(eq + 1)])
      else if (VALUED.has(a)) flags.push([a, argv[++k] ?? ''])
      else flags.push([a, true])
      continue
    }
    pos.push(a)
  }
  const [cmd, ...args] = pos
  const values = (...names) => flags.filter(([f, v]) => names.includes(f) && typeof v === 'string').map(([, v]) => v)
  const list = (...names) => values(...names).flatMap((v) => v.split(',')).map((s) => s.trim()).filter(Boolean)
  return { cmd, args, values, list }
}

// Only review signs off (sy-9bss): signed-off and signed-head:<repo>@<sha> are review's. bin/bd runs this only when an
// argument names one of them and its actor's role (the part before /) is not review: a call that adds or removes one
// (label add|remove, update/edit --add-label/-l/--remove-label/--set-labels, create/q/new -l/--labels) is refused.
// --set-labels that keeps the item's sign-off labels as they are is no change: only then is the item read (bd show).
const isSignoff = (l) => l === SIGNED || l.startsWith(SIGNED_HEAD)
const SIGNOFF_REFUSED = `bd: refused: only review signs off (${SIGNED}, ${SIGNED_HEAD}): ask review on the item`
function signoff(argv) {
  const { cmd, args, values, list } = parse(argv)
  const actor = String(values('--actor').pop() ?? process.env.BEADS_ACTOR ?? process.env.BD_ACTOR ?? '')
  if (actor.split('/')[0] === 'review') { gates(cmd, args, values, list); process.exit(0) }
  const no = (why) => { console.error(`${SIGNOFF_REFUSED}${why ? ` (${why})` : ''}`); process.exit(1) }
  if (cmd === 'create' || cmd === 'q' || cmd === 'new') { if (list('-l', '--labels').some(isSignoff)) no(); process.exit(0) }
  if (cmd === 'label' && (args[0] === 'add' || args[0] === 'remove')) { if (args.slice(1).some(isSignoff)) no(); process.exit(0) }
  if (cmd !== 'update' && cmd !== 'edit') process.exit(0)
  if (list('--add-label', '-l', '--remove-label').some(isSignoff)) no()
  if (!values('--set-labels').length) process.exit(0)
  // --set-labels replaces every label: one that names no sign-off still drops the item's, so it is compared too
  const want = [...new Set(list('--set-labels').filter(isSignoff))].sort().join(',')
  if (!args.length) no('--set-labels on no item I can name')
  for (const id of args) {
    let it; try { it = show(id) } catch (e) { no(e.message) }
    if ([...new Set(it.labels.filter(isSignoff))].sort().join(',') !== want) no(`--set-labels changes ${id}'s sign-off`)
  }
  process.exit(0)
}

// Review signs off a head only with the gates result for that exact head (sy-n4f5): each signed-head:<repo>@<sha> the
// call adds is checked by signedHeadRefusal (the repos of gates.json, default mm; others pass). The item is read (bd
// show) only for --set-labels (what it adds) and for a result that skipped the live group (is the item t2?).
const GATES_REFUSED = 'bd: refused: review signs off a head only with the gates result for that exact head'
function gates(cmd, args, values, list) {
  const no = (why) => { console.error(`${GATES_REFUSED}: ${why}`); process.exit(1) }
  const heads = (ls) => ls.filter((l) => l.startsWith(SIGNED_HEAD))
  // [id, the signed-heads it adds, those only --set-labels names (checked when the item has none of them yet), t2 in the call, a new item]
  let items = []
  if (cmd === 'create' || cmd === 'q' || cmd === 'new') {
    const ls = list('-l', '--labels'), add = heads(ls)
    if (!add.length) return
    const id = values('--id').pop()
    if (!id) no(`${add.join(', ')} on a new item: its gates file has no item yet. Create the item, run test/gates --item <id>, then add the label`)
    items = [[id, add, [], ls.includes(T2), true]]
  } else if (cmd === 'label' && args[0] === 'add') {
    const rest = args.slice(1), add = heads(rest)
    items = rest.filter((x) => !x.startsWith(SIGNED_HEAD)).map((id) => [id, add, [], false, false])
  } else if (cmd === 'update' || cmd === 'edit') {
    const ls = list('--add-label', '-l'), set = list('--set-labels'), add = heads(ls)
    items = args.map((id) => [id, add, heads(set).filter((l) => !add.includes(l)), ls.includes(T2) || set.includes(T2), false])
  } else return
  for (const [id, add, setOnly, t2call, isNew] of items) {
    if (!add.length && !setOnly.length) continue
    let it = null
    const item = () => { if (!it) { try { it = isNew ? { labels: [] } : show(id) } catch (e) { no(e.message) } } return it }
    for (const l of [...add, ...setOnly.filter((x) => !item().labels.includes(x))]) {
      let why = signedHeadRefusal(P, id, l, { t2: false })
      // passed with the live group skipped: enough unless the item is t2 (it is read only then)
      if (!why) { const t2why = signedHeadRefusal(P, id, l, { t2: true }); if (t2why && (t2call || item().labels.includes(T2))) why = t2why }
      if (why) no(why)
    }
  }
}

function gate(argv) {
  const { cmd, args, values, list } = parse(argv)
  // a lead's card is checked for its words too; a person's is not (the actor: --actor, else BEADS_ACTOR / BD_ACTOR)
  const actor = String(values('--actor').pop() ?? process.env.BEADS_ACTOR ?? process.env.BD_ACTOR ?? '')
  const W = writing(), lead = W.roles.includes(actor.split('/')[0])
  // the description this call sets, if any (null: it sets none)
  const newDesc = () => {
    const f = values('--body-file').pop(), d = values('-d', '--description').pop()
    if (f !== undefined) {
      if (f === '-') refuse([`(the call)`], `${LABEL} with --body-file - cannot be checked before bd reads it: write the description to a file`)
      try { return fs.readFileSync(f, 'utf8') } catch { refuse([`(the call)`], `cannot read --body-file ${f}`) }
    }
    return d ?? null
  }
  let ids = [], adding = [], creating = false, set = null
  if ((cmd === 'create' || cmd === 'q' || cmd === 'new')) { adding = list('-l', '--labels'); creating = true }
  else if (cmd === 'update' || cmd === 'edit') {
    adding = list('--add-label', '-l', '--set-labels'); ids = args
    if (values('--set-labels').length) set = list('--set-labels')
  } else if (cmd === 'label' && args[0] === 'add') {
    const rest = args.slice(1)
    if (!rest.includes(LABEL) && !rest.includes(T2)) process.exit(0)
    adding = rest // bd takes the last as the label and the others as ids; any position of needs-you or t2 is checked, safely
    ids = rest.filter((x) => x !== LABEL && x !== T2)
  }
  const addsNY = adding.includes(LABEL), addsT2 = adding.includes(T2)
  if (!addsNY && !addsT2) process.exit(0)
  const desc = newDesc()
  /** Refuse unless `labels` (the item's labels after this call) are fine: needs-you needs a valid card, and with t2
   *  review's sign-off first (sy-l9uc, review's sy-16ml: plan -> review's sign-off -> needs-you). */
  const check = (who, description, labels, id) => {
    if (!labels.includes(LABEL)) return
    const r = parseCard(description, labels, id, { writing: lead ? W : undefined })
    if (!r.ok) refuse([who], null, r)
    warn(r, W, who)
    // sy-e234: a card whose You is "Nothing" asks the owner nothing, so the item does not wait on them
    if (youKind(r.card.You) === 'nothing') refuse([who], `its owner card's You is "Nothing": it asks the owner nothing, so it does not wait on them. Write what the owner does (You: Tap Approve | Reply: <question> | Check: <what, where>), or leave ${LABEL} off.`)
    // sy-t9tg: a t2 card that asks something other than the go (You: Reply:/Check:/Nothing) may wait on the owner
    // before review's sign-off and before any head exists; it never gets the go (headRefusal refuses it there)
    if (labels.includes(T2) && !isGoAsk(r.card)) return
    if (labels.includes(T2) && !labels.includes(SIGNED)) refuse([who], `a t2 item waits on the owner only after review signed it off (label ${SIGNED}): plan -> review's sign-off -> ${LABEL}. Ask review first; add ${LABEL} after.`)
    // sy-w5az: a t2 go ask's Task has a Rollback and a Safeguard (headRefusal's last check: here with its own fix)
    const t = labels.includes(T2) ? goTaskRefusal(description) : null
    const h = headRefusal(description, labels)
    if (t && h === t) refuse([who], `${t}. Write both lines in the item's Task (bd update <id> --body-file <file>); add ${LABEL} after.`)
    if (h) refuse([who], `${h}: review signs off the head the card names (label signed-head:<repo>@<sha>, next to ${SIGNED}). Ask review to sign off this head; add ${LABEL} after.`)
  }
  if (creating) { check('the new item', desc ?? '', adding); process.exit(0) }
  if (!ids.length) refuse(['(the call)'], `${addsNY ? LABEL : T2} is added to no item I can name`)
  for (const id of ids) {
    let it; try { it = show(id) } catch (e) { refuse([id], e.message) }
    check(id, desc ?? it.description, set ?? [...new Set([...it.labels, ...adding])], id)
  }
  process.exit(0)
}

function refuse(ids, why, r) {
  const what = r ? `${r.found ? 'its owner card is invalid' : 'it has no owner card'}:\n${say(r)}` : why
  console.error(`bd: refused: ${LABEL} only with a valid owner card; ${ids.join(', ')}: ${what}\n${GATE_HELP}`)
  process.exit(1)
}

const [cmd, ...rest] = process.argv.slice(2)
if (cmd === 'check') {
  const t2 = rest.includes('--t2'), args = rest.filter((a) => a !== '--t2')
  if (args.length !== 1) die('usage: owner-card check <id> | owner-card check - [--t2]')
  let r
  const W = writing()
  if (args[0] === '-') r = parseCard(fs.readFileSync(0, 'utf8'), t2 ? ['t2'] : [], '', { writing: W })
  else {
    let it; try { it = show(args[0]) } catch (e) { die(e.message) }
    r = parseCard(it.description, t2 ? [...it.labels, 't2'] : it.labels, args[0], { writing: W })
  }
  if (r.ok) { console.log(`owner card ok${args[0] === '-' ? '' : ` (${args[0]})`}`); warn(r, W, args[0] === '-' ? 'the' : args[0]); process.exit(0) }
  console.error(`owner-card: ${args[0] === '-' ? 'the description' : args[0]} has ${r.found ? 'an invalid' : 'no'} owner card:\n${say(r)}\nThe format: ${FORMAT}.`)
  process.exit(1)
} else if (cmd === 'gate') {
  gate(rest[0] === '--' ? rest.slice(1) : rest)
} else if (cmd === 'signoff') {
  signoff(rest[0] === '--' ? rest.slice(1) : rest)
} else die('usage: owner-card check <id> | owner-card check - [--t2] | owner-card gate -- <bd args> | owner-card signoff -- <bd args>')
