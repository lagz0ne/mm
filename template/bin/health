#!/usr/bin/env node
// health — the project's watchdog (run every minute by the machine's scheduler). Checks every service and endpoint; restarts
// what is down; after 3 failed checks in a row opens a P0 incident on the board (label incident, for the board's Lead; sy-48bt) and closes
// it when the check passes again. State: .health.json (in a box: .run/health.json). Prints one line per problem (its log: the scheduler's).
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const P = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const NAME = path.basename(P) // folder (for paths); the project id comes from projectName()
const STATE = process.env.HEALTH_STATE || path.join(P, '.health.json')
// a box keeps its state under .run (mm cron sets HEALTH_STATE: the box can't write the top level). A project that moved
// in or out of a box keeps its open incidents (sy-6n9w): a run starts from the newer of the two files (a regular file,
// never a link), so the incidents the other side opened are checked and closed here
const STATES = [...new Set([STATE, path.join(P, '.health.json'), path.join(P, '.run', 'health.json')])]
// the board's ids (a prefix, a dash, a hash, then .N children): '..', a slash or a path never reaches a URL
const ISSUE = /^[a-z][a-z0-9]*-[a-z0-9]+(\.\d+)*$/
function loadState() {
  const files = STATES.map((f) => { try { const st = fs.lstatSync(f); return st.isFile() ? { f, t: st.mtimeMs } : null } catch { return null } })
    .filter(Boolean).sort((a, b) => b.t - a.t)
  for (const { f } of files) {
    let v; try { v = JSON.parse(fs.readFileSync(f, 'utf8')) } catch { continue }
    if (!v || typeof v !== 'object' || Array.isArray(v)) continue
    // only what this script writes: a count and an item id (the other file may be the box's)
    for (const [k, s] of Object.entries(v)) {
      if (!s || typeof s !== 'object') { delete v[k]; continue }
      if (s.incident != null && !(typeof s.incident === 'string' && ISSUE.test(s.incident))) s.incident = null
      if (s.item != null && !(typeof s.item === 'string' && ISSUE.test(s.item))) s.item = null
      if (s.fails !== undefined && !Number.isInteger(s.fails)) s.fails = 0
      if (s.list != null && !Array.isArray(s.list)) s.list = []
    }
    return v
  }
  return {}
}
const FORCE = process.env.HEALTH_FORCE_FAIL || '' // test only: treat this check as failing, without restarting anything
import { endpoints, restartService, servicesDef, svcUrl } from './lib/svc.mjs'
import { cli } from './lib/obs.mjs'
import { formatTask } from './lib/task.mjs'
cli('health')
// the item's Act (sy-n3r5): the first of `prefer` that this board's RACI has (a project board has no incident row),
// else its first activity
function actHere(...prefer) {
  let ids = []
  try { ids = (JSON.parse(fs.readFileSync(path.join(P, 'leads', 'raci.json'), 'utf8')).activities || []).map((a) => a.id) } catch {}
  return prefer.find((a) => ids.includes(a)) || ids[0] || prefer[0]
}
// who gets an incident (sy-48bt): the board's Lead (roles.json `lead`), else ops when the board has it, else its first
// role. Never needs-you: the owner is asked only with an owner card, and the incident row is the leads' (ops R·A).
function incidentOwner() {
  let j = {}
  try { j = JSON.parse(fs.readFileSync(path.join(P, 'leads', 'roles.json'), 'utf8')) } catch {}
  const ids = (j.roles || []).map((r) => r?.id).filter(Boolean)
  return (ids.includes(j.lead) && j.lead) || (ids.includes('ops') && 'ops') || ids[0] || undefined
}
// Checks come from services.json (each service's `ready` probe) and where the manager put them (.run/endpoints.json).
const SVC = servicesDef()
async function ok(url) { try { const r = await fetch(url, { signal: AbortSignal.timeout(5000) }); return r.status < 500 } catch { return false } }
const SOCK = path.join(P, '.dolt', 'mysql.sock')
const checks = [
  ...Object.entries(SVC).filter(([n, d]) => !(d.optional && !svcUrl(n) && d.port === 'http')).map(([name, d]) => {
    const r = d.ready || {}
    const run = r.http ? async () => { const u = svcUrl(name); return !!u && ok(u + r.http) }
      : r.socket ? async () => fs.existsSync(SOCK) || !!endpoints().services?.[name]?.port // legacy TCP dolt has no socket
      : async () => true // process liveness is the manager's job
    return { id: name, title: `${name} is not answering`, service: name, run }
  }),
  { id: 'paseo', title: 'Paseo daemon (agents) does not answer', run: async () => { try { execFileSync(process.env.PASEO_BIN || 'paseo', ['ls', '-q'], { timeout: 15000, stdio: 'ignore' }); return true } catch { return false } } },
]
const BD = svcUrl('bd-serve')

const state = loadState()
async function bd(method, p, body) {
  const r = await fetch(`${BD}${p}`, { method, headers: body ? { 'content-type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined, signal: AbortSignal.timeout(8000) })
  return r.json().catch(() => ({}))
}
// An id from the state is data (the box writes .run/health.json, sy-6n9w): before the watchdog comments on or closes it,
// it reads the item and acts only on its own: open, owner watchdog, the label and the title health gives it. Returns
// null when it is, else why not (the caller drops the id). A board it can't reach throws: the id stays for the next run.
const MEM_TITLE = 'Stale memories: '
async function notOurs(id, label, title) {
  if (typeof id !== 'string' || !ISSUE.test(id)) return 'not an item id'
  const r = await fetch(`${BD}/v0/beads/issues/${encodeURIComponent(id)}`, { signal: AbortSignal.timeout(8000) })
  if (r.status >= 500) throw new Error(`board answered ${r.status}`)
  const i = await r.json().catch(() => null)
  if (!r.ok || !i || typeof i !== 'object' || i.id !== id) return 'no such item'
  if (i.status === 'closed') return 'closed already'
  if (i.owner !== 'watchdog') return `owner is ${i.owner || 'nobody'}, not watchdog`
  if (!Array.isArray(i.labels) || !i.labels.includes(label)) return `no ${label} label`
  if (typeof i.title !== 'string' || !title(i.title)) return 'not the title health gives it'
  return null
}

for (const c of checks) {
  const s = state[c.id] ||= { fails: 0, incident: null }
  const good = c.id === FORCE ? false : await c.run()
  // a forged or stale id would be closed (when good) or keep a real incident from opening (when failing)
  if (s.incident) {
    const why = await notOurs(s.incident, 'incident', (t) => t === `Incident: ${c.title}`).catch((e) => { console.log(`${c.id}: could not read ${s.incident} (${e.message}); kept`); return undefined })
    if (why === undefined && good) continue
    if (why) { console.log(`${c.id}: dropped ${String(s.incident).slice(0, 64)} from the state: ${why}`); s.incident = null }
  }
  if (good) {
    if (s.incident) {
      await bd('POST', `/v0/beads/issues/${s.incident}/comments`, { author: 'watchdog', text: `Recovered at ${new Date().toISOString()} after ${s.fails} failed check(s).` }).catch(() => {})
      await bd('POST', `/v0/beads/issues/${s.incident}:close`, { actor: 'watchdog', reason: 'recovered (watchdog)' }).catch(() => {})
      console.log(`${c.id}: recovered; closed ${s.incident}`)
    }
    state[c.id] = { fails: 0, incident: null }
    continue
  }
  s.fails += 1
  console.log(`${c.id}: FAILED (${s.fails} in a row): ${c.title}`)
  // a self-healing manager (mm: restart policy + liveness probes) restarts it already; a second restart races it. But it
  // never starts again what it gave up on (left Skipped or stopped behind a dependency, sy-5ku): after 3 failed checks
  // (3 minutes) one restart, which is no race any more
  const selfHealing = !!endpoints().self_healing
  if (c.service && c.id !== FORCE && (selfHealing ? s.fails === 3 : s.fails <= 3)) { try { restartService(c.service); console.log(`${c.id}: restarted`) } catch (e) { console.log(`${c.id}: restart failed: ${e.message}`) } }
  if (s.fails >= 3 && !s.incident) {
    const r = await bd('POST', '/v0/beads/issues', { title: `Incident: ${c.title}`, issue_type: 'bug', priority: 0, labels: ['incident', `act:${actHere('incident', 'release')}`], assignee: incidentOwner(), actor: 'watchdog', owner: 'watchdog',
      description: `${formatTask({ task: 'Find why the check fails, and make it pass again.', act: actHere('incident', 'release'),
        done: 'the check passes again, and this item closes itself', verify: [`bin/health`, `no "${c.id}: FAILED" line`] })}\n\n` +
        `The watchdog found **${c.title}** on ${s.fails} checks in a row (one per minute) and could not fix it by restarting${c.service ? ` \`${c.service}\`` : ''}.\n\nCheck the process manager's log for ${c.service || 'it'}. This item closes itself when the check passes again.` }).catch(() => ({}))
    if (typeof r.id === 'string' && ISSUE.test(r.id)) { s.incident = r.id; console.log(`${c.id}: opened incident ${r.id}`) }
  }
}
// Memories past verified + ttl_days (memory/README.md): one item for setup with the list, updated when it changes,
// closed by the watchdog once none is left. Not an incident: a fact to check again, fix or delete.
const MEM = path.join(P, 'memory')
const stale = (fs.existsSync(MEM) ? fs.readdirSync(MEM) : []).filter((f) => f.endsWith('.md') && !['MEMORY.md', 'README.md'].includes(f)).filter((f) => {
  const h = /^---\n([\s\S]*?)\n---/.exec(fs.readFileSync(path.join(MEM, f), 'utf8'))?.[1] || ''
  const v = /^\s*verified:\s*(\d{4}-\d\d-\d\d)\s*$/m.exec(h)?.[1], t = /^\s*ttl_days:\s*(\d+)\s*$/m.exec(h)?.[1]
  return !!v && !!t && Date.parse(v) + Number(t) * 864e5 < Date.now()
}).sort()
const mem = state.memory ||= { item: null, list: [] }
const listed = stale.map((f) => `- \`memory/${f}\``).join('\n')
try {
  if (mem.item) {
    const why = await notOurs(mem.item, 'memory', (t) => t.startsWith(MEM_TITLE))
    if (why) { console.log(`memory: dropped ${String(mem.item).slice(0, 64)} from the state: ${why}`); mem.item = null; mem.list = [] }
  }
  if (stale.length && !mem.item) {
    const r = await bd('POST', '/v0/beads/issues', { title: `${MEM_TITLE}${stale.length} past their ttl_days`, issue_type: 'task', priority: 3, labels: ['memory'], assignee: 'setup', actor: 'watchdog', owner: 'watchdog',
      description: `${formatTask({ task: 'Check each stale memory again: set a new verified, fix it, or delete it.', act: actHere('project-governance', 'incident', 'release'),
        done: 'no memory is past verified plus ttl_days, and this item closes itself', verify: ['bin/config-check', 'config-check: ok'] })}\n\n` +
        `These project memories are older than their \`verified\` date plus \`ttl_days\`:\n\n${listed}\n\nFor each: check the fact again and set a new \`verified\`, fix it, or delete the file (and its line in \`memory/MEMORY.md\`). This item closes itself when none is left.` })
    if (typeof r.id === 'string' && ISSUE.test(r.id)) { mem.item = r.id; mem.list = stale; console.log(`memory: ${stale.length} stale; opened ${r.id}`) }
  } else if (stale.length && mem.list.join() !== stale.join()) {
    await bd('POST', `/v0/beads/issues/${mem.item}/comments`, { author: 'watchdog', text: `Now ${stale.length} stale:\n\n${listed}` }); mem.list = stale
  } else if (!stale.length && mem.item) {
    await bd('POST', `/v0/beads/issues/${mem.item}:close`, { actor: 'watchdog', reason: 'no stale memory left (watchdog)' })
    console.log(`memory: none stale; closed ${mem.item}`); state.memory = { item: null, list: [] }
  }
} catch (e) { console.log(`memory: could not reach the board (${e.message})`) }
fs.writeFileSync(STATE, JSON.stringify(state, null, 1))
