#!/bin/sh
# deploy — put a landed commit into production (the app slot) safely; roll back by itself if it doesn't come up.
#   deploy [rev]        deploy rev (default: main) into release/, restart the app, health-check; on failure roll back
#   deploy rollback     go back to the previous release
#   deploy status       what runs now, and the recent releases
# The app runs from release/ (a detached worktree of code/), so main can move without touching production. An empty
# release/ (no .git) is made a worktree; a non-empty one that is not a worktree is refused (git -C would reach the
# project root's repo). After each land, bin/land runs `deploy main` by itself (deploy.on_land; see bin/land).
# The app slot is the `app` service in services.json; where it runs and how to restart it come from the process
# manager (.run/endpoints.json, via bin/svc).
# A release with bun.lock (or bun.lockb) is built with Bun: `bun install --frozen-lockfile` (dev deps too: the build
# needs them), then `bun run build` when package.json has a build script. It is built first in .deploy-build/ (a
# worktree of its own), so a failing install or build never touches release/: production stays as it was, and deploy
# says why. Then release/ moves and is installed and built the same way. Other releases: `npm ci --omit=dev` when
# package.json has dependencies, as before.
# How the app starts and its health path are the release's own settings (package.json "mm": {"app": {...}}; see
# bin/app-run); DEPLOY_HEALTH_PATH still wins. The app's data outside release/ (DATA_DIR: data/app) is made when missing.
# The first deploy: mm registers the app slot only once release/ exists, so a project whose services.yaml declares
# `app` but whose services.json has none yet is deployed too: release/ is made, installed and built (no restart, no
# health check; .releases says `staged`), and deploy says the slot starts at the next `mm up` (it never runs mm).
# In a box with the project API on (its socket: MM_PROJECT_API, default /run/mm/api/api.sock; docs/project-api.md),
# the app slot runs only the build the owner approved, release/<build>/. There deploy makes release/<build>/ (<build>:
# the short commit hash; a detached worktree of code/ at it, in the real folder release/), installs and builds it
# there, then asks the host: POST /release {"build":"<build>"}. Nothing restarts; the owner's approval starts it.
[ "${MM_TRACE_SELF:-}" = "$0" ] || MM_TRACE_SELF=$0 exec "$(dirname "$(readlink -f "$0")")/trace" deploy -- "$0" "$@"
set -eu
P=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# declared: services.yaml has an `app` service (a key of services:, at its first indent)
declared() { awk '/^services:[ \t]*$/{s=1; next} s && /^[^ \t#]/{s=0} s && /^[ \t]+[^ \t#]/{ match($0, /^[ \t]+/); if (!i) i=RLENGTH; if (RLENGTH==i && $0 ~ /^[ \t]+app:/) {f=1; exit} } END{exit !f}' "$P/services.yaml" 2>/dev/null; }
pname() { [ -z "${MM_PROJECT:-}" ] || { echo "$MM_PROJECT"; return; }
  n=$(sed -n "s/^project:[ \t]*[\"']*\([A-Za-z0-9_.-]*\).*/\1/p" "$P/.mm-answers.yaml" 2>/dev/null | head -1); echo "${n:-$(basename "$P")}"; }
API=${MM_PROJECT_API:-/run/mm/api/api.sock}; [ -S "$API" ] || API=
STARTED=1
if [ -n "$API" ]; then
  { grep -q '"app"' "$P/.run/services.json" 2>/dev/null || declared; } || { echo "deploy: this project has no app slot (services.yaml: app)" >&2; exit 2; }
  STARTED=0
elif ! { grep -q '"app"' "$P/.run/services.json" 2>/dev/null || grep -q '"app"' "$P/services.json" 2>/dev/null; }; then
  declared || { echo "deploy: this project has no app slot (services.json: app)" >&2; exit 2; }
  STARTED=0; NEXT="the app slot starts at the next mm up of $(pname)"
fi
REL=$P/release LOG=$P/.releases B=$P/.deploy-build BLOG=$P/.deploy-build.log DATA=$P/data/app
G="git -C $P/code"

# the health path: DEPLOY_HEALTH_PATH, else the live release's own (app-run conf health), else /
health_path() { h=${DEPLOY_HEALTH_PATH:-}; [ -n "$h" ] || h=$("$P/bin/app-run" conf health "$REL" 2>/dev/null) || true; echo "${h:-/}"; }
healthy() { HEALTH=$(health_path); i=0; while [ $i -lt 20 ]; do
  c=$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 "$("$P/bin/svc" url app)$HEALTH" || true)
  [ "$c" = 200 ] && return 0; i=$((i + 1)); sleep 1; done; return 1; }
isbun() { [ -f "$1/bun.lock" ] || [ -f "$1/bun.lockb" ]; }
hasbuild() { node -e 'try { process.exit(typeof JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"))?.scripts?.build === "string" ? 0 : 1) } catch { process.exit(1) }' "$1/package.json"; }
# bunbuild <dir>: install (dev deps included) and build; the output in .deploy-build.log, its last lines on a failure
bunbuild() { command -v bun >/dev/null 2>&1 || { echo "deploy: the release has bun.lock, but there is no bun on PATH" >&2; return 1; }
  if (cd "$1" && bun install --frozen-lockfile && if hasbuild "$1"; then bun run build; fi) >"$BLOG" 2>&1; then return 0; fi
  echo "deploy: bun install or build failed in $(basename "$1")/; the last lines of $(basename "$BLOG"):" >&2; tail -20 "$BLOG" >&2; return 1; }
# trybuild <rev>: a Bun release is built apart first (.deploy-build/, kept between deploys: its node_modules stay warm)
trybuild() { $G cat-file -e "$1:bun.lock" 2>/dev/null || $G cat-file -e "$1:bun.lockb" 2>/dev/null || return 0
  [ -e "$B/.git" ] || { rm -rf "$B"; $G worktree prune; $G worktree add -q --detach "$B" "$1" || return 1; }
  git -C "$B" checkout -q --detach --force "$1" && git -C "$B" clean -qfd && bunbuild "$B"; }
# switch <rev>: release/ to rev, installed (and built), the app restarted (each step: a failure returns 1)
switch() { git -C "$REL" checkout -q --detach "$1" || return 1
  [ -d "$DATA" ] || { mkdir -p "$DATA" && chmod 700 "$DATA"; } || echo "deploy: warn: could not make $DATA (the app's DATA_DIR)" >&2
  if isbun "$REL"; then bunbuild "$REL" || return 1
  elif [ -f "$REL/package.json" ] && grep -q '"dependencies"' "$REL/package.json"; then (cd "$REL" && npm ci --omit=dev --silent --no-audit --no-fund) || return 1; fi
  [ "$STARTED" = 0 ] || "$P/bin/svc" restart app; }

[ $# -gt 0 ] || set -- main
exec 9>"$P/.deploy.lock"; flock -w 120 9 || { echo "deploy: another deploy is running" >&2; exit 1; }
# a box with the project API: build release/<build>/, ask the owner for it (the host decides; nothing restarts here)
if [ -n "$API" ]; then
  logl() { echo "$(date -u +%FT%TZ) $1 $2 ${BEADS_ACTOR:-${USER:-?}}" >> "$LOG"; }
  case "$1" in
    status) echo "app: a box with the project API: its app slot runs the build the owner approved (release/<build>/)"
            echo "builds in release/: $(ls -1 "$REL" 2>/dev/null | tr '\n' ' ')"; tail -5 "$LOG" 2>/dev/null; exit 0 ;;
    rollback) prev=$(awk '$3=="asked"||$3=="approved"{print $2}' "$LOG" 2>/dev/null | tail -2 | head -1)
              [ -n "$prev" ] || { echo "deploy: no previous build to ask for again" >&2; exit 1; }
              set -- "$prev" ;;
  esac
  want=$($G rev-parse --verify --quiet "${1}^{commit}") || { echo "deploy: unknown revision $1" >&2; exit 2; }
  $G merge-base --is-ancestor "$want" main || { echo "deploy: $1 is not on main; land it first" >&2; exit 1; }
  build=$($G rev-parse --short "$want")
  # release/ and release/<build> real folders (the API checks it with lstat); release/<build> a worktree of code/
  if [ -L "$REL" ] || { [ -e "$REL" ] && [ ! -d "$REL" ]; }; then echo "deploy: release/ is not a real folder" >&2; exit 1; fi
  mkdir -p "$REL"; REL=$REL/$build
  if [ -e "$REL" ] || [ -L "$REL" ]; then
    { [ ! -L "$REL" ] && [ -e "$REL/.git" ] && [ "$(git -C "$REL" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$REL" && pwd -P)" ]; } ||
      { echo "deploy: release/$build is there and is not a worktree of code/: move it away, then deploy again" >&2; exit 1; }
  else $G worktree prune; $G worktree add -q --detach "$REL" "$want" || { echo "deploy: could not make release/$build a worktree of code/" >&2; exit 1; }; fi
  if ! switch "$want"; then logl "$build" build-failed; echo "deploy: $build: its install or build in release/$build failed; nothing asked" >&2; exit 1; fi
  ans=$(curl -s --max-time 30 --unix-socket "$API" -X POST -H 'content-type: application/json' -d "{\"build\":\"$build\"}" http://api/release) ||
    { echo "deploy: the project API did not answer; release/$build is built, nothing asked (deploy $build again)" >&2; exit 1; }
  st=$(printf '%s' "$ans" | sed -n 's/.*"status" *: *"\([a-z]*\)".*/\1/p')
  case "$st" in
    pending) logl "$build" asked; echo "asked the owner for release $build: it starts when approved" ;;
    done) logl "$build" approved; echo "release $build: the owner approved it already (the app slot runs it)" ;;
    *) why=$(printf '%s' "$ans" | sed -n 's/.*"why" *: *"\([a-z-]*\)".*/\1/p'); logl "$build" refused
       echo "deploy: the project API refused release $build: ${why:-no answer it knows}" >&2; exit 1 ;;
  esac
  exit 0
fi
# release/ is the release worktree only when it is a worktree of its own (release/.git, its top level release/ itself):
# git -C on a plain folder falls through to the repo above it (the project root's). An empty folder is replaced by a
# worktree; anything else is refused, untouched.
isrel() { [ -e "$REL/.git" ] && [ "$(git -C "$REL" rev-parse --show-toplevel 2>/dev/null)" = "$(cd "$REL" && pwd -P)" ]; }
# not started yet: status says so (and makes nothing: release/ is what makes mm start the slot)
if [ "$1" = status ] && [ "$STARTED" = 0 ]; then
  if isrel; then r="release/ is at $(git -C "$REL" log -1 --format='%h %s')"; else r="nothing deployed yet"; fi
  echo "app: declared, not started yet ($r): $NEXT"; tail -5 "$LOG" 2>/dev/null; exit 0; fi
if ! isrel; then
  if [ -d "$REL" ] && [ -n "$(ls -A "$REL" 2>/dev/null)" ]; then
    echo "deploy: release/ is not a worktree of code/ (no release/.git) and is not empty: move it away, then deploy again" >&2; exit 1; fi
  { [ ! -e "$REL" ] && [ ! -L "$REL" ]; } || rmdir "$REL" || { echo "deploy: release/ is not a worktree and could not be removed" >&2; exit 1; }
  $G worktree prune; $G worktree add -q --detach "$REL" main || { echo "deploy: could not make release/ a worktree of code/" >&2; exit 1; }
fi

case "${1:-main}" in
  status) echo "live: $(git -C "$REL" log -1 --format='%h %s')  ($("$P/bin/svc" url app))"; tail -5 "$LOG" 2>/dev/null; exit 0 ;;
  rollback) prev=$(awk '$3=="ok"{print $2}' "$LOG" 2>/dev/null | tail -2 | head -1)
            [ -n "$prev" ] || { echo "deploy: no previous release to roll back to" >&2; exit 1; }
            set -- "$prev" ;;
esac
want=$($G rev-parse --verify --quiet "${1}^{commit}") || { echo "deploy: unknown revision $1" >&2; exit 2; }
$G merge-base --is-ancestor "$want" main || { echo "deploy: $1 is not on main; land it first" >&2; exit 1; }
cur=$(git -C "$REL" rev-parse HEAD)
short=$(git -C "$P/code" rev-parse --short "$want")
if ! trybuild "$want"; then
  echo "$(date -u +%FT%TZ) $short build-failed ${BEADS_ACTOR:-${USER:-?}}" >> "$LOG"
  echo "deploy: $short not deployed: its build failed; production stays on $(git -C "$P/code" rev-parse --short "$cur")" >&2
  exit 1
fi
if [ "$STARTED" = 0 ]; then
  if switch "$want"; then
    echo "$(date -u +%FT%TZ) $short staged ${BEADS_ACTOR:-${USER:-?}}" >> "$LOG"
    echo "deployed $short into release/: $(git -C "$REL" log -1 --format=%s) (not started: no health check); $NEXT"; exit 0; fi
  echo "$(date -u +%FT%TZ) $short failed ${BEADS_ACTOR:-${USER:-?}}" >> "$LOG"
  echo "deploy: $short: its install or build in release/ failed; release/ back to $(git -C "$P/code" rev-parse --short "$cur"); $NEXT" >&2
  switch "$cur" || echo "deploy: release/ could not go back to $(git -C "$P/code" rev-parse --short "$cur") either" >&2
  exit 1
fi
if switch "$want" && healthy; then
  echo "$(date -u +%FT%TZ) $short ok ${BEADS_ACTOR:-${USER:-?}}" >> "$LOG"
  echo "deployed $short: $(git -C "$REL" log -1 --format=%s) (healthy at $("$P/bin/svc" url app)$HEALTH)"
else
  echo "$(date -u +%FT%TZ) $short failed ${BEADS_ACTOR:-${USER:-?}}" >> "$LOG"
  echo "deploy: $short did not come up healthy in 20s at $(health_path) (or its install failed); rolling back to $(git -C "$P/code" rev-parse --short "$cur")" >&2
  if switch "$cur" && healthy; then echo "rolled back; production is on $(git -C "$P/code" rev-parse --short "$cur")" >&2
  else echo "deploy: ROLLBACK ALSO UNHEALTHY: check the app's log in the process manager" >&2; fi
  exit 1
fi
