#!/bin/sh
# Leads = Paseo agents, one per role, started in leads/<role>/ so Claude Code loads that role's CLAUDE.md chain,
# skills and permissions.
#   bin/lead start <role> [--model provider/model]   start (archives a previous lead of that role first); LEAD_NEXT (from
#                                                   bin/wake): the queue items it may pull now, added to its first prompt
#   bin/lead stop <role>                            archive the lead
#   bin/lead ls                                     list leads
#   bin/lead tidy                                   archive this project's old Paseo workspaces and empty projects
# In Paseo, the project is one project (rooted here) and each role has one workspace in it, reused across restarts
# (bin/lib/lead-workspace.mjs).
[ "${MM_TRACE_SELF:-}" = "$0" ] || MM_TRACE_SELF=$0 exec "$(dirname "$(readlink -f "$0")")/trace" lead -- "$0" "$@"
set -eu
P=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
PROJECT=$(sed -n 's/^project:[[:space:]]*\([A-Za-z0-9._-]*\).*/\1/p' "$P/.mm-answers.yaml" 2>/dev/null || true); PROJECT=${PROJECT:-$(basename "$P")}
PASEO=${PASEO_BIN:-paseo}
# Leads are always top-level agents in their own folder. Run from inside an agent (e.g. the setup agent), paseo would
# otherwise make the lead that agent's sub-agent and use the caller's folder, brief and permissions.
unset PASEO_AGENT_ID PASEO_AGENT_CWD PASEO_WORKSPACE_ID
ids() { "$PASEO" ls -g --label "project=$PROJECT" --label "role=$1" -q 2>/dev/null || true; }
# Archive every lead of a role, and say so when one stays (sy-8n1: a silent failure left two leads of one role).
# A lead in the middle of a turn refuses a plain archive: wait for it up to LEAD_ARCHIVE_WAIT seconds (default 30),
# then interrupt it (--force). Returns 1, with paseo's reason, if any lead of the role is still there afterwards.
archive_role() {
  for id in $(ids "$1"); do
    t=0; why=""; gone=""
    while :; do
      if why=$("$PASEO" archive "$id" 2>&1 >/dev/null); then echo "archived $2$1 lead $id"; gone=1; break; fi
      [ "$t" -ge "${LEAD_ARCHIVE_WAIT:-30}" ] && break; sleep 3; t=$((t + 3))
    done
    [ -z "$gone" ] || continue
    if why=$("$PASEO" archive --force "$id" 2>&1 >/dev/null); then echo "archived $2$1 lead $id (interrupted: it was busy for ${t}s)"
    else echo "lead: could not archive $1 lead $id: ${why:-no reason given}" >&2; fi
  done
  left=$(ids "$1")
  [ -z "$left" ] || { echo "lead: $1 lead(s) still there: $(echo $left)" >&2; return 1; }
}
# What the role has open on its board (in progress, blocked), for the new lead's first prompt: a restart must not
# leave it idle (sy-8n1). Empty when the board can't be read; the lead still finds its items itself.
open_items() {
  "$P/bin/bd" list --assignee "$1" --status in_progress,blocked --json 2>/dev/null \
    | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{try{for(const i of JSON.parse(s))console.log('- '+i.id+' ('+i.status+'): '+String(i.title).slice(0,100))}catch{}})" 2>/dev/null || true
}
case "${1:-}" in
  ls) "$PASEO" ls -g --label "project=$PROJECT" ;;
  tidy) node "$P/bin/lib/lead-workspace.mjs" --tidy "$P" ;;
  stop) [ -n "${2:-}" ] || { echo "usage: bin/lead stop <role>" >&2; exit 2; }
        archive_role "$2" "" || exit 1 ;;
  start)
    role=${2:-}; DIR=$P/leads/$role; [ "$role" = setup ] && DIR=$P/setup   # setup = the governance agent
    [ -n "$role" ] && [ -d "$DIR" ] || { echo "no such role: $role" >&2; exit 2; }
    # model: --model, else the role's `model` in leads/roles.json, else the default
    model=$(node -e "try{const r=require('$P/leads/roles.json').roles.find(x=>x.id==='$role');process.stdout.write((r&&r.model)||'')}catch{}" 2>/dev/null)
    model=${model:-claude/claude-opus-5-5}; [ "${3:-}" = --model ] && model=$4
    # exactly one lead per role: the old one goes first, or this one doesn't start
    archive_role "$role" "previous " || { echo "lead: not starting a second $role lead" >&2; exit 1; }
    # its own worktree for docs/tests, unless it is setup or a role that works through workers
    workers=$(node -e "try{const r=require('$P/leads/roles.json').roles.find(x=>x.id==='$role');process.stdout.write(r&&r.workers?'1':'')}catch{}" 2>/dev/null)
    [ "$role" = setup ] || [ -n "$workers" ] || [ ! -x "$P/bin/wt" ] || "$P/bin/wt" "lead-$role" >/dev/null  # no wt: a board without worktrees (system)
    "$P/bin/config-check" --render >/dev/null || { echo "lead: config-check failed; not starting $role" >&2; "$P/bin/config-check"; exit 1; }
    START=$P/leads/START.md; [ -f "$DIR/START.md" ] && START=$DIR/START.md
    name=$(node -e "try{process.stdout.write(require('$P/leads/personas.json').agents['$role'].name||'')}catch{}" 2>/dev/null)
    prompt=$(sed -e "s/{role}/$role/g" -e "s/{project}/$PROJECT/g" -e "s/{name}/${name:-the $role lead}/g" "$START")
    items=$(open_items "$role")
    [ -z "$items" ] || prompt="$prompt

Handover: a previous $role lead had these items open (in progress or blocked). Read each one's latest comments, then carry on with them; don't wait for a board update:
$items"
    # the head of its queue, from the dispatcher (bin/wake, within the role's capacity): what to pull first
    [ -z "${LEAD_NEXT:-}" ] || prompt="$prompt

Next in your queue (wake hands it to you, within your capacity): claim it with \`bd update <id> --claim\`, then do it or give it to a worker:
$LEAD_NEXT"
    unset LEAD_NEXT
    # its own Claude folder for this project (no global CLAUDE.md, settings or memory), with its folder trusted
    # (and the project root: Claude Code runs an MCP headersHelper, e.g. the design lead's Doop key, only when the
    # workspace root, the git root, is trusted; plans/doop.md)
    CDIR=$(MM_PROJECT="$PROJECT" node "$P/bin/lib/claude.mjs" trust "$DIR" "$P") || { echo "lead: could not prepare the Claude folder" >&2; exit 1; }
    # its place in Paseo: the role's workspace in the project's one Paseo project (empty: Paseo picks, as before)
    WS=$(node "$P/bin/lib/lead-workspace.mjs" "$P" "$DIR" "$role lead" "$PROJECT" || true)
    "$PASEO" run --no-wait -q --title "$PROJECT · $role lead" --provider "$model" --mode auto --env "CLAUDE_CONFIG_DIR=$CDIR" \
      ${WS:+--workspace "$WS"} --cwd "$DIR" --label "project=$PROJECT" --label "role=$role" \
      --env "BEADS_ACTOR=$role" \
      --env "GIT_AUTHOR_NAME=$role" --env "GIT_COMMITTER_NAME=$role" \
      --env "GIT_AUTHOR_EMAIL=$role@$PROJECT.local" --env "GIT_COMMITTER_EMAIL=$role@$PROJECT.local" --env "PATH=$P/bin:$PATH" "$prompt"
    ;;
  *) sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
