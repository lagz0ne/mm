#!/bin/sh
# Land a worktree branch on main: rebase it onto main, then fast-forward code/ (the deployed checkout).
# Serialised with a lock, so two agents landing at once can't interleave. Never merges, never rewrites main.
#   land <name>   prints the new main commit (short hash) on success
# After the fast-forward, a project with an app slot (services.json: app, deploy's own check) deploys main by itself:
# `deploy main` starts detached, its output appended to .run/logs/deploy-land.log (headed by the land's hash and time);
# land says so in one line on stderr and never fails for the deploy. Off with deploy.on_land false: in the project's
# services.yaml (deploy: / on_land: false), or for the machine in mm's config.yaml (mm config set deploy.on_land false);
# DEPLOY_ON_LAND=0|1 overrides both.
[ "${MM_TRACE_SELF:-}" = "$0" ] || MM_TRACE_SELF=$0 exec "$(dirname "$(readlink -f "$0")")/trace" land -- "$0" "$@"
set -eu
P=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
name=${1:?usage: land <worktree-name>}
case "$name" in *[!a-z0-9._-]*|.*) echo "land: bad name" >&2; exit 2;; esac
W=$P/worktrees/$name
[ -d "$W" ] || { echo "land: no worktree $name" >&2; exit 2; }
exec 9>"$P/worktrees/.land.lock"
flock -w 120 9 || { echo "land: lock busy for 120s" >&2; exit 1; }
[ -z "$(git -C "$W" status --porcelain)" ] || { echo "land: $name has uncommitted changes; commit first" >&2; exit 1; }
[ -z "$(git -C "$P/code" status --porcelain --untracked-files=no)" ] || { echo "land: code/ has local edits (nobody should edit code/ directly)" >&2; exit 1; }
git -C "$W" rebase -q main || { git -C "$W" rebase --abort; echo "land: $name conflicts with main; rebase and resolve in the worktree, then land again" >&2; exit 1; }
if git -C "$P/code" merge-base --is-ancestor "$name" main; then echo "land: nothing new on $name"; git -C "$P/code" rev-parse --short main; exit 0; fi
# The project's gate (ops/land-check, machine-level): typically the test suite. Red never reaches main.
if [ -x "$P/ops/land-check" ]; then "$P/ops/land-check" "$W" || { echo "land: $name refused by ops/land-check (fix it on the branch, then land again)" >&2; exit 1; }; fi
git -C "$P/code" merge -q --ff-only "$name"
h=$(git -C "$P/code" rev-parse --short main); echo "$h"
# deploy.on_land: DEPLOY_ON_LAND, else services.yaml's deploy.on_land, else mm config's; default on
onland() { case "${DEPLOY_ON_LAND:-}" in 0|false|no|off) return 1 ;; 1|true|yes|on) return 0 ;; esac
  for f in "$P/services.yaml" "${MM_HOME:-$HOME/.mm}/config.yaml"; do
    v=$(awk '/^deploy:[ \t]*$/{d=1; next} d && /^[^ \t#]/{d=0} d && /^[ \t]+on_land:/{sub(/^[ \t]+on_land:[ \t]*/, ""); gsub(/["\047 \t]|#.*/, ""); print; exit}' "$f" 2>/dev/null)
    case "$v" in false|no|off|0) return 1 ;; true|yes|on|1) return 0 ;; esac; done; return 0; }
if onland; then
  if grep -q '"app"' "$P/.run/services.json" 2>/dev/null || grep -q '"app"' "$P/services.json" 2>/dev/null; then
    DL=$P/.run/logs/deploy-land.log
    if mkdir -p "$P/.run/logs" 2>/dev/null && echo "== $(date -u +%FT%TZ) land $name -> $h: deploy main" >>"$DL" 2>/dev/null; then
      # detached (its own session, no terminal), and without fd 9: the land lock is not held while it deploys
      S=; command -v setsid >/dev/null 2>&1 && S=setsid
      ( cd "$P" && exec $S nohup "$P/bin/deploy" main </dev/null >>"$DL" 2>&1 9>&- ) &
      echo "land: deploying $h in the background (log: .run/logs/deploy-land.log)" >&2
    else echo "land: warn: could not write .run/logs/deploy-land.log; no deploy (run deploy main)" >&2; fi
  else echo "land: no app slot, no deploy" >&2; fi
fi
exit 0
