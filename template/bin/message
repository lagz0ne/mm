#!/usr/bin/env node
// message — check a message between roles (sy-0gsw; the format: bin/lib/message.mjs, the leads' brief "Messages
// between roles"). Every comment a lead (a role of leads/roles.json, or its worker <role>/<name>) writes is one.
//   message check -                 a message on stdin: exit 0 ok, 1 invalid (the reasons on stderr)
//   message check <id> <n>          comment #n of the item, read with this project's bin/bd
//   message waits <id>              what waits on whom on the item: each ASK or HANDOFF with no answer (re #n)
//   message gate <actor> -- <bd args>  bin/bd runs it on bd comments add / bd comment: refuses (exit 1, the reasons) a
//                                   comment by a lead that is not a valid message. Any other actor (wake, watchdog,
//                                   bridge, mm-upstream, a person) and any other call: exit 0. --author does not change
//                                   who writes. --stdin is refused for a lead: write the text to a file (-f).
// The words of a message follow the writing rules (sy-ko6r; bin/lib/writing.mjs, the glossary glossary.yaml and
// glossary.local.yaml, the word list bin/lib/words.txt): before the glossary's refuse_from (or with none) a problem is a
// warning on stderr and the comment goes through; from that day on the gate refuses it. A person's comment is not read.
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { readGlossary } from './lib/glossary.mjs'
import { FORMAT, openWaits, parseMessage } from './lib/message.mjs'
import { sayWriting } from './lib/writing.mjs'
import { actOf, noInputOk, rowOf } from './lib/raci.mjs'

const P = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const die = (m, code = 2) => { console.error(`message: ${m}`); process.exit(code) }
/** The board's role ids (leads/roles.json); none when the file is missing (then nobody is a lead here). */
function roles() {
  try { const j = JSON.parse(fs.readFileSync(path.join(P, 'leads', 'roles.json'), 'utf8')); return (j.roles || []).map((r) => r?.id).filter((x) => typeof x === 'string') }
  catch { return [] }
}
/** The writing check's setting: the board's glossary (both files) and the word list. */
function writing() {
  const g = readGlossary((f) => { try { return fs.readFileSync(path.join(P, f), 'utf8') } catch { return null } })
  return { terms: g.terms, words: g.words, refuseFrom: g.refuseFrom }
}
/** The warnings of a message that passed, on stderr (the leads' brief, "Glossary"). */
function warn(r, w) {
  if (!r.writing?.length) return
  console.error(`message: writing (ASD-STE100): ${r.writing.length} warning(s); the comment goes through${w.refuseFrom ? ` (from ${w.refuseFrom} the hard ones are refused)` : ''}:\n${sayWriting(r.writing)}\nOnly approved words (bin/lib/words.txt) and glossary terms (glossary.yaml); to add a term, see the leads' brief, "Glossary".`)
}
const say = (r) => r.errors.map((e) => `  - ${e}`).join('\n')
const shown = { labels: [] } // the labels of the item comments() read last
/** The item's RACI row (leads/raci.json, its act:<id> label; sy-lusk), or null. */
function row(labels) {
  try { return rowOf(JSON.parse(fs.readFileSync(path.join(P, 'leads', 'raci.json'), 'utf8')).activities, actOf(labels)) } catch { return null }
}
function comments(id) {
  let out
  try { out = execFileSync(path.join(P, 'bin', 'bd'), ['show', id, '--json'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 30000, maxBuffer: 16 << 20 }) }
  catch (e) { die(`cannot read ${id} (bd show: ${String(e.stderr || e.message).trim().split('\n').pop().slice(0, 200)})`) }
  let j; try { j = JSON.parse(out) } catch { die(`cannot read ${id} (bd show gave no JSON)`) }
  const i = Array.isArray(j) ? j[0] : j
  if (!i) die(`no item ${id}`)
  shown.labels = Array.isArray(i.labels) ? i.labels : []
  if (Array.isArray(i.comments)) return i.comments
  try { return JSON.parse(execFileSync(path.join(P, 'bin', 'bd'), ['comments', id, '--json'], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], timeout: 30000, maxBuffer: 16 << 20 })) || [] }
  catch { return [] }
}

// bd's flags that take a value (everything else is a switch)
const VALUED = new Set(['--actor', '--db', '--database', '-C', '--directory', '-f', '--file', '-a', '--author', '--dolt-auto-commit', '--cpu-profile-file', '--mem-profile'])
function gate(actor, argv) {
  const RS = roles()
  if (!RS.includes(String(actor).split('/')[0])) process.exit(0) // not a lead: wake, watchdog, bridge, a person
  const pos = [], text = []
  let file = null, stdin = false
  for (let k = 0; k < argv.length; k++) {
    const a = argv[k]
    if (a === '--') { text.push(...argv.slice(k + 1)); break }
    if (a.startsWith('-') && a.length > 1) {
      const eq = a.indexOf('='), name = a.startsWith('--') && eq > 0 ? a.slice(0, eq) : a
      const v = a.startsWith('--') && eq > 0 ? a.slice(eq + 1) : VALUED.has(a) ? argv[++k] ?? '' : null
      if (name === '-f' || name === '--file') file = v
      if (name === '--stdin') stdin = true
      continue
    }
    pos.push(a)
  }
  let words
  if (pos[0] === 'comments' && pos[1] === 'add') words = pos.slice(3)
  else if (pos[0] === 'comment') words = pos.slice(2)
  else process.exit(0)
  const no = (why) => { console.error(`bd: refused: a lead's comment is one message (${actor}): ${why}\nThe format: ${FORMAT}.`); process.exit(1) }
  if (stdin) no('--stdin cannot be checked before bd reads it: write the message to a file and pass -f <file>')
  let body
  if (file !== null) { try { body = fs.readFileSync(file, 'utf8') } catch { no(`cannot read -f ${file}`) } }
  else body = [...words, ...text].join(' ')
  const w = writing()
  const r = parseMessage(body, { roles: RS, author: actor, writing: w })
  if (!r.ok) no(`${r.found ? `this ${r.intent} is invalid` : 'it is not a message'}:\n${say(r)}`)
  warn(r, w)
  process.exit(0)
}

const [cmd, ...rest] = process.argv.slice(2)
if (cmd === 'check') {
  let text, what, author
  if (rest.length === 1 && rest[0] === '-') { text = fs.readFileSync(0, 'utf8'); what = 'the message' }
  else if (rest.length === 2 && /^[0-9]+$/.test(rest[1])) {
    const c = comments(rest[0])[Number(rest[1]) - 1]
    if (!c) die(`${rest[0]} has no comment #${rest[1]}`)
    text = c.text; author = String(c.author ?? ''); what = `${rest[0]} #${rest[1]}`
  } else die('usage: message check - | message check <id> <n>')
  const w = writing()
  const r = parseMessage(text, { roles: roles(), author, writing: w })
  if (r.ok) { console.log(`message ok (${r.intent} → ${r.to})`); warn(r, w); process.exit(0) }
  console.error(`message: ${what} is ${r.found ? `an invalid ${r.intent}` : 'not a message'}:\n${say(r)}\nThe format: ${FORMAT}.`)
  process.exit(1)
} else if (cmd === 'waits') {
  if (rest.length !== 1) die('usage: message waits <id>')
  const all = openWaits(comments(rest[0]), { roles: roles() }), r = row(shown.labels)
  // an ASK to a role that is only C in the item's RACI row (sy-lusk): no answer by By is "no input"; it blocks nothing
  const w = all.filter((x) => !(x.late && noInputOk(r, x.role, x.intent)))
  if (!w.length) console.log(`${rest[0]}: nothing waits`)
  for (const x of w) console.log(`#${x.n} ${x.intent} ${x.from} → ${x.role}: ${x.action}${x.by ? ` · by ${x.by}` : ''}${x.late ? ' · LATE' : ''}`)
  for (const x of all.filter((y) => !w.includes(y))) console.log(`#${x.n} ASK ${x.from} → ${x.role} (C): no answer by ${x.by}: no input; nothing waits on it`)
} else if (cmd === 'gate') {
  const [actor, ...more] = rest
  if (!actor) die('usage: message gate <actor> -- <bd args>')
  gate(actor, more[0] === '--' ? more.slice(1) : more)
} else die('usage: message check - | message check <id> <n> | message waits <id> | message gate <actor> -- <bd args>')
