{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mm:schema:message:v1",
  "title": "A message between roles (v1): one comment of a lead, stored as a fenced block mm-message v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "to"],
  "properties": {
    "intent": { "enum": ["ASK", "HANDOFF", "VERDICT", "ANSWER", "DONE", "NOTE"] },
    "to": { "$ref": "urn:mm:schema:common:v1#/$defs/actor" },
    "re": { "type": "integer", "minimum": 1 },
    "head": { "$ref": "urn:mm:schema:common:v1#/$defs/head" },
    "expect": { "$ref": "urn:mm:schema:common:v1#/$defs/expect" },
    "done": { "$ref": "urn:mm:schema:common:v1#/$defs/done" },
    "verify": { "$ref": "urn:mm:schema:common:v1#/$defs/verify" },
    "by": { "$ref": "urn:mm:schema:common:v1#/$defs/by" },
    "else": { "$ref": "urn:mm:schema:common:v1#/$defs/else" },
    "need": { "$comment": "ASK: what is needed (the Why)", "enum": ["decision", "info", "review", "access", "sign-off", "resource", "fix", "test"] },
    "options": { "$comment": "ASK: the options to pick from (an ANSWER names one)", "type": "array", "minItems": 2, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "urn:mm:schema:common:v1#/$defs/slug" } },
    "ready": { "$comment": "HANDOFF: what is ready (heads, items, files, branches)", "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "urn:mm:schema:common:v1#/$defs/ref" } },
    "surfaces": { "$comment": "HANDOFF: every place outside the repo the change reaches, or [none]", "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
      "items": { "description": "none, or a place (cli, bin, site, board, template, config, migration, service, box, cron, db, docs, brief, hook, proxy), with :<name> when it helps", "type": "string", "pattern": "^(none|cli|bin|site|board|template|config|migration|service|box|cron|db|docs|brief|hook|proxy)(:[a-z0-9][a-z0-9._/-]{0,40})?$" } },
    "tests": { "$ref": "urn:mm:schema:common:v1#/$defs/tests" },
    "open": { "$comment": "HANDOFF: what is still open (items)", "type": "array", "maxItems": 12, "items": { "$ref": "urn:mm:schema:common:v1#/$defs/id" } },
    "result": { "enum": ["signed-off", "blocked", "done", "partial", "dropped"] },
    "mustChange": { "$comment": "VERDICT: what must change (where, and the rule it breaks)", "type": "array", "minItems": 1, "maxItems": 12,
      "items": { "type": "object", "additionalProperties": false, "required": ["path"],
        "properties": { "path": { "$ref": "urn:mm:schema:common:v1#/$defs/path" }, "line": { "type": "integer", "minimum": 1 }, "rule": { "$ref": "urn:mm:schema:common:v1#/$defs/slug" } } } },
    "followUps": { "$comment": "DONE: the follow-up items", "type": "array", "maxItems": 12, "items": { "$ref": "urn:mm:schema:common:v1#/$defs/id" } },
    "artifacts": { "type": "array", "maxItems": 12, "items": { "$ref": "urn:mm:schema:common:v1#/$defs/path" } },
    "answer": { "$comment": "ANSWER: yes, no, or the key of one of the ASK's options", "$ref": "urn:mm:schema:common:v1#/$defs/slug" },
    "parts": { "$ref": "urn:mm:schema:common:v1#/$defs/parts" }
  },
  "allOf": [
    { "if": { "required": ["intent"], "properties": { "intent": { "const": "ASK" } } },
      "then": { "required": ["expect", "need"], "properties": { "expect": { "type": "object" },
        "ready": false, "surfaces": false, "tests": false, "open": false, "result": false, "mustChange": false, "followUps": false, "artifacts": false, "answer": false } } },
    { "if": { "required": ["intent"], "properties": { "intent": { "const": "HANDOFF" } } },
      "then": { "required": ["expect", "ready", "surfaces"], "properties": { "expect": { "type": "object" },
        "need": false, "options": false, "result": false, "mustChange": false, "followUps": false, "artifacts": false, "answer": false } } },
    { "if": { "required": ["intent"], "properties": { "intent": { "const": "VERDICT" } } },
      "then": { "required": ["expect", "result", "head"], "properties": { "expect": { "type": "object" }, "result": { "enum": ["signed-off", "blocked"] },
        "need": false, "options": false, "ready": false, "surfaces": false, "tests": false, "open": false, "followUps": false, "artifacts": false, "answer": false } } },
    { "if": { "required": ["intent"], "properties": { "intent": { "const": "ANSWER" } } },
      "then": { "required": ["expect", "answer", "re"], "properties": {
        "need": false, "options": false, "ready": false, "surfaces": false, "tests": false, "open": false, "result": false, "mustChange": false, "followUps": false, "artifacts": false } } },
    { "if": { "required": ["intent"], "properties": { "intent": { "const": "DONE" } } },
      "then": { "required": ["expect", "result", "verify"], "properties": { "expect": { "const": "none" }, "result": { "enum": ["done", "partial", "dropped"] },
        "need": false, "options": false, "ready": false, "surfaces": false, "tests": false, "open": false, "mustChange": false, "answer": false } } },
    { "if": { "required": ["intent"], "properties": { "intent": { "const": "NOTE" } } },
      "then": { "required": ["parts"], "properties": { "expect": false, "done": false, "verify": false, "by": false, "else": false,
        "need": false, "options": false, "ready": false, "surfaces": false, "tests": false, "open": false, "result": false, "mustChange": false, "followUps": false, "artifacts": false, "answer": false } } },
    { "$comment": "An Expect that names a role needs Done when, Verify, By and Else.",
      "if": { "required": ["expect"], "properties": { "expect": { "type": "object" } } },
      "then": { "required": ["done", "verify", "by", "else"] } },
    { "$comment": "An ANSWER with Expect none points to the evidence (Verify).",
      "if": { "required": ["expect"], "properties": { "intent": { "const": "ANSWER" }, "expect": { "const": "none" } } },
      "then": { "required": ["verify"] } }
  ]
}
