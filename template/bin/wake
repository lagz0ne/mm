#!/usr/bin/env node
// wake — pokes a role's lead (Paseo agent labelled project=<P> role=<role>) when its work changes on the board.
// Listens to the Beads event stream; collects reasons per role; sends them only when that lead is idle,
// so a working lead is never interrupted. Changes a lead (or its workers, actor `<role>/...`) makes never wake it.
// The end of a unit of work is a bd state change (reassign, blocked, dep add, reopen, close): it wakes the role who acts
// next, even when the writer is the item's old assignee (see transition()).
// Hop limit: after MAX_HOPS lead-to-lead wakes on one item without a human in between, the item gets `needs-you`
// and leads stop being woken for it until a human acts on it.
// Leads are on demand: a role with no agent (or a closed one) is started when work waits for it, and a lead idle for
// WAKE_IDLE_CLOSE_MS with nothing of its own open is closed (see startLead() and closeIdle()).
// Env: BD_SERVE (else the bd-serve URL from .run/endpoints.json), WAKE_EVERY_MS (default 5000), WAKE_RESUME_CHECK_MS (the
// lead check, default 60000), WAKE_RESUME_MS (at most one start per role per this, default 600000), WAKE_IDLE_CLOSE_MS
// (default 1800000 = 30 min; 0 = never close). Paseo: bin/lib/paseo.mjs (its SDK, else the CLI: PASEO_BIN, PASEO_URL,
// PASEO_NO_SDK=1).
import { execFile, fetch, log as olog, span, startMetrics, count } from './lib/obs.mjs'
import * as P_ from './lib/paseo.mjs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const P = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
import { projectName } from './lib/svc.mjs'
const PROJECT = projectName()
import { dirs, requireUrl } from './lib/svc.mjs'
const BD = new URL(process.env.BD_SERVE || requireUrl('bd-serve'))
const EVERY = Number(process.env.WAKE_EVERY_MS || 5000)
const MAX_HOPS = Number(process.env.WAKE_MAX_HOPS || 3)
import fs from 'node:fs'
// Roles come from leads/roles.json (re-read on change); setup = the governance agent. RACI from leads/raci.json.
// roles.json `lead`: the board's Lead (the role a BLOCKED goes to when the item's activity names no Accountable role).
// A role with `"keep": true` is the owner's contact (e.g. the system board's ops agent: the owner's chat bridge points at
// its agent id): wake never closes it and never starts one (a new start is a new id), it asks the human instead.
const ROLES = []
const KEEP = new Set()
let BOARD_LEAD = null
const pending = {} // role -> issue id -> latest reason
function loadRoles() {
  let ids = [], d = {}
  try { d = JSON.parse(fs.readFileSync(path.join(P, 'leads', 'roles.json'), 'utf8')); ids = d.roles.map((r) => r.id) } catch { ids = [] } // no roles file: only the setup agent
  ROLES.splice(0, ROLES.length, ...ids, 'setup')
  BOARD_LEAD = ids.includes(d.lead) ? d.lead : null
  KEEP.clear(); for (const r of (Array.isArray(d.roles) ? d.roles : [])) if (r && r.keep === true) KEEP.add(r.id)
  for (const r of ROLES) pending[r] ||= new Map()
}
loadRoles()
const raci = () => { try { return JSON.parse(fs.readFileSync(path.join(P, 'leads', 'raci.json'), 'utf8')).activities || [] } catch { return [] } }
const hops = new Map() // issue id -> lead-to-lead wakes sent since a human last acted on it
const paused = new Set() // items paused at the hop limit (needs-you set once; resumed by a human)
const idleSeen = {} // role -> agent id seen idle on the previous tick

const log = (...a) => olog(/fail/i.test(String(a[0])) ? 'error' : 'info', a.map(String).join(' '))
startMetrics()
const clip = (s, n = 160) => (s || '').replace(/\s+/g, ' ').slice(0, n)
const bd = (p) => fetch(new URL(p, BD)).then((r) => r.json())

function note(role, id, reason, byLead = false) {
  if (!ROLES.includes(role)) return
  const prev = pending[role].get(id)
  pending[role].set(id, { reason, byLead: byLead || !!prev?.byLead })
}

const leadOf = (actor) => ROLES.find((r) => actor === r || (actor || '').startsWith(`${r}/`)) || null
const SYSTEM = ['ui', 'wake', 'watchdog', 'smoke', 'beads'] // the board's own actors (the Supervisor and sentinel post as watchdog)
const isHuman = (actor) => !!actor && !leadOf(actor) && !SYSTEM.includes(actor)

function stopLoop(id) {
  log(`hop limit: ${id} had ${MAX_HOPS} lead-to-lead wakes; labelling needs-you, not waking`)
  execFile(path.join(P, 'bin/bd'), ['label', 'add', id, 'needs-you', '--actor', 'wake'], { cwd: path.join(P, 'control'), timeout: 20000 },
    (err) => err && log(`label ${id} failed:`, clip(err.message, 200)))
  execFile(path.join(P, 'bin/bd'), ['comments', 'add', id, `Paused: ${MAX_HOPS} lead-to-lead wakes on this item without a human in between. A human comment or change resumes it.`, '--actor', 'wake'],
    { cwd: path.join(P, 'control'), timeout: 20000 }, () => {})
}

// RACI routing: an item labelled act:<activity> asks its Consulted roles for input when created, and tells its
// Informed roles when closed. The doer (assignee) and the actor's own role are skipped.
function raciRoute(e, byLead = false) {
  const act = (e.issue?.labels || []).find((l) => l.startsWith('act:'))?.slice(4)
  if (!act || !['create', 'close'].includes(e.op)) return
  const a = raci().find((x) => x.id === act)
  if (!a) return
  const letter = e.op === 'create' ? 'C' : 'I'
  const who = e.actor || 'beads', title = clip(e.issue?.title, 80)
  for (const [role, l] of Object.entries(a.raci || {})) {
    if (!l.includes(letter) || !ROLES.includes(role) || role === e.issue?.assignee || role === leadOf(e.actor)) continue
    note(role, e.issue_id, (letter === 'C'
      ? `consult: ${who} opened ${e.issue_id} "${title}" (${a.title}). You are Consulted: comment your input on it, or "no input".`
      : `FYI: ${who} closed ${e.issue_id} "${title}" (${a.title})${e.issue?.close_reason ? `: ${clip(e.issue.close_reason, 200)}` : ''}. You are Informed; act only if it affects your work.`), byLead)
  }
}

// The end of a unit of work is a plain bd state change (plans/slp, "All of it is plain bd"), never a word in a comment:
//   handoff     bd update <id> -a <role> --if-assignee <me> --if-status <s>   wakes <role> (also when the writer is the
//               old assignee); a reassign to a person (the owner, a human) labels the item needs-you
//   blocked     bd update <id> -s blocked     wakes the item's Accountable role (its act: activity), else the board's Lead
//                                             (roles.json `lead`), else labels needs-you
//   dependency  bd dep add <id> <other>       wakes <other>'s assignee
//   reopen      bd reopen <id>                wakes <id>'s assignee (the board's Lead when that is the writer itself)
//   done        bd close <id>                 wakes nobody (closing tells the RACI's Informed roles)
// A change is read against what wake last saw of the item (`seen`: its assignee and status). A change by a lead is a
// lead-to-lead wake: the hop limit counts it. A role is never woken by its own change; the board's own actors (wake's
// requeue, bd's recompute, the Supervisor) are never a signal.
const seen = new Map() // item id -> { assignee, status } as of the last event (or the list at start)
const bdRun = (args, what) => execFile(path.join(P, 'bin/bd'), [...args, '--actor', 'wake'], { cwd: path.join(P, 'control'), timeout: 20000 },
  (err) => err && log(`${what} failed:`, clip(err.message, 200)))
const KINDS = { handoff: 'HANDOFF', blocked: 'BLOCKED', dependency: 'DEPENDENCY', reopen: 'REOPEN' }
function transition(e, byLead) {
  const woke = new Set(), id = e.issue_id, i = e.issue, was = seen.get(id)
  const writer = e.actor || 'beads', self = leadOf(writer)
  if (!i || SYSTEM.includes(writer)) return woke
  const title = clip(i.title, 80), labels = i.labels || []
  const to = (kind, role, reason) => {
    if (!ROLES.includes(role) || role === self) return false
    count('mm_wake_signals_total', { kind: KINDS[kind] })
    note(role, id, reason, byLead); woke.add(role); log(`${KINDS[kind]} on ${id} by ${writer}: waking ${role}`); return true
  }
  const needsYou = (kind, why) => {
    count('mm_wake_signals_total', { kind: KINDS[kind] })
    log(`${KINDS[kind]} on ${id} by ${writer}: ${why}; labelling needs-you`)
    if (!labels.includes('needs-you')) bdRun(['label', 'add', id, 'needs-you'], `label ${id}`)
  }
  if (e.op === 'dep_add') { // `bd dep add <id> <target>`: <id> now waits on <target>
    const ref = e.dep?.target
    if (!ref || (e.dep.kind && e.dep.kind !== 'blocks')) return woke
    bd(`/v0/beads/issues/${encodeURIComponent(ref)}`).then((d) => {
      if (!d?.id) return log(`DEPENDENCY on ${id} by ${writer}: no item ${ref} on this board; nobody woken`)
      if (!to('dependency', d.assignee, `DEPENDENCY: ${writer}'s ${id} "${title}" now waits on your ${ref} "${clip(d.title, 80)}" (${d.status}). Read why on ${id}.`))
        log(`DEPENDENCY on ${id} by ${writer}: ${ref} has no other lead to wake (${d.assignee || 'unassigned'})`)
    }).catch(() => {})
    return woke
  }
  if (!was) return woke // never seen before (created while wake was down): the next lead check covers it
  if (i.assignee && i.assignee !== was.assignee && i.status !== 'closed') {
    if (ROLES.includes(i.assignee)) to('handoff', i.assignee, `HANDOFF to you from ${writer} on ${id} "${title}" (was ${was.assignee || 'unassigned'}, now ${i.status}). Read its latest comments, then take it up and answer on the item.`)
    else if (i.assignee !== writer && !SYSTEM.includes(i.assignee)) needsYou('handoff', `handed to ${i.assignee} (a person)`)
  }
  if (i.status === 'blocked' && was.status !== 'blocked') {
    const act = labels.find((l) => l.startsWith('act:'))?.slice(4)
    const acc = Object.entries(raci().find((x) => x.id === act)?.raci || {}).find(([r, l]) => l.includes('A') && ROLES.includes(r) && r !== self)?.[0]
    const target = acc || (BOARD_LEAD !== self ? BOARD_LEAD : null)
    if (!target || !to('blocked', target, `BLOCKED: ${writer} set ${id} "${title}" to blocked (assignee ${i.assignee || 'none'}). Read why on the item; help unblock it, or route it to who can.`)) needsYou('blocked', 'no lead to route it to')
  }
  if (was.status === 'closed' && i.status !== 'closed') {
    let role = i.assignee
    if (!role || role === self) role = BOARD_LEAD
    if (!to('reopen', role, `REOPEN: ${writer} reopened ${id} "${title}" (assignee ${i.assignee || 'none'}): it does not hold. Read why on the item.`))
      log(`REOPEN of ${id} by ${writer}: no other lead to wake (${role || 'none'})`)
  }
  return woke
}

function onEvent(e) {
  return span('wake event', { op: e.op, issue: e.issue_id, actor: e.actor }, () => {
    try { onEvent1(e) } finally { if (e.issue) seen.set(e.issue_id, { assignee: e.issue.assignee || '', status: e.issue.status }) }
  }, { minMs: 1000 })
}
function onEvent1(e) {
  if (e.actor === 'wake') return // its own pause notes
  if (isHuman(e.actor)) { hops.delete(e.issue_id); paused.delete(e.issue_id) } // a human in the loop resets the count
  const byLead = !!leadOf(e.actor)
  if (byLead && (hops.get(e.issue_id) || 0) >= MAX_HOPS) { // at the limit: pause it, visibly, once
    if (!paused.has(e.issue_id)) { paused.add(e.issue_id); log(`hop limit on ${e.issue_id}: paused`); count('mm_wake_paused_total', {}); stopLoop(e.issue_id) }
    return
  }
  raciRoute(e, byLead)
  const signalled = transition(e, byLead)
  const role = e.issue?.assignee
  if (!ROLES.includes(role) || leadOf(e.actor) === role || signalled.has(role)) return
  const who = e.actor || 'beads'
  const title = clip(e.issue?.title, 80)
  if (e.op === 'comment' && e.comment) {
    const reason = (n) => `${e.comment.author} commented${n ? ` #${n}` : ''} on ${e.issue_id} "${title}": "${clip(e.comment.text, 400)}"`
    note(role, e.issue_id, reason(0), byLead)
    // Number the comment as the board shows it (#n = position in the thread), so leads can answer "re #n".
    bd(`/v0/beads/issues/${encodeURIComponent(e.issue_id)}?include_comments=true`)
      .then((i) => { const n = (i.comments || []).findIndex((c) => c.id === e.comment.id) + 1; if (n && pending[role].has(e.issue_id)) note(role, e.issue_id, reason(n), byLead) })
      .catch(() => {})
  } else if (['create', 'update', 'reopen'].includes(e.op) && ['open', 'in_progress'].includes(e.issue?.status)) {
    note(role, e.issue_id, `${who} ${e.op === 'create' ? 'created' : e.op === 'reopen' ? 'reopened' : 'changed'} ${e.issue_id} "${title}" (now ${e.issue.status})`, byLead)
  }
}

// On start: anything already waiting on a lead (ready items, unanswered human comments) counts as a reason.
// Every item on the board (all pages).
async function allIssues() {
  const all = new Map(); let cursor = ''
  for (let page = 0; page < 40; page++) {
    const r = await bd(`/v0/beads/issues?limit=500${cursor ? `&cursor=${encodeURIComponent(cursor)}` : ''}`)
    for (const i of r.items || []) all.set(i.id, i)
    cursor = r.has_more && r.next_cursor ? r.next_cursor : ''
    if (!cursor) break
  }
  return [...all.values()]
}
async function catchUp() {
  const [open, ready, ev] = await Promise.all([allIssues(), bd('/v0/beads/ready?limit=500'), bd('/v0/beads/events?since=0&limit=500')])
  const last = {}
  for (const e of ev.records || []) if (e.op === 'comment' && e.comment) last[e.issue_id] = e.comment.author
  for (const i of open) seen.set(i.id, { assignee: i.assignee || '', status: i.status })
  for (const i of ready.items || []) note(i.assignee, i.id, `${i.id} "${clip(i.title, 80)}" is ready and nobody has picked it up`)
  for (const i of open) {
    if (last[i.id] && !ROLES.includes(last[i.id])) note(i.assignee, i.id, `${i.id} "${clip(i.title, 80)}" has an unanswered comment from ${last[i.id]}`)
  }
  return ev.head || 0
}

async function lead(role) {
  return (await P_.list({ project: PROJECT, role }))[0] || null
}

async function tick() {
  loadRoles()
  for (const role of ROLES) {
    const reasons = pending[role]
    if (!reasons.size) continue
    let a
    try { a = await lead(role) } catch (e) { log('paseo ls failed:', e.message); return }
    // Offline (the board shows it) or busy: keep the reasons. Idle must be seen on two ticks in a row, so a lead
    // that is just starting (briefly idle before its first turn) is never interrupted.
    const idle = !!a && a.status === 'idle'
    const steady = idle && idleSeen[role] === a.id
    idleSeen[role] = idle ? a.id : null
    if (!steady) continue
    const msg = [`Board update for the ${role} lead (${PROJECT}):`, ...[...reasons.values()].map((r) => `- ${r.reason}`),
      '', 'Follow your role brief: pick up, answer every human comment on the item, then end your turn.'].join('\n')
    const items = [...reasons.keys()], batch = new Map(reasons)
    reasons.clear()
    try {
      await span('wake lead', { role, agent: a.id, items: items.join(' '), via: P_.via() }, () => P_.send(a.id, msg))
      count('mm_wake_sent_total', { role })
      for (const [id, r] of batch) if (r.byLead) hops.set(id, (hops.get(id) || 0) + 1) // a lead-to-lead wake, sent
      // For the board's "who is working on what": the items this lead was just woken for.
      editState((st) => { st[role] = { items, at: new Date().toISOString(), agent: a.id } })
      delete idleFrom[role] // it has a turn now
      log(`woke ${role} (${a.shortId || a.id}) with ${msg.split('\n').length - 3} reason(s)`)
    } catch (e) {
      for (const [id, r] of batch) if (!reasons.has(id)) reasons.set(id, r) // not sent: keep them for the next idle tick
      log(`send to ${role} failed (reasons kept):`, e.message)
    }
  }
}

// Leads on demand (sy-6ym, sy-670, sy-809m). A role whose lead has no agent, or a closed one (after a machine or Paseo
// restart a lead shows `closed` and is never idle, so tick() never reaches it), is started with bin/lead start when work
// waits for it: reasons, or items of its own in progress or blocked. bin/lead start, not a Paseo resume: a resumed agent
// has none of the env bin/lead gives (its board actor, its own Claude folder); it archives the old one (one agent per
// role), and the new lead's first prompt lists its items in progress and blocked (the handover, sy-8n1). The reasons
// stay pending, and tick() sends them once the new lead is idle.
// A lead idle for WAKE_IDLE_CLOSE_MS (default 30 min; 0 = never) with nothing of its own open is closed (archived, as
// bin/lead stop does, but never mid-turn), and the next request starts it again here. A kept role (roles.json `keep`)
// is neither closed nor started: when its agent is closed or gone and work waits, the human is asked (needs-you).
const RESUME_CHECK = Number(process.env.WAKE_RESUME_CHECK_MS || 60000), RESUME_GAP = Number(process.env.WAKE_RESUME_MS || 600000)
const IDLE_CLOSE = Number(process.env.WAKE_IDLE_CLOSE_MS ?? 1800000)
const startedAt = {} // role -> when wake last started its lead (the rate limit)
const startFailed = {} // role -> the failure already said on its items (once per run of failures)
const idleFrom = {} // role -> { id, at }: since when wake has seen that agent idle
let heldSaid = false
const keptSaid = {} // kept role -> the items already labelled needs-you for it (until its agent is up again)

// The project's restore hold (mm restore, until `mm restore --release`): no lead starts. mm doesn't run wake while it
// holds, so this is the second guard, for a hold set while wake runs.
function held() {
  try { return /^restore:[ \t]*\n(?:[ \t]+.*\n)*?[ \t]+hold:[ \t]*true\b/m.test(fs.readFileSync(path.join(dirs().mm, 'config.yaml'), 'utf8')) } catch { return false }
}
function editState(fn) {
  const f = path.join(P, '.wake-state.json')
  try { const st = (() => { try { return JSON.parse(fs.readFileSync(f, 'utf8')) } catch { return {} } })(); fn(st); fs.writeFileSync(f, JSON.stringify(st)) } catch {}
}
const leadStart = (role) => new Promise((ok, no) => execFile(path.join(P, 'bin', 'lead'), ['start', role], { cwd: P, timeout: 180000 },
  (e, out, err) => (e ? no(new Error(String(err || e.message).trim().slice(0, 300))) : ok(out))))

/** The one way wake starts a lead (a queue dispatcher can call it too): for `role`, because of `items` (ids) and `why`;
 *  `was` = the closed agent it replaces, if any. Checks the restore hold and the rate limit (once per WAKE_RESUME_MS per
 *  role); counts and logs; a failed start is kept for the board's Leads page and said once on the waiting items.
 *  A kept role (roles.json `keep`) is never started: its waiting items are labelled needs-you instead (once each).
 *  Resolves to { started: true } or { started: false, why: 'kept' | 'held' | 'rate' | 'failed', error? }. */
async function startLead(role, { was = null, items = [], why = '' } = {}) {
  if (KEEP.has(role)) {
    const said = (keptSaid[role] ||= new Set()), fresh = [...new Set(items)].filter((id) => !said.has(id))
    if (fresh.length) {
      log(`${role} is kept (the owner's contact): its agent is ${was ? `closed (${was.shortId || was.id})` : 'gone'} and work waits (${why}); not starting a new one, labelling needs-you: ${fresh.join(' ')}`)
      count('mm_wake_kept_waits_total', { role })
      for (const id of fresh) { said.add(id); bdRun(['label', 'add', id, 'needs-you'], `label ${id}`) }
    }
    return { started: false, why: 'kept' }
  }
  if (held()) {
    if (!heldSaid) { heldSaid = true; log(`restore hold on: not starting leads (${role} waits: ${why})`) }
    return { started: false, why: 'held' }
  }
  heldSaid = false
  if (Date.now() - (startedAt[role] || 0) < RESUME_GAP) return { started: false, why: 'rate' }
  startedAt[role] = Date.now()
  try {
    await span(was ? 'wake resume' : 'wake start', { role, agent: was?.id || 'none', items: items.join(' '), via: 'bin/lead start' }, () => leadStart(role))
    count(was ? 'mm_wake_resumed_total' : 'mm_wake_started_total', { role })
    log(was ? `restarted ${role} (was ${was.shortId || was.id}, closed): ${why}` : `started ${role} (no agent): ${why}`)
    delete startFailed[role]; delete idleFrom[role]
    editState((st) => { st[role] = { ...(st[role] || {}), started: new Date().toISOString() }; delete st[role].startError; delete st[role].closed })
    return { started: true }
  } catch (e) {
    delete startedAt[role] // not started: try again at the next check
    count('mm_wake_start_failed_total', { role })
    log(`${was ? 'restart' : 'start'} of ${role} failed (reasons kept):`, e.message)
    editState((st) => { st[role] = { ...(st[role] || {}), startError: { error: e.message, items, at: new Date().toISOString() } } })
    if (!startFailed[role]) {
      startFailed[role] = true
      for (const id of [...new Set(items)].slice(0, 5)) bdRun(['comments', 'add', id, `Error: wake could not start the ${role} lead for this item: ${clip(e.message, 300)}. It tries again every ${Math.round(RESUME_CHECK / 1000)} s; nothing waiting is lost.`], `comment ${id}`)
    }
    return { started: false, why: 'failed', error: e.message }
  }
}

// A lead with nothing to do for IDLE_CLOSE is closed: idle all that time (as wake saw it, and by Paseo's own last change
// when it gives one), no reason waiting, and no item of its own in progress, blocked or labelled needs-you. A plain
// `paseo archive` (no --force) refuses an agent in a turn, so a lead is never cut off.
async function closeIdle(role, a, own) {
  if (KEEP.has(role)) { delete idleFrom[role]; return } // the owner's contact stays, idle or not
  if (!IDLE_CLOSE || a.status !== 'idle') { if (a.status !== 'idle') delete idleFrom[role]; return }
  if (idleFrom[role]?.id !== a.id) idleFrom[role] = { id: a.id, at: Date.now() }
  const since = Math.max(idleFrom[role].at, Date.parse(a.updated || '') || 0)
  if (Date.now() - since < IDLE_CLOSE || pending[role].size) return
  const busy = (await own()).find((i) => i.status === 'in_progress' || i.status === 'blocked' || (i.labels || []).includes('needs-you'))
  if (busy) return
  const b = await lead(role) // a fresh look, right before
  if (!b || b.id !== a.id || b.status !== 'idle' || pending[role].size) { delete idleFrom[role]; return }
  try {
    await new Promise((ok, no) => execFile(process.env.PASEO_BIN || 'paseo', ['archive', a.id], { timeout: 30000 }, (e, out, err) => (e ? no(new Error(String(err || e.message).trim().slice(0, 300))) : ok(out))))
    count('mm_wake_idle_closed_total', { role })
    log(`closed ${role} (${a.shortId || a.id}): idle ${Math.round((Date.now() - since) / 60000)} min with nothing of its own open; the next request starts it again`)
    delete idleFrom[role]; delete idleSeen[role]
    editState((st) => { st[role] = { ...(st[role] || {}), closed: { at: new Date().toISOString(), why: 'idle' } } })
  } catch (e) { log(`idle close of ${role} failed (left running):`, e.message) }
}

let checking = false // one check at a time: two overlapping checks would both see "not started yet" and start twice
async function ensureLeads() {
  if (checking) return
  checking = true
  try { await ensureLeads1() } finally { checking = false }
}
async function ensureLeads1() {
  loadRoles()
  let open = null
  const items = async () => (open ||= await bd('/v0/beads/issues?limit=500')).items || []
  for (const role of ROLES) {
    let a
    try { a = await lead(role) } catch (e) { log('paseo ls failed:', e.message); return }
    const own = async () => (await items()).filter((i) => i.assignee === role && i.status !== 'closed')
    if (a && a.status !== 'closed') { delete keptSaid[role]; await closeIdle(role, a, own); continue }
    if (Date.now() - (startedAt[role] || 0) < RESUME_GAP) continue
    const reasons = pending[role]
    const mine = (await own()).filter((i) => i.status === 'in_progress' || i.status === 'blocked')
    if (!reasons.size && !mine.length) continue
    await startLead(role, { was: a, items: [...reasons.keys(), ...mine.map((i) => i.id)],
      why: `${reasons.size} reason(s) wait for it, ${mine.length} item(s) in its handover` })
  }
}

// The event stream can hang without an error (the connection stays open, nothing more arrives). So a poll checks it:
// if the board has events past the last one the stream delivered, for longer than STALL_MS, the stream is stalled:
// the poll delivers them (catch-up), logs an error (mm obs and the system's sentinel see it) and the stream reconnects.
const STALL_MS = Number(process.env.WAKE_STALL_MS || 90000), CHECK_MS = Number(process.env.WAKE_CHECK_MS || 30000)
let since = 0, stream = null, behind = 0
const STATE = path.join(P, '.wake-state.json')
let saveT = null
const saveSeq = () => { saveT ||= setTimeout(() => { saveT = null; try { const st = (() => { try { return JSON.parse(fs.readFileSync(STATE, 'utf8')) } catch { return {} } })(); st._seq = since; fs.writeFileSync(STATE, JSON.stringify(st)) } catch {} }, 2000) }
const deliver = (e) => { if (!e || (e.seq || 0) <= since) return; since = e.seq; onEvent(e); saveSeq() } // each event once, in order

async function check() {
  const r = await fetch(new URL(`/v0/beads/events?since=${since}&limit=500`, BD), { minMs: 1000 }).then((x) => x.json())
  const missed = (r.records || []).filter((e) => (e.seq || 0) > since)
  if (!missed.length) { behind = 0; return }
  if (!behind) { behind = Date.now(); return } // may still be on its way through the stream
  if (Date.now() - behind < STALL_MS) return
  olog('error', `stream stalled: ${missed.length} event(s) not delivered for ${Math.round((Date.now() - behind) / 1000)}s (from seq ${since}); caught up by polling, reconnecting`,
    { op: 'wake stall', missed: missed.length, since })
  count('mm_wake_stalls_total', {})
  for (const e of missed) deliver(e)
  behind = 0
  stream?.abort('stalled')
}

async function watch() {
  for (;;) {
    const ac = (stream = new AbortController())
    try {
      const r = await fetch(new URL(`/v0/beads/events:watch?since=${since}`, BD), { headers: { accept: 'text/event-stream' }, signal: ac.signal })
      const dec = new TextDecoder()
      let buf = ''
      for await (const chunk of r.body) {
        buf += dec.decode(chunk, { stream: true })
        let i
        while ((i = buf.indexOf('\n\n')) >= 0) {
          const frame = buf.slice(0, i); buf = buf.slice(i + 2)
          const data = frame.split('\n').filter((l) => l.startsWith('data:')).map((l) => l.slice(5).trim()).join('\n')
          if (!data) continue
          try { deliver(JSON.parse(data)) } catch {}
        }
      }
      if (!ac.signal.aborted) log(`stream ended; reconnecting from seq ${since}`)
    } catch (e) { if (!ac.signal.aborted) log('stream error:', e.message) }
    if (ac.signal.aborted) log(`stream reconnecting from seq ${since} (${ac.signal.reason || 'aborted'})`)
    await new Promise((r) => setTimeout(r, ac.signal.aborted ? 200 : 3000))
  }
}

since = await catchUp()
// events after the last one this wake delivered before it stopped (a restart, a crash): replay them, so none is lost
const saved = (() => { try { return Number(JSON.parse(fs.readFileSync(STATE, 'utf8'))._seq) || 0 } catch { return 0 } })()
if (saved && saved < since) {
  const head = since; since = saved
  try {
    const r = await fetch(new URL(`/v0/beads/events?since=${saved}&limit=500`, BD)).then((x) => x.json())
    const missed = (r.records || []).filter((e) => (e.seq || 0) > saved && (e.seq || 0) <= head)
    // `seen` holds the board as it is now, not as it was before these: an item's first replayed change is not read as a
    // transition (its later ones are); what it left waiting is in the role's queue, which the lead check reads
    for (const e of missed) seen.delete(e.issue_id)
    for (const e of missed) deliver(e)
    if (missed.length) log(`replayed ${missed.length} event(s) from seq ${saved} (missed while stopped)`)
  } catch (e) { log('replay failed:', e.message) }
  since = Math.max(since, head)
}
saveSeq()
log(`wake for ${PROJECT}: watching ${BD.href} from seq ${since} (stall check every ${CHECK_MS / 1000}s, after ${STALL_MS / 1000}s)`)
setInterval(() => tick().catch((e) => log('tick:', e.message)), EVERY)
setInterval(() => check().catch((e) => log('stream check failed:', e.message)), CHECK_MS)
// the first look soon after start (wake itself restarts with the machine), then every RESUME_CHECK
setTimeout(() => ensureLeads().catch((e) => log('lead check:', e.message)), Math.min(10000, RESUME_CHECK))
setInterval(() => ensureLeads().catch((e) => log('lead check:', e.message)), RESUME_CHECK)
watch()
