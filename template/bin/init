#!/bin/sh
# init — create this project's control/ (the Beads board database) from zero. Run once, before the services start.
#   bin/init <prefix>     e.g. bin/init ab   (item ids become ab-xxx)
# Steps:
#   1. tools/bd and tools/dolt must match tools.json (installed_sha256)
#   2. control/ = a git repo (repo-local identity), with project-local config dirs (.config, .dolt-root, .dolt, .run)
#   3. bd init --server: Beads in Dolt server mode (database = <prefix>), stealth, no git hooks and no agent files;
#      its output in .run/init-bd.log, tried once more from zero when it fails (sy-92ch)
#      (--skip-hooks --skip-agents), maintainer role; then bin/bd-quiet: no-hooks, no-git-ops (sy-8s1; metrics are off in bin/bd)
#   4. events-journal on: the board's live stream and wake read /v0/beads/events
#   5. stop the Dolt server bd started for init; from now on the process manager runs it (services.json: dolt, which
#      listens on {root}/.dolt/mysql.sock, so bd clients use the socket)
#   6. first commit in control/
# Refuses if control/.beads exists.
[ "${MM_TRACE_SELF:-}" = "$0" ] || MM_TRACE_SELF=$0 exec "$(dirname "$(readlink -f "$0")")/trace" init -- "$0" "$@"
set -eu
P=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
PREFIX=${1:?usage: bin/init <prefix>}
case "$PREFIX" in *[!a-z0-9]*|'') echo "init: prefix must be a-z0-9" >&2; exit 2;; esac
[ ! -e "$P/control/.beads" ] || { echo "init: $P/control/.beads exists; nothing to do" >&2; exit 1; }

# 1. tools
for t in bd dolt; do
  want=$(node -e "const j=require('$P/tools.json');process.stdout.write(j['$t']['linux-x64'].installed_sha256)")
  have=$(sha256sum "$P/tools/$t" 2>/dev/null | cut -d' ' -f1)
  [ "$have" = "$want" ] || { echo "init: tools/$t missing or not the version in tools.json (want $want)" >&2; exit 1; }
done

# 2. folders + control repo
mkdir -p "$P/control" "$P/.config" "$P/.dolt-root" "$P/.dolt" "$P/.run"
chmod 700 "$P/.config" "$P/.dolt-root"
git -C "$P/control" init -q -b main
git -C "$P/control" config user.name "$(basename "$P")"
git -C "$P/control" config user.email "board@$(basename "$P").local"

# 3. Beads, server mode (bd starts a temporary Dolt server for this: the one time bin/bd may, sy-a0ac; bd-quiet
#    below then turns that off for good)
cd "$P/control"
export BEADS_DOLT_AUTO_START=1
# HOME is the project's own here (sy-nsnp): before control/.beads/config.yaml exists, bd init saves what --stealth sets
# (no-git-ops) into the user's ~/.config/bd/config.yaml when there is one; with this HOME there is none to find
# Its temporary Dolt listens on a port bd derives from the path, inside the kernel's ephemeral range: on a busy machine
# an outgoing connection can hold that port for a moment, and bd init fails (sy-92ch, twice while other boards were being
# made). So its whole output is kept, and it is tried once more, from zero (control/.beads did not exist before: above).
# bd waits 10 s for that Dolt to answer; a fresh Dolt on a loaded machine (another board being made, a build) can take
# longer, and bd init then fails although nothing is wrong (sy-92ch: again with the retry, while a second project was made
# in a container, so with no port shared). bd's own knob for slow hardware gives it 60 s; the caller's value wins.
export BEADS_DOLT_READY_TIMEOUT="${BEADS_DOLT_READY_TIMEOUT:-60}"
log="$P/.run/init-bd.log"; try=1
until HOME="$P/.config" "$P/bin/bd" init --quiet --stealth --skip-hooks --skip-agents --server --prefix "$PREFIX" --non-interactive --role maintainer >"$log" 2>&1; do
  [ "$try" -lt 2 ] || { echo "init: bd init failed twice; its output ($log):" >&2; tail -n 20 "$log" >&2; exit 1; }
  echo "init: bd init failed once (its output: $log); trying again from zero in 5 s" >&2
  cp "$log" "$log.1"; "$P/bin/bd" dolt stop >/dev/null 2>&1 || true
  rm -rf "$P/control/.beads"; sleep "${INIT_RETRY_WAIT:-5}"; try=$((try + 1))
done

# 4. live event stream for the board and wake
"$P/bin/bd" config set events-journal true >/dev/null

# 4b. bd stays quiet: no git hooks, no git operations of its own (the owner, sy-8s1), no Dolt of its own
#     (dolt.auto-start false, sy-a0ac); metrics are off in bin/bd (sy-nsnp)
"$P/bin/bd-quiet" >/dev/null

# 5. hand Dolt over to the process manager
"$P/bin/bd" dolt stop >/dev/null 2>&1 || true

# 6. first commit
git -C "$P/control" add -A
git -C "$P/control" commit -q --allow-empty -m "init: Beads (server mode, prefix $PREFIX, events journal on; .beads is kept by Dolt, not git)"
echo "init: control/ ready (prefix $PREFIX). Start the services (services.json); bd talks to Dolt via $P/.dolt/mysql.sock."
