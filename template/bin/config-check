#!/usr/bin/env node
// config-check — the governance rules, as code. Run by the setup agent and by the config repo's pre-commit hook.
//   config-check            check the working tree
//   config-check --staged   also refuse staged changes to setup/ and governance.json (humans only)
//   config-check --render   first write each .claude/settings.json from its settings.tmpl.json
// Permission templates are written relative to the project root: `{root}` = this folder, `{home}` = $HOME, `{project}` = its name,
// `{url:<service>}` = that service's URL at runtime. Read/Edit/Write
// rules get Claude Code's `//` absolute prefix when rendered. The rendered settings.json files are generated (git-ignored).
// Exit 1 with reasons if any rule is broken.
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'

const P = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const R = P
const problems = []
const bad = (m) => problems.push(m)
import os from 'node:os'
import { dirs, projectName, svcUrl } from './lib/svc.mjs'
import { cli } from './lib/obs.mjs'
cli('config-check')
const HOME = process.env.HOME || os.homedir()
// Every agent here, leads and setup, in every profile: no SSH keys (whatever they are named, the user's or root's), and
// no filling machine or project inputs (a human's step: it never shows a value, but it can replace one).
// bd stays quiet (the owner, sy-8s1): no agent installs bd's git hooks, runs its setup or init, or turns hooks, metrics
// or its git operations back on, whichever way it calls bd.
const BD_QUIET = ['bd', 'bin/bd', 'tools/bd'].flatMap((b) => ['hooks', 'setup', 'init', 'config set no-hooks', 'config set metrics', 'config set no-git-ops'].map((c) => `Bash(${b} ${c}*)`))
// The pull model (plans/slp): a lead claims with `bd update <id> --claim` (atomic) and hands over with the compare-and-set
// guards (--if-assignee/--if-status), never by a raw edit. Refused: setting in_progress by hand, and `bd assign` (a
// reassign with no guard). `-a` without a guard cannot be told apart by a rule; the brief and bd's guard cover it.
const RAW_STATUS = ['bd', 'bin/bd'].flatMap((b) => [`Bash(${b} update *--status in_progress*)`, `Bash(${b} update *--status=in_progress*)`,
  `Bash(${b} update *-s in_progress*)`, `Bash(${b} assign *)`])
// Access is the owner's (review sy-b15.13): no agent makes people, sign-in links, grants or tokens, talks to the
// gateway's socket, or reads its store or a box's Paseo password. `mm revoke` stays free (it only takes access away).
// The same for spending (sy-b15.10): no agent sets an AI budget, or reads or edits the AI gateway's store (its keys'
// hashes, budgets, use) or the machine's upstream key.
// And what a box gets (sy-b15.8): no agent decides a project API request (mm api approve|deny|undo), talks to its
// owner socket, or reads or edits its store (requests, grants).
// mm's folder, as the host knows it: MM_HOME (mm sets it for what it runs) and the default, never .run/endpoints.json's
// "dirs" (the project's to write, a box's too: review sy-v92 2). Each deny below names every one of them.
const MMS = [...new Set([process.env.MM_HOME, `${HOME}/.mm`].filter((x) => x && x.startsWith('/')))]
const OWNER_ONLY = ['Bash(mm user*)', 'Bash(mm grant*)', 'Bash(mm token*)', 'Bash(mm auth*)', 'Bash(*auth.sock*)',
  'Bash(mm ai budget*)', 'Bash(*ai.sock*)', 'Bash(mm api*)', 'Bash(*approve.sock*)',
  ...MMS.flatMap((m) => ['auth', 'paseo', 'ai', 'api'].flatMap((d) => [`Read(/${m}/${d}/**)`, `Edit(/${m}/${d}/**)`])),
  ...MMS.map((m) => `Bash(*${m}/api/*)`),
  `Read(/${HOME}/.config/secrets/ai-upstream.key)`, `Edit(/${HOME}/.config/secrets/ai-upstream.key)`,
  // the vault's opener and its key maker (review sy-uvgq): `vault run` opens any project's secrets and runs any command
  // without naming a path; `vault init` would replace the machine's key. The leading * catches ~/.mm/bin/mm, env … mm,
  // timeout … mm. `mm vault ls|check` stay free.
  'Bash(*mm vault run*)', 'Bash(*mm vault init*)']
// The machine's secrets (review sy-5ag): every path mm lists in <mm>/secret-paths.json (each secret input's file and
// folder in the manifest, Paseo's home, Claude's login), so a new input is covered without a template change. That
// file is the host's: mm writes it outside every project, a box never sees it, and no role may change it (review
// sy-v92 2). Always joined with a fixed list (the brain's keys in either layout among them), so a missing or emptied
// list can add paths but never take one away (review sy-v92 1). Read and Edit, and any Bash command that names one
// (absolute, ~ or $HOME form).
// The vault (sy-uvgq): its folder (the machine key `key`, the recipients, the sealed files) and where opened secrets
// live while services run (a tmpfs: /run/user/<uid>/mm/secrets, or $XDG_RUNTIME_DIR/mm/secrets). Both layouts' vault
// folder, mm's own as the host knows it (MMS), and the run file's (dirs(): it can only add one).
const UID = process.getuid?.() ?? 0, XDG = process.env.XDG_RUNTIME_DIR
const VAULTS = [...new Set([...MMS.map((m) => `${m}/vault`), `${HOME}/.mm/vault`, dirs().vault])]
const OPENED = [...new Set([`/run/user/${UID}/mm/secrets`, ...(XDG ? [`${XDG}/mm/secrets`] : [])])]
// mm's own Paseo folder: each box's daemon password (`<project>.password`, made by mm, 0600; review sy-b15.2 #7). Here, so
// it gets the Bash forms too, not only Read and Edit (OWNER_ONLY has those).
const MM_PASEO = [...new Set([...MMS.map((m) => `${m}/paseo`), `${HOME}/.mm/paseo`])]
const MS_FIXED = { files: [`${HOME}/.claude/.credentials.json`],
  dirs: [`${HOME}/.mm/brain/.keys`, `${HOME}/brain/.keys`, `${HOME}/.config/secrets`, `${HOME}/.paseo`, `${HOME}/.ssh`, ...VAULTS, ...OPENED, ...MM_PASEO] }
// spellings the absolute, ~ and $HOME forms don't catch: the variable forms of the tmpfs, and the key by its own name
const VAULT_BASH = ['Bash(*vault/key*)', 'Bash(*$XDG_RUNTIME_DIR/mm/secrets*)', 'Bash(*${XDG_RUNTIME_DIR}/mm/secrets*)', 'Bash(*$MM_HOME/vault*)', 'Bash(*${MM_HOME}/vault*)']
const MS_FILES = MMS.map((m) => `${m}/secret-paths.json`)
const MS_HOST = MS_FILES.map((f) => { try { return JSON.parse(fs.readFileSync(f, 'utf8')) || {} } catch { return {} } })
const strs = (v) => (Array.isArray(v) ? v.filter((x) => typeof x === 'string' && x.startsWith('/')) : [])
const MS = { files: [...new Set([...MS_FIXED.files, ...MS_HOST.flatMap((h) => strs(h.files))])], dirs: [...new Set([...MS_FIXED.dirs, ...MS_HOST.flatMap((h) => strs(h.dirs))])] }
const named = (p) => [p, ...(p.startsWith(`${HOME}/`) ? [`~${p.slice(HOME.length)}`, `$HOME${p.slice(HOME.length)}`] : [])].map((x) => `Bash(*${x}*)`)
const SECRET_DENY = [...(MS.files || []).flatMap((f) => [`Read(/${f})`, `Edit(/${f})`, ...named(f)]),
  ...(MS.dirs || []).flatMap((d) => [`Read(/${d}/**)`, `Edit(/${d}/**)`, ...named(d)]), ...VAULT_BASH,
  ...MS_FILES.flatMap((f) => [`Edit(/${f})`, `Write(/${f})`, ...named(f)])]
// The project's own secrets (Doop's account, agent key and auth secret among them; plans/doop.md): no Bash command that
// names them, and no running the helper that prints the Doop key (only Claude Code runs it, as the MCP's headersHelper)
// (review sy-7452 2): the folder in every spelling a lead's command can name it by, from its own folder, a worktree or
// the project root (absolute, ~ and $HOME, ./secrets and ../../secrets, secrets/...), and every other project's secrets
// too, wherever the projects are (mm's folder, the older layout, and what the run file says: each only adds denies)
const PROJECTS = [...new Set([...MMS.map((m) => `${m}/projects`), `${HOME}/projects`, dirs().projects].filter((x) => x && x.startsWith('/')))]
const PROJECT_SECRETS = [...named(`${R}/secrets`), 'Bash(*./secrets*)', 'Bash(* secrets/*)', 'Bash(*secrets/doop*)', 'Bash(*doop-mcp-headers*)', 'Edit(/{root}/secrets/**)',
  ...PROJECTS.flatMap((d) => [...named(`${d}/*/secrets`), ...['*', '*/*'].flatMap((x) => [`Read(/${d}/${x}/secrets/**)`, `Edit(/${d}/${x}/secrets/**)`])])]
const ALWAYS_DENY = [`Read(/${HOME}/.ssh/**)`, 'Read(//root/.ssh/**)', 'Bash(mm fill*)', ...BD_QUIET, ...OWNER_ONLY, ...SECRET_DENY, ...PROJECT_SECRETS]
// Assistants (assistants/<user>/, system profile): no tool that acts or reads on its own (bin/lib/assist.mjs); a tool
// that is not allowed is refused without asking (defaultMode dontAsk), so no permission request ever reaches a
// human's phone from an assistant.
import { ALLOW_RULES as ASSIST_ALLOW, DENY as ASSIST_DENY } from './lib/assist.mjs'
// Roles: leads/roles.json is the list; every role has a folder and every folder a role.
let DEF = []
try { DEF = JSON.parse(fs.readFileSync(path.join(P, 'leads', 'roles.json'), 'utf8')).roles || [] } catch (e) { problems.push(`leads/roles.json unreadable (${e.message})`) }
const ROLES = DEF.map((r) => r.id)
const WORKERS = new Set(DEF.filter((r) => r.workers).map((r) => r.id))
for (const r of DEF) {
  if (!/^[a-z][a-z0-9-]{1,23}$/.test(r.id) || !/^[A-Z]$/.test(r.initial || '') || !r.title || !/^#[0-9a-fA-F]{6}$/.test(r.color || '')) problems.push(`roles.json: bad entry ${JSON.stringify(r)}`)
  if (!fs.existsSync(path.join(P, 'leads', r.id))) problems.push(`roles.json lists ${r.id} but leads/${r.id}/ is missing`)
  if (r.capacity !== undefined && !(Number.isInteger(r.capacity) && r.capacity >= 1)) problems.push(`roles.json: ${r.id}'s capacity must be a whole number, 1 or more (items it holds in progress at once)`)
}
for (const d of fs.readdirSync(path.join(P, 'leads'), { withFileTypes: true })) if (d.isDirectory() && !ROLES.includes(d.name)) problems.push(`leads/${d.name}/ is not in roles.json`)

/** Template → Claude Code settings: substitute {root}/{home}; make Read/Edit/Write paths absolute (`//…`). */
// Optional governance.json (humans only, like setup/): a stricter or wider profile than the default, as data.
//   read: [path]          extra roots any lead may Read      write: {role: [path]}  extra roots that role may Edit/Write
//   deny_all: [rule]      denies every role must keep        bash_ok: [regex]       allow rules exempt from the forbidden list
//   hooks_required: [cmd] PreToolUse hook commands every role's settings must run
// Paths and rules use {home}/{root}; Read/Edit/Write rules get Claude Code's // prefix like the templates.
let G = {}
try { G = JSON.parse(fs.readFileSync(path.join(P, 'governance.json'), 'utf8')) } catch (e) { if (fs.existsSync(path.join(P, 'governance.json'))) bad(`governance.json unreadable (${e.message})`) }
// {brain} {projects} {mm}: the machine's folders, from mm (one-root boxes keep them under $MM_HOME)
const D = dirs()
// the folders ahead of /usr/bin in a lead's PATH (review sy-jm5 2): mm's from what the host knows (a run file that names
// another folder is not followed), and no role may write a file into any of them, so nothing there shadows git or bd
const MM_DIR = MMS.includes(D.mm) ? D.mm : MMS[0]
const PATH_FIRST = [path.join(P, 'bin'), path.join(MM_DIR, 'bin'), path.join(MM_DIR, 'npm', 'bin'), `${HOME}/.local/bin`, `${HOME}/.npm-global/bin`]
// a project has no business in the brain (review sy-5ag): all of it is denied to every board except the system board,
// whose review audits it and whose ops runs it (sy-qlkl). The system board is the one whose answers say
// `profile: system` and that is not a box (the answers are read-only in a box), or the one inside the brain (the old
// layout). The brain's keys stay denied to every board, the system board too (the fixed list above). Either layout.
const BRAINS = [...new Set([D.brain, `${HOME}/.mm/brain`, `${HOME}/brain`])]
const ANSWERS = (() => { try { return fs.readFileSync(path.join(P, '.mm-answers.yaml'), 'utf8') } catch { return '' } })()
const SYSTEM_BOARD = (/^profile:\s*["']?system["']?\s*$/m.test(ANSWERS) && !/^box:\s*true\s*$/m.test(ANSWERS)) || BRAINS.some((b) => (P + '/').startsWith(b + '/'))
const BRAIN_DENY = SYSTEM_BOARD ? [] : BRAINS.flatMap((b) => [`Read(/${b}/**)`, `Edit(/${b}/**)`, ...named(b)])
const gfill =(v) => v.replaceAll('{root}', R).replaceAll('{home}', HOME).replaceAll('{brain}', D.brain).replaceAll('{projects}', D.projects).replaceAll('{mm}', D.mm)
const grule = (r) => { const v = gfill(r); return /^(Read|Edit|Write)\(\//.test(v) ? v.replace(/^(Read|Edit|Write)\(\//, '$1(//') : v }
const G_READ = (G.read || []).map(gfill), G_WRITE = Object.fromEntries(Object.entries(G.write || {}).map(([k, v]) => [k, v.map(gfill)]))
const G_BASH_OK = (G.bash_ok || []).map((x) => new RegExp(x))
// The guard (bin/guard, sy-8t0.5): a PreToolUse hook that denies secret reads in any spelling, sudo, mm's owner-only
// commands and the approval path's files (its rules: bin/lib/guard-rules.mjs). By its absolute path, so no PATH or
// working folder chooses another; on the tools it reads, for every lead and setup.
const GUARD = path.join(P, 'bin', 'guard')
const GUARD_CMD = /^[\w./+-]+$/.test(GUARD) ? GUARD : `'${GUARD.replaceAll("'", "'\\''")}'`
const GUARD_TOOLS = ['Bash', 'Read', 'Edit', 'Write', 'MultiEdit', 'NotebookEdit', 'Grep']
const hasGuard = (h) => (h?.PreToolUse || []).some((e) => typeof e?.matcher === 'string' && GUARD_TOOLS.every((t) => e.matcher.split('|').includes(t))
  && (e.hooks || []).some((x) => x?.type === 'command' && x.command === GUARD_CMD))
function guarded(who, j) {
  if (!hasGuard(j.hooks)) bad(`${who}: settings.json must run the guard hook ${GUARD_CMD} (PreToolUse, matcher ${GUARD_TOOLS.join('|')})`)
  if (j.disableAllHooks) bad(`${who}: disableAllHooks is not allowed (it turns the guard off)`)
}
try { fs.accessSync(GUARD, fs.constants.X_OK) } catch { bad('bin/guard is missing or not executable (the hook every lead and setup runs)') }
function render(tmpl, role, assistant = false) {
  const fill = (v) => gfill(v).replaceAll('{project}', projectName())
    .replace(/\{url:([\w-]+)\}/g, (m, n) => svcUrl(n) || m) // where the process manager put that service
  const rule = (r) => { const m = /^(Read|Edit|Write)\((.*)\)$/.exec(r); const v = fill(r); return m && m[2].startsWith('{') ? v.replace(/^(Read|Edit|Write)\(\//, '$1(//') : v }
  const p = tmpl.permissions || {}
  // governance.json adds its denies and required hooks to every role, so no template can forget one
  let hooks = tmpl.hooks ? JSON.parse(fill(JSON.stringify(tmpl.hooks))) : undefined
  // the guard hook (sy-8t0.5): every lead and setup, first, by this board's own bin/guard; never an assistant's (no hooks)
  if (!assistant && !hasGuard(hooks)) hooks = { ...(hooks || {}), PreToolUse: [{ matcher: GUARD_TOOLS.join('|'), hooks: [{ type: 'command', command: GUARD_CMD, timeout: 10 }] }, ...(hooks?.PreToolUse || [])] }
  for (const h of (G.hooks_required || []).map(gfill)) {
    if (JSON.stringify(hooks?.PreToolUse || []).includes(h)) continue
    hooks = { ...(hooks || {}), PreToolUse: [...(hooks?.PreToolUse || []), { matcher: 'Bash|Read|Edit|Write|MultiEdit|NotebookEdit', hooks: [{ type: 'command', command: h, timeout: 10 }] }] }
  }
  const govDeny = [...ALWAYS_DENY.map(gfill), ...BRAIN_DENY, ...(assistant ? ASSIST_DENY : []), ...(!assistant && role && ROLES.includes(role) ? mandatoryDeny(role) : []), ...(G.deny_all || []).map(grule)] // every safety deny, always
  // who the session is, in the settings themselves (sy-670): a lead that Paseo resumes from `closed` runs without the
  // env bin/lead gave it at start, but Claude Code applies this to every session in this folder, however it started
  const who = assistant ? {} : { env: { ...(tmpl.env || {}), BEADS_ACTOR: role, GIT_AUTHOR_NAME: role, GIT_COMMITTER_NAME: role,
    GIT_AUTHOR_EMAIL: `${role}@${projectName()}.local`, GIT_COMMITTER_EMAIL: `${role}@${projectName()}.local`,
    PATH: [...PATH_FIRST, '/usr/local/bin', '/usr/bin', '/bin'].join(':') } }
  return { ...tmpl, ...who, ...(hooks ? { hooks } : {}), permissions: { ...p,
    ...(p.additionalDirectories ? { additionalDirectories: p.additionalDirectories.map(fill) } : {}),
    // a rule naming a service that doesn't run yet ({url:app} before the first deploy) is left out, not half-rendered
    allow: (p.allow || []).map(rule).filter((r) => !r.includes('{url:')), deny: [...new Set([...(p.deny || []).map(rule), ...govDeny])] } }
}
const ASSIST_ROOT = path.join(P, 'assistants')
const ASSISTANTS = fs.existsSync(ASSIST_ROOT) ? fs.readdirSync(ASSIST_ROOT, { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => d.name) : []
const SETTINGS_DIRS = [...fs.readdirSync(path.join(P, 'leads'), { withFileTypes: true }).filter((d) => d.isDirectory()).map((d) => path.join(P, 'leads', d.name)), path.join(P, 'setup'),
  ...ASSISTANTS.map((u) => path.join(ASSIST_ROOT, u))]
for (const dir of SETTINGS_DIRS) {
  const t = path.join(dir, '.claude', 'settings.tmpl.json')
  if (!fs.existsSync(t)) continue
  let tj
  try { tj = JSON.parse(fs.readFileSync(t, 'utf8')) } catch (e) { bad(`${path.relative(P, t)} is not valid JSON (${e.message})`); continue }
  if (JSON.stringify(tj).includes(R)) bad(`${path.relative(P, t)} hard-codes ${R}; write {root} instead`)
  if (process.argv.includes('--render')) fs.writeFileSync(path.join(dir, '.claude', 'settings.json'), JSON.stringify(render(tj, path.basename(dir), dir.startsWith(`${ASSIST_ROOT}/`)), null, 2) + '\n')
  // a role's MCP servers (.mcp.tmpl.json -> .mcp.json): a server whose {url:<service>} doesn't run here is left out, so
  // e.g. the design lead gets Doop only while the project runs it (mm doop on)
  const mt = path.join(dir, '.mcp.tmpl.json'), mo = path.join(dir, '.mcp.json')
  if (fs.existsSync(mt) && process.argv.includes('--render')) {
    let m; try { m = JSON.parse(fs.readFileSync(mt, 'utf8')) } catch (e) { bad(`${path.relative(P, mt)} is not valid JSON (${e.message})`); continue }
    const fillAll = (v) => gfill(v).replaceAll('{project}', projectName()).replace(/\{url:([\w-]+)\}/g, (x, n) => svcUrl(n) || x)
    const servers = Object.fromEntries(Object.entries(m.mcpServers || {}).map(([k, s]) => [k, JSON.parse(fillAll(JSON.stringify(s)))])
      .filter(([, s]) => !JSON.stringify(s).includes('{url:')))
    // ...and approved in the folder's local settings (Claude Code takes that only from there, in a trusted folder; not
    // from settings.json): exactly the servers just rendered
    const ml = path.join(dir, '.claude', 'settings.local.json'), names = Object.keys(servers)
    if (names.length) {
      fs.writeFileSync(mo, JSON.stringify({ mcpServers: servers }, null, 2) + '\n')
      fs.writeFileSync(ml, JSON.stringify({ enabledMcpjsonServers: names }, null, 2) + '\n')
    } else { fs.rmSync(mo, { force: true }); fs.rmSync(ml, { force: true }) }
  }
}

function mandatoryDeny(role) {
  const d = [`Read(/${R}/secrets/**)`, 'Bash(git push*)', ...RAW_STATUS, `Edit(/${R}/code/**)`, `Write(/${R}/code/**)`,
    `Edit(/${R}/control/**)`, `Write(/${R}/control/**)`, `Edit(/${R}/leads/**)`, `Write(/${R}/leads/**)`,
    `Edit(/${R}/CLAUDE.md)`, `Write(/${R}/CLAUDE.md)`, `Edit(/${R}/worktrees/CLAUDE.md)`, `Write(/${R}/worktrees/CLAUDE.md)`,
    `Edit(/${R}/setup/**)`, `Write(/${R}/setup/**)`, `Edit(/${R}/release/**)`, `Write(/${R}/release/**)`,
    ...PATH_FIRST.flatMap((d) => [`Edit(/${d}/**)`, `Write(/${d}/**)`])]
  if (WORKERS.has(role)) d.push('mcp__paseo__get_agent_activity', `Edit(/${R}/worktrees/**)`, `Write(/${R}/worktrees/**)`)
  d.push(...(G.deny_all || []).map(grule))
  return d
}
// Allow rules that would hand a lead arbitrary execution or reach outside its job. Project facts come from the folder
// and from where the process manager put the app slot (.run/endpoints.json); nothing machine-specific is written here.
const esc = (x) => x.replace(/[.*+?^${}()|[\]\\/]/g, '\\$&')
const NAME = projectName()
const APP_URL = svcUrl('app')
const PREVIEW_DIR = `.local/share/preview/${NAME}-design/`
const FORBIDDEN_ALLOW = [
  /^Bash\(\*\)$/, /^Bash\((ba|z|da)?sh\b/, /^Bash\(sudo\b/, /^Bash\(eval\b/, /^Bash\(exec\b/, /^Bash\(env\b/,
  /^Bash\((python3?|node|perl|ruby|deno|bun) +-(c|e)\b/, /^Bash\(npx\b/, /^Bash\(wget\b/, /^Bash\(ssh\b/,
  /^Bash\((python3?|node|perl|ruby|deno|bun) \*\)$/, /^Bash\(git -C \*\)$/,
  /^Bash\((cp|mv|rm|ln|tee|install|chmod|chown|dd|rsync) \*\)$/, /^Bash\(git push/, /^Bash\(.*--no-verify/,
  // network: only the app slot's URL
  APP_URL ? new RegExp(`^Bash\\(curl\\b(?!.*${esc(APP_URL)}(/|\\*|\\b))`) : /^Bash\(curl\b/,
  // services: never directly; releases go through the deploy gateway
  /^Bash\(systemctl\b/,
  // files: only inside this project, /tmp, and this project's design-preview folder
  new RegExp(`^(Edit|Write|Read)\\(//(?!${esc(R.slice(1))}/|tmp/|${esc(HOME.slice(1))}/${esc(PREVIEW_DIR)})`),
  new RegExp(`^(Edit|Write|Read)\\(~/(?!${esc(PREVIEW_DIR)})`),
]

for (const role of ROLES) {
  const f = path.join(P, 'leads', role, '.claude', 'settings.json')
  if (!fs.existsSync(f)) { bad(`${role}: missing .claude/settings.json`); continue }
  let j
  try { j = JSON.parse(fs.readFileSync(f, 'utf8')) } catch (e) { bad(`${role}: settings.json is not valid JSON (${e.message})`); continue }
  const deny = new Set(j.permissions?.deny || [])
  for (const d of mandatoryDeny(role)) if (!deny.has(d)) bad(`${role}: settings.json lost the safety deny ${d}`)
  const under = (a, roots) => { const m = /^(Read|Edit|Write)\(\/(\/.*)\)$/.exec(a); return !!m && roots.some((r) => m[2].startsWith(r)) }
  const okByGov = (a) => G_BASH_OK.some((re) => re.test(a)) || (/^Read\(/.test(a) && under(a, [...G_READ, ...(G_WRITE[role] || [])])) || (/^(Edit|Write)\(/.test(a) && under(a, G_WRITE[role] || []))
  for (const a of j.permissions?.allow || []) if (FORBIDDEN_ALLOW.some((re) => re.test(a)) && !okByGov(a)) bad(`${role}: forbidden allow rule ${a}`)
  // starting another lead: one exact rule per role (lead start fixes its folder, mode, labels and model), never itself
  for (const a of j.permissions?.allow || []) {
    const ls = /^Bash\(\s*(?:bin\/)?lead\s+start\b(.*)\)$/.exec(a)
    if (!ls) continue
    const target = ls[1].trim()
    if (!/^[a-z][\w-]*$/.test(target) || ![...ROLES, 'setup'].includes(target)) bad(`${role}: ${a}: write one exact rule per role (Bash(lead start <role>)): no wildcard, no options, a real role`)
    else if (target === role) bad(`${role}: ${a}: a lead may not restart itself`)
  }
  // write roots of another role are never allowed (one writer per repo)
  for (const [other, roots] of Object.entries(G_WRITE)) if (other !== role) for (const a of j.permissions?.allow || []) if (/^(Edit|Write)\(/.test(a) && under(a, roots)) bad(`${role}: writes ${other}'s area (${a})`)
  const cmds = JSON.stringify(j.hooks?.PreToolUse || [])
  for (const h of (G.hooks_required || []).map(gfill)) if (!cmds.includes(h)) bad(`${role}: settings.json must run the hook ${h}`)
  guarded(role, j)
  if (j.permissions?.defaultMode === 'bypassPermissions') bad(`${role}: bypassPermissions is not allowed`)
  const sk = path.join(P, 'leads', role, '.claude', 'skills')
  if (fs.existsSync(sk)) for (const name of fs.readdirSync(sk).filter((n) => !n.startsWith('.'))) {
    const md = path.join(sk, name, 'SKILL.md')
    if (!fs.existsSync(md)) { bad(`${role}: skill ${name} has no SKILL.md`); continue }
    const head = /^---\n([\s\S]*?)\n---/.exec(fs.readFileSync(md, 'utf8'))
    if (!head || !/^name:/m.test(head[1]) || !/^description:/m.test(head[1])) bad(`${role}: skill ${name} needs name + description frontmatter`)
  }
  if (!fs.existsSync(path.join(P, 'leads', role, 'CLAUDE.md'))) bad(`${role}: missing role brief CLAUDE.md`)
}
// the setup agent runs the guard too (sy-8t0.5)
if (fs.existsSync(path.join(P, 'setup', '.claude', 'settings.tmpl.json'))) {
  const f = path.join(P, 'setup', '.claude', 'settings.json')
  let j
  try { j = JSON.parse(fs.readFileSync(f, 'utf8')) } catch { bad('setup: missing or invalid .claude/settings.json (config-check --render)') }
  if (j) guarded('setup', j)
}
// Assistants: read-only by permissions, whatever their brief says.
const SYSTEM_NAMES = new Set(['wake', 'watchdog', 'brain', 'ui', 'beads', 'smoke', 'system', 'admin', 'setup', 'guest', 'human'])
for (const u of ASSISTANTS) {
  const dir = path.join(ASSIST_ROOT, u), who = `assistant ${u}`
  if (u !== '_template' && (!/^[a-z][a-z0-9._-]{1,31}$/.test(u) || ROLES.includes(u) || SYSTEM_NAMES.has(u))) bad(`${who}: not a usable person's name (a role or system name, or not a-z0-9._-)`)
  if (!fs.existsSync(path.join(dir, 'CLAUDE.md'))) bad(`${who}: missing CLAUDE.md`)
  let t
  try { t = JSON.parse(fs.readFileSync(path.join(dir, '.claude', 'settings.tmpl.json'), 'utf8')) } catch { bad(`${who}: missing or invalid .claude/settings.tmpl.json`); continue }
  if (t.permissions?.defaultMode !== 'dontAsk') bad(`${who}: permissions.defaultMode must be dontAsk (refuse, never ask)`)
  for (const a of t.permissions?.allow || []) if (!ASSIST_ALLOW.some((re) => re.test(a))) bad(`${who}: allow rule ${a} is not for an assistant (only Skill, and the scoped read tool mcp__mm_read)`)
  if ((t.permissions?.additionalDirectories || []).length) bad(`${who}: no additionalDirectories (an assistant reads nothing on its own)`)
  if (t.hooks) bad(`${who}: hooks are not allowed in an assistant`)
  const f = path.join(dir, '.claude', 'settings.json')
  if (fs.existsSync(f)) { try { const deny = new Set(JSON.parse(fs.readFileSync(f, 'utf8')).permissions?.deny || []); for (const d of ASSIST_DENY) if (!deny.has(d)) bad(`${who}: settings.json lost the deny ${d}`) } catch { bad(`${who}: settings.json is not valid JSON`) } }
  else if (u !== '_template') bad(`${who}: missing .claude/settings.json (config-check --render)`)
}
// Project memory (memory/*.md): each file says what it is (frontmatter name + description, like the brain's) and
// when it was last checked and for how long it holds (verified + ttl_days, required: the owner, sy-0e5). No
// defaults: a default would claim a check nobody made. bin/health reports the ones past their time.
const MEM = path.join(P, 'memory')
for (const f of fs.existsSync(MEM) ? fs.readdirSync(MEM).filter((x) => x.endsWith('.md') && !['MEMORY.md', 'README.md'].includes(x)) : []) {
  const head = /^---\n([\s\S]*?)\n---/.exec(fs.readFileSync(path.join(MEM, f), 'utf8'))
  if (!head || !/^name:\s*\S/m.test(head[1]) || !/^description:\s*\S/m.test(head[1])) { bad(`memory/${f}: needs frontmatter with name and description`); continue }
  const v = /^\s*verified:\s*(\S+)/m.exec(head[1]), t = /^\s*ttl_days:\s*(\S+)/m.exec(head[1])
  if (!v || !t) bad(`memory/${f}: needs verified: <YYYY-MM-DD> and ttl_days: <days> under metadata: (when it was last checked, and how long it holds)`)
  if (v && !/^\d{4}-\d\d-\d\d$/.test(v[1])) bad(`memory/${f}: verified must be a date (YYYY-MM-DD)`)
  if (t && !/^\d+$/.test(t[1])) bad(`memory/${f}: ttl_days must be a number of days`)
}
// Personas: cosmetic, but names must keep their role's initial and colors must be valid.
const pf = path.join(P, 'leads', 'personas.json')
if (fs.existsSync(pf)) {
  try {
    const pj = JSON.parse(fs.readFileSync(pf, 'utf8'))
    const INIT = { ...Object.fromEntries(DEF.map((r) => [r.id, r.initial])), setup: 'S' }
    for (const [role, a] of Object.entries(pj.agents || {})) {
      if (!INIT[role]) { bad(`personas: unknown role ${role}`); continue }
      if (typeof a.name !== 'string' || !a.name.startsWith(INIT[role])) bad(`personas: ${role} name must start with ${INIT[role]}`)
      if (!/^#[0-9a-fA-F]{6}$/.test(a.color || '')) bad(`personas: ${role} color must be #rrggbb`)
      if (a.avatar && [...a.avatar].length > 4) bad(`personas: ${role} avatar too long`)
    }
  } catch (e) { bad(`personas.json is not valid JSON (${e.message})`) }
}
// RACI: exactly one Accountable and at least one Responsible per activity; only known participants.
const rf = path.join(P, 'leads', 'raci.json')
if (fs.existsSync(rf)) {
  try {
    const rj = JSON.parse(fs.readFileSync(rf, 'utf8')); const who = [...ROLES, 'human']
    for (const a of rj.activities || []) {
      const cells = Object.entries(a.raci || {})
      for (const [p, l] of cells) { if (!who.includes(p)) bad(`raci ${a.id}: unknown participant ${p}`); if (!/^[RACI]{1,2}$/.test(l)) bad(`raci ${a.id}: bad letters ${p}=${l}`) }
      const A = cells.filter(([, l]) => l.includes('A')).length
      if (A !== 1) bad(`raci ${a.id}: needs exactly one Accountable (has ${A})`)
      if (!cells.some(([, l]) => l.includes('R'))) bad(`raci ${a.id}: needs at least one Responsible`)
    }
    if (process.argv.includes('--render')) execFileSync(path.join(P, 'bin', 'raci'), ['render'], { cwd: P, stdio: 'ignore' })
  } catch (e) { bad(`raci.json unreadable (${e.message})`) }
}
for (const f of ['CLAUDE.md', 'leads/CLAUDE.md', 'leads/START.md', ...(WORKERS.size ? ['worktrees/CLAUDE.md'] : [])]) if (!fs.existsSync(path.join(P, f))) bad(`missing ${f}`)

if (process.argv.includes('--staged')) {
  const staged = execFileSync('git', ['-C', P, 'diff', '--cached', '--name-only'], { encoding: 'utf8' }).split('\n').filter(Boolean)
  const gov = staged.filter((f) => f.startsWith('setup/') || f === 'governance.json')
  if (gov.length && process.env.SETUP_HUMAN !== '1') bad(`setup/ and governance.json are for humans only (${gov.join(', ')}); a human commits them with SETUP_HUMAN=1`)
  // an assistant's permissions: the owner (a human, SETUP_HUMAN=1) or the setup agent, never the person it serves or a lead
  const ap = staged.filter((f) => /^assistants\/[^/]+\/\.claude\/settings/.test(f) || /^assistants\/[^/]+\/\.claude\/?$/.test(f))
  if (ap.length && process.env.SETUP_HUMAN !== '1' && process.env.GIT_AUTHOR_NAME !== 'setup') bad(`assistant permissions are changed by the owner or setup only (${ap.join(', ')})`)
}

if (problems.length) { console.error(`config-check: ${problems.length} problem(s)\n- ${problems.join('\n- ')}`); process.exit(1) }
console.log(`config-check: ok (${ROLES.length} leads)`)
