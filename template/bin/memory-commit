#!/usr/bin/env node
// memory-commit — the board commits its leads' memory notes by itself (sy-3wn3). memory/ is the project's (memory/README.md):
// every lead's and setup's Claude memory folder is a link to it, so a note a lead saves lands there, and it used to stay
// uncommitted until someone committed it by hand.
//   memory-commit note <role>   a PostToolUse hook (Write|Edit|MultiEdit) of every lead and setup (config-check --render
//                               writes it): when the tool wrote a file of memory/ (through the link too), records that
//                               <role> wrote it, in .run/memory-authors.log. Says nothing, never fails the tool.
//   memory-commit               one pass (bin/wake runs it every WAKE_MEMORY_MS): each memory/*.md that differs from HEAD
//                               (new, changed, removed) is checked (bin/lib/memory.mjs, the rules config-check runs, and
//                               the secret scan, bin/lib/secret-scan.mjs), and the ones that pass are committed: one
//                               commit per role, authored by the role that last wrote the file (else "memory <project>"),
//                               "memory: <role>'s notes (<files>)". A file that fails stays uncommitted and is said once
//                               (on stderr, "memory/<f>: not committed: ..."), again only when its content changes.
// It commits only memory/*.md, whatever else is dirty or staged: the commit is built in a private index from HEAD and
// the checked bytes (never the working tree's later ones), and HEAD's branch moves by compare-and-swap. No pass while
// another git operation runs (index.lock, a merge, rebase, cherry-pick, revert or bisect): it says "busy" and the next
// pass commits. It never pushes, and it runs no git hook (it has checked what it commits; nothing else goes in).
import { execFileSync } from 'node:child_process'
import crypto from 'node:crypto'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { memoryProblems } from './lib/memory.mjs'
import { secretsIn } from './lib/secret-scan.mjs'
import { projectName } from './lib/svc.mjs'

const P = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
const MEM = path.join(P, 'memory')
const RUN = path.join(P, '.run')
const AUTHORS = path.join(RUN, 'memory-authors.log')
const STATE = path.join(RUN, 'memory-commit.json')
const LOCK = path.join(RUN, 'memory-commit.lock')
const ROLE_RE = /^[a-z][a-z0-9-]{1,23}$/
const NOTE_RE = /^[\w.-]+\.md$/

/** The roles that may author a note: the board's leads (leads/roles.json) and setup. */
function roles() {
  try { return new Set([...JSON.parse(fs.readFileSync(path.join(P, 'leads', 'roles.json'), 'utf8')).roles.map((r) => r.id), 'setup']) } catch { return new Set(['setup']) }
}

// --- the hook ---------------------------------------------------------------------------------------------------------
/** The memory/ file name a hook's tool call wrote, or null (a path elsewhere; the link is followed). */
function memoryFileOf(p) {
  if (typeof p !== 'string' || !p.startsWith('/')) return null
  const name = path.basename(p)
  if (!NOTE_RE.test(name)) return null
  let dir
  try { dir = fs.realpathSync(path.dirname(p)) } catch { return null }
  let mem
  try { mem = fs.realpathSync(MEM) } catch { return null }
  return dir === mem ? name : null
}
function note(role) {
  let input = ''
  try { input = fs.readFileSync(0, 'utf8') } catch {}
  let j = {}
  try { j = JSON.parse(input) } catch { return }
  const ti = j.tool_input || {}
  const name = memoryFileOf(ti.file_path ?? ti.path)
  if (!name || !ROLE_RE.test(role || '') || !roles().has(role)) return
  fs.mkdirSync(RUN, { recursive: true })
  fs.appendFileSync(AUTHORS, `${Date.now()}\t${role}\t${name}\n`) // one short append: whole lines, whoever writes at once
}

// --- the pass ---------------------------------------------------------------------------------------------------------
const GIT_ENV = (() => { const e = { ...process.env }; for (const k of Object.keys(e)) if (k.startsWith('GIT_')) delete e[k]; return { ...e, GIT_TERMINAL_PROMPT: '0' } })()
const git = (args, opts = {}) => execFileSync('git', args, { cwd: P, encoding: 'utf8', stdio: ['pipe', 'pipe', 'pipe'], ...opts, env: { ...GIT_ENV, ...(opts.env || {}) } })
const gitPath = (p) => path.resolve(P, git(['rev-parse', '--git-path', p]).trim())

/** Why git is busy here (another operation runs), or null. */
function busy() {
  for (const [p, what] of [['index.lock', 'index.lock'], ['MERGE_HEAD', 'a merge'], ['rebase-merge', 'a rebase'], ['rebase-apply', 'a rebase'],
    ['CHERRY_PICK_HEAD', 'a cherry-pick'], ['REVERT_HEAD', 'a revert'], ['BISECT_LOG', 'a bisect']]) if (fs.existsSync(gitPath(p))) return what
  return null
}
/** Who last wrote each file (the hook's log): name -> role. */
function authors() {
  const out = new Map(), at = new Map()
  let text = ''
  try { text = fs.readFileSync(AUTHORS, 'utf8') } catch {}
  for (const l of text.split('\n')) {
    const [t, role, name] = l.split('\t')
    if (!name || !ROLE_RE.test(role) || !NOTE_RE.test(name)) continue
    if (!(Number(t) < (at.get(name) ?? -1))) { at.set(name, Number(t)); out.set(name, role) }
  }
  return out
}
/** The log keeps the lines of files still not committed, and every line written after `since` (the pass's start: a later
 * write to a committed file is a new change, whose author must stay known). Lines appended after the rename go to a new
 * log, so none is lost. */
function forget(names, since) {
  if (!names.size) return
  const tmp = `${AUTHORS}.${process.pid}`
  try { fs.renameSync(AUTHORS, tmp) } catch { return }
  const keep = fs.readFileSync(tmp, 'utf8').split('\n').filter((l) => l && (!names.has(l.split('\t')[2]) || !(Number(l.split('\t')[0]) <= since)))
  if (keep.length) fs.appendFileSync(AUTHORS, keep.map((l) => l + '\n').join(''))
  fs.rmSync(tmp, { force: true })
}
function readState() { try { return JSON.parse(fs.readFileSync(STATE, 'utf8')) } catch { return {} } }
function writeState(s) { fs.writeFileSync(`${STATE}.tmp`, JSON.stringify(s, null, 2) + '\n'); fs.renameSync(`${STATE}.tmp`, STATE) }

function pass() {
  const start = Date.now()
  // only the project's own config repo (its root is the repo's top): never a repo the folder merely sits in
  let top = null
  try { top = fs.realpathSync(git(['rev-parse', '--show-toplevel']).trim()) } catch {}
  if (top !== fs.realpathSync(P)) return 0
  const why = busy()
  if (why) { console.log(`memory: busy (${why}); nothing committed this pass`); return 0 }
  const ref = (() => { try { return git(['symbolic-ref', '-q', 'HEAD']).trim() } catch { return null } })()
  if (!ref) { console.log('memory: HEAD is detached; nothing committed this pass'); return 0 }
  let head = null
  try { head = git(['rev-parse', '-q', '--verify', `${ref}^{commit}`]).trim() } catch {}
  const algo = (() => { try { return git(['rev-parse', '--show-object-format']).trim() } catch { return 'sha1' } })()
  const blobId = (buf) => crypto.createHash(algo === 'sha256' ? 'sha256' : 'sha1').update(`blob ${buf.length}\0`).update(buf).digest('hex')

  // HEAD's memory/*.md, and the working tree's
  const committed = new Map() // name -> { mode, id }
  if (head) for (const e of git(['ls-tree', '-z', head, '--', 'memory/']).split('\0').filter(Boolean)) {
    const m = /^(\d+) blob (\w+)\tmemory\/([^/]+)$/.exec(e)
    if (m && NOTE_RE.test(m[3])) committed.set(m[3], { mode: m[1], id: m[2] })
  }
  const here = new Map() // name -> bytes
  const other = new Set() // there, but not a plain file (a link, a folder): left alone, never committed or removed
  for (const n of fs.existsSync(MEM) ? fs.readdirSync(MEM) : []) {
    if (!NOTE_RE.test(n)) continue
    const st = fs.lstatSync(path.join(MEM, n))
    if (st.isFile()) here.set(n, fs.readFileSync(path.join(MEM, n))); else other.add(n)
  }
  const changed = [...new Set([...committed.keys(), ...here.keys()])].sort()
    .filter((n) => !other.has(n) && (!here.has(n) || committed.get(n)?.id !== blobId(here.get(n))))

  const state = readState(), told = state.told || {}, nowTold = {}
  const by = authors(), who = roles(), fallback = `memory ${projectName()}`
  const groups = new Map() // author -> [{ name, id | null }]
  for (const n of changed) {
    const buf = here.get(n)
    if (buf) {
      const problems = [...memoryProblems(n, buf.toString('utf8')), ...secretsIn(buf).map((k) => `memory/${n}: looks like ${k}`)]
      if (problems.length) {
        const key = blobId(buf)
        nowTold[n] = key
        if (told[n] !== key) console.error(`memory/${n}: not committed: ${problems.map((p) => p.replace(`memory/${n}: `, '')).join('; ')}`)
        continue
      }
    }
    const a = by.get(n)
    const author = a && who.has(a) ? a : fallback
    if (!groups.has(author)) groups.set(author, [])
    groups.get(author).push({ name: n, buf })
  }
  state.told = nowTold

  const done = new Set()
  const tmpIndex = path.join(os.tmpdir(), `memory-commit-${process.pid}-${crypto.randomBytes(4).toString('hex')}.index`)
  try {
    for (const [author, files] of groups) {
      const env = { GIT_INDEX_FILE: tmpIndex }
      fs.rmSync(tmpIndex, { force: true })
      git(head ? ['read-tree', head] : ['read-tree', '--empty'], { env })
      for (const f of files) {
        if (f.buf) {
          const id = git(['hash-object', '-w', '--stdin'], { input: f.buf }).trim()
          git(['update-index', '--add', '--cacheinfo', `${committed.get(f.name)?.mode === '100755' ? '100755' : '100644'},${id},memory/${f.name}`], { env })
        } else git(['update-index', '--force-remove', '--', `memory/${f.name}`], { env })
      }
      const tree = git(['write-tree'], { env }).trim()
      const names = files.map((f) => f.name)
      const role = author.startsWith('memory ') ? 'memory' : author
      const email = `${role}@${projectName()}.local`
      const msg = `memory: ${author.startsWith('memory ') ? 'the board' : role}'s notes (${names.join(', ')})\n`
      const commit = git(['commit-tree', tree, ...(head ? ['-p', head] : []), '-F', '-'], { input: msg, env: {
        GIT_AUTHOR_NAME: author, GIT_AUTHOR_EMAIL: email, GIT_COMMITTER_NAME: fallback, GIT_COMMITTER_EMAIL: `memory@${projectName()}.local` } }).trim()
      try { git(['update-ref', '-m', `memory-commit: ${author}`, ref, commit, head || '0'.repeat(commit.length)]) }
      catch { console.log(`memory: ${ref} moved or is locked; the rest waits for the next pass`); break }
      head = commit
      for (const n of names) done.add(n)
      console.log(`memory: committed ${commit.slice(0, 9)} by ${author} (${names.join(', ')})`)
    }
  } finally { fs.rmSync(tmpIndex, { force: true }) }

  if (done.size) {
    // the real index follows HEAD for these files only (best effort: another git operation may hold it now)
    if (!busy()) { try { git(['reset', '-q', head, '--', ...[...done].map((n) => `memory/${n}`)]) } catch {} }
    forget(done, start)
  }
  writeState(state)
  return 0
}

function locked(fn) {
  fs.mkdirSync(RUN, { recursive: true })
  try { const st = fs.statSync(LOCK); if (Date.now() - st.mtimeMs > 600000) fs.rmSync(LOCK, { force: true }) } catch {}
  let fd
  try { fd = fs.openSync(LOCK, 'wx') } catch { console.log('memory: another pass runs; nothing committed'); return 0 }
  try { return fn() } finally { fs.closeSync(fd); fs.rmSync(LOCK, { force: true }) }
}

const [cmd, arg] = process.argv.slice(2)
if (cmd === 'note') { try { note(arg) } catch {} process.exit(0) }
else if (!cmd) process.exit(locked(pass))
else { console.error('usage: memory-commit [note <role>]'); process.exit(2) }
