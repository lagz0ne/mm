{
  "_doc": "An ops worker (sy-asaw): investigates the machine read-only and drafts plans; writes only comments on the board, as ops/<name>. No worktree (never one of the brain), no run loop, no migration, no machine change. config-check renders it into the worker's folder and adds the worker denies.",
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(bd show *)",
      "Bash(bd list *)",
      "Bash(bd ready *)",
      "Bash(bd search *)",
      "Bash(bd comments *)",
      "Bash({brain}/bin/brain status*)",
      "Bash({brain}/bin/brain score*)",
      "Bash({brain}/bin/brain lint*)",
      "Bash(git -C {brain} status*)",
      "Bash(git -C {brain} log*)",
      "Bash(git -C {brain} diff*)",
      "Bash(git -C {brain} show*)",
      "Bash(mm ls*)",
      "Bash(mm inspect *)",
      "Bash(mm status*)",
      "Bash(mm doctor*)",
      "Bash(mm obs *)",
      "Bash(svc ls*)",
      "Bash(journalctl *)",
      "Bash(systemctl status *)",
      "Bash(systemctl --user status *)",
      "Bash(systemctl is-active *)",
      "Bash(systemctl --user is-active *)",
      "Bash(systemctl list-units *)",
      "Bash(systemctl --user list-units *)",
      "Bash(systemctl --user list-timers *)",
      "Bash(ss -*)",
      "Bash(df *)",
      "Bash(free *)",
      "Bash(rpm -q *)",
      "Bash(ls *)",
      "Bash(cat /proc/meminfo)", "Bash(cat /proc/loadavg)", "Bash(cat /proc/uptime)", "Bash(cat /proc/pressure/*)", "Bash(cat /proc/mounts)", "Bash(cat /proc/swaps)",
      "Read({brain}/**)",
      "Read({home}/mm/**)",
      "Read({projects}/**)",
      "Read({mm}/**)",
      "Read({home}/.local/state/brain/**)",
      "Read(//var/log/**)",
      "Read(//etc/**)"
    ]
  }
}
