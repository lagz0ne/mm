    "deny": [
      "Read({root}/secrets/**)",
      "Bash(*core.hooksPath*)",
      "Edit({home}/brain/**)",
      "Write({home}/brain/**)",
      "Edit({home}/mm/**)",
      "Write({home}/mm/**)"
    ]
  }
