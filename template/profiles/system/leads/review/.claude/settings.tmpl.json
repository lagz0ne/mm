      "Bash(cd {root}*)",
      "Bash(bin/brain status*)",
      "Bash(bin/brain score*)",
      "Bash(bin/brain lint*)",
      "Bash(bin/brain run status*)",
      "Bash(git -C {home}/brain log*)",
      "Bash(git -C {home}/brain show*)",
      "Bash(git -C {home}/brain diff*)",
      "Bash(git -C {home}/mm log*)",
      "Bash(git -C {home}/mm show*)",
      "Bash(git -C {home}/mm diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git diff*)",
      "Bash(mm ls*)",
      "Bash(mm inspect *)",
      "Bash(mm doctor*)",
      "Bash(mm obs *)",
      "Bash(expose ls)",
      "Bash(paseo ls*)",
      "Bash(journalctl *)",
      "Bash(systemctl status *)",
      "Bash(systemctl --user status *)",
      "Bash(systemctl list-units *)",
      "Bash(systemctl --user list-units *)",
      "Bash(ss -*)",
      "Bash(sudo -n firewall-cmd --list-all*)",
      "Bash(sudo -n fail2ban-client status*)",
      "Bash(rpm -q *)",
