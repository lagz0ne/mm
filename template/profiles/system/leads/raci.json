      "raci": {
        "platform": "R",
        "review": "V",
        "ops": "CI",
        "human": "A"
      },
      "consult": [
        "ops: when a machine step is in the release"
      ]
    },
    {
      "id": "project-rollout",
      "title": "Rollout of projects (mm update; the head holds no T2 work)",
      "raci": {
        "ops": "RA",
        "review": "V",
        "platform": "C",
        "human": "I"
      },
      "consult": [
        "platform: when a gate failed or the head moved"
      ]
    },
    {
      "id": "project-rollout-t2",
      "title": "Rollout of projects (mm update; the head holds T2 work)",
      "raci": {
        "ops": "R",
        "review": "V",
        "platform": "C",
        "human": "A"
      },
      "consult": [
        "platform: when a gate failed or the head moved"
      ]
    },
    {
      "id": "project-governance",
      "title": "Items for projects (on their own boards)",
      "raci": {
        "platform": "R",
        "ops": "C",
        "human": "A",
        "review": "I"
      },
      "consult": [
        "ops: when the item asks a project for a machine step or a service change"
      ]
    },
    {
      "id": "sync",
      "title": "mastermind sync and pushes",
      "raci": {
        "ops": "R",
        "review": "V",
        "platform": "I",
        "human": "A"
      }
    }
  ]
}
