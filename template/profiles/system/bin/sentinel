#!/usr/bin/env node
// sentinel — SRE watch over the whole machine (profile system; every 5 min under mm cron). Turns problems into incident
// items for ops on this board: one item per problem (a stable key), commented when it changes, closed when it clears.
//   conditions (open while present; the sentinel closes them when gone):
//     alert:<text>                `bin/brain status` ALERT lines (the brain: where mm says)      P1
//     brain:<line>                every other `[brain]` status line (not ALERT, not the drift line)            P2
//     cron:<project>/<job>        the last run of a scheduled job failed (<project root>/.run/logs/cron.log)  P1
//     (throwaway test projects, `mm new --throwaway`, and projects mm no longer lists raise nothing)
//     errors:<project>/<service>  new error logs or failed spans on N checks in a row (`mm obs errors`)       P2
//     obs:stack                   the observability stores are down (`mm obs status`)                         P1
//     assist:<user>               an assistant's chat config gives a tool beyond Skill, an MCP server whose tools
//                                 are unverified, a plugin or a start hook (`bin/assist tools <user> --chat`, from its
//                                 files only: it runs nothing; assistants whose mode is off are skipped)          P1
//     sentinel:<source>           the sentinel could not read a source (that source's items are left as they are)
//   events (stay open until someone closes them; later events become comments on the open one):
//     drift                       a new drift block in `bin/brain status` (the first run only records it)      P2
// Every problem goes through the table (sy-mv69.2; leads/raci.json, the when cases: bin/lib/raci.mjs judge). Its events
// are `sentinel:<key>`, and `brain:<the status line>` for a status line. A problem that matches a case inside its bounds
// is routine: no item, its next and verify are logged once per episode. No case, outside the bounds, or a correct of
// "unexpected": one item labelled `unexpected`, for ops, that says why. (This replaces the config's `ignore` list.)
// The bounds read the last applied migration (BRAIN_STATE, else $XDG_STATE_HOME/brain, else ~/.local/state/brain:
// <state>/migrations/<name>), the boot (os.uptime) and the gates runs (MM_GATES_HISTORY, else
// ~/.cache/mm-gates/history.jsonl).
// An item someone closes while its problem is still there mutes that problem until it clears.
// The board is the truth for which items are open (label `sentinel`, line "sentinel key: `<key>`"); .sentinel.json keeps
// counters, mutes, the last drift seen and when each routine problem was first seen. Optional config sentinel.json:
//   { "assignee": "ops", "errors": { "streak": 3, "quiet": 6 } }
// Env (tests): SENTINEL_BRAIN (brain folder), SENTINEL_STATE, SENTINEL_CONFIG, SENTINEL_NOW (ms), SENTINEL_BOOT (ms),
// BRAIN_STATE, MM_GATES_HISTORY, MM_BIN, SVC_URL_BD_SERVE.
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { ROOT, dirs, projectName, requireUrl } from './lib/svc.mjs'
import { cli } from './lib/obs.mjs'
import { formatTask } from './lib/task.mjs'
import { UNEXPECTED, caseLine, cases, judge } from './lib/raci.mjs'
// every item it opens starts with its Task (sy-n3r5; bin/bd's gate and the Supervisor's digest read it). Each item is
// an unexpected finding (sy-mv69.2): the routine ones open none.
const TASK = formatTask({ task: 'Settle this unexpected finding: fix its cause, or add or widen a when case in leads/raci.json.', act: 'incident',
  done: 'the condition is gone, and the sentinel closes this item', verify: ['bd show <this item> --json', 'status closed, by watchdog'] })

cli('sentinel')
const E = process.env
const HOME = E.HOME || os.homedir()
const BRAIN = E.SENTINEL_BRAIN || dirs().brain
const STATE = E.SENTINEL_STATE || path.join(ROOT, '.sentinel.json')
const CONF = (() => { try { return JSON.parse(fs.readFileSync(E.SENTINEL_CONFIG || path.join(ROOT, 'sentinel.json'), 'utf8')) } catch { return {} } })()
const MM = E.MM_BIN || 'mm'
const ASSIGNEE = CONF.assignee || 'ops'
const STREAK = CONF.errors?.streak ?? 3, QUIET = CONF.errors?.quiet ?? 6
const BD = requireUrl('bd-serve')
const ACTOR = 'watchdog' // a system author for wake and the lead briefs (not a human)
const KEY_LINE = /^sentinel key: `([^`]+)`$/m
const COMMENT_EVERY = 3600e3 // at most one change comment per item per hour
const NOW = Number(E.SENTINEL_NOW) || Date.now(), now = new Date(NOW).toISOString()
const SELF = projectName()
// the table: the when cases of leads/raci.json (none when it is missing: every problem is unexpected)
const CASES = (() => { try { return cases(JSON.parse(fs.readFileSync(path.join(ROOT, 'leads', 'raci.json'), 'utf8')).activities) } catch { return [] } })()
const BRAIN_STATE = E.BRAIN_STATE || path.join(E.XDG_STATE_HOME || path.join(HOME, '.local', 'state'), 'brain')
const BOOT = Number(E.SENTINEL_BOOT) || NOW - os.uptime() * 1000
// the times the bounds read, once per run: applied migrations (their marks), the gates runs ([from, to])
const applied = (() => { try { const d = path.join(BRAIN_STATE, 'migrations'); return fs.readdirSync(d).map((n) => {
  let mark = ''; try { mark = fs.readFileSync(path.join(d, n), 'utf8') } catch {}
  return Date.parse(mark.trim().split(/\s+/)[0]) || fs.statSync(path.join(d, n)).mtimeMs }) } catch { return [] } })()
const gates = (() => { try { return fs.readFileSync(E.MM_GATES_HISTORY || path.join(HOME, '.cache', 'mm-gates', 'history.jsonl'), 'utf8').split('\n').flatMap((l) => {
  try { const e = JSON.parse(l), z = Date.parse(e.date); return z ? [[z - (Number(e.secs) || 0) * 1000, z]] : [] } catch { return [] } }) } catch { return [] } })()
/** The table's verdict on a problem (bin/lib/raci.mjs judge), with what it needs: when it was first seen (this episode)
 * and how many episodes in 24 h (state.routine). */
function verdict(p) {
  const st = (state.routine[p.key] ||= { since: null, eps: [] })
  if (st.since === null) { st.since = NOW; st.eps = [...st.eps.filter((t) => NOW - t < 24 * 3600e3), NOW] }
  const at = p.at || NOW
  const ctx = { now: NOW, at, since: st.since, times: st.eps.length, gates, last: { boot: BOOT, migration: Math.max(0, ...applied.filter((t) => t <= at)) || null } }
  return { ...judge(CASES, { events: [`sentinel:${p.key}`, ...(p.events || [])], lines: p.lines || [p.note] }, ctx), first: st.since === NOW }
}

/** Ids, counters and times out, so the same problem keeps the same text. */
const norm = (s) => String(s).replace(/\d{4}-\d\d-\d\d[T ][\d:.]+Z?/g, '<time>').replace(/\b[0-9a-f]{8}(?:-[0-9a-f]{4,12})+\b/gi, '<id>')
  .replace(/\b[0-9a-f]{12,}\b/gi, '<id>').replace(/\d+/g, '#').replace(/\s+/g, ' ').trim()
const run = (cmd, args, t = 60000) => execFileSync(cmd, args, { encoding: 'utf8', timeout: t, stdio: ['ignore', 'pipe', 'pipe'] })
const expand = (p) => p.replace(/^~(?=\/|$)/, os.homedir())
const ms = (t) => Date.parse(t) || 0
const fence = (s) => `\`\`\`\n${String(s).replaceAll('```', "'''")}\n\`\`\``
async function bd(method, p, body) {
  const r = await fetch(`${BD}${p}`, { method, headers: body ? { 'content-type': 'application/json' } : {}, body: body ? JSON.stringify(body) : undefined, signal: AbortSignal.timeout(10000) })
  if (!r.ok) throw new Error(`${method} ${p}: HTTP ${r.status} ${(await r.text()).slice(0, 200)}`)
  return r.json().catch(() => ({}))
}

const state = (() => { try { return JSON.parse(fs.readFileSync(STATE, 'utf8')) } catch { return {} } })()
for (const k of ['muted', 'errors', 'notes', 'said', 'routine']) state[k] ||= {}

// ---------- sources: each returns [{ prefix, sticky?, problems: [{ key, title, priority, body, note }] }] or throws ----------
function brain() {
  const bin = path.join(BRAIN, 'bin', 'brain')
  const out = fs.existsSync(bin) ? run(bin, ['status'], 120000) : ''
  const alerts = [...out.matchAll(/^\[brain\] ALERT (.+)$/gm)].map(([, text]) => ({
    key: `alert:${norm(text).slice(0, 120)}`, priority: 1, title: `Alert: ${text.slice(0, 100)}`, note: text, events: [`brain:ALERT ${text}`], lines: [text],
    body: `\`bin/brain status\` reports:\n\n> ALERT ${text}\n\nSee \`bin/brain status\` and the snapshot. This item closes itself when the alert is gone.` }))
  const drift = []
  const m = /^\[brain\] last drift \(([^)]+)\): (.*)$/m.exec(out)
  if (m && state.drift === undefined) state.drift = m[1] // first run: record, no item for drift from before the sentinel
  else if (m && m[1] !== state.drift) {
    state.drift = m[1]
    drift.push({ key: 'drift', priority: 2, title: 'Drift: the machine changed outside a migration', note: `${m[1]}: ${m[2]}`,
      events: [`brain:last drift (${m[1]}): ${m[2]}`], lines: m[2].split('; '), at: Date.parse(m[1]) || NOW,
      body: `The snapshot at ${m[1]} differs from the one before it:\n\n${fence(m[2].split('; ').join('\n'))}\n\nCheck it was intended (a migration, an update) and record it, or put it back. Later drift is added here as comments; close this item when it is accounted for.` })
  }
  // every other status line (sy-mv69.2: most never reached the board): a condition, through the table like the rest
  const other = new Map()
  for (const [, text] of out.matchAll(/^\[brain\] (.+)$/gm)) {
    if (/^ALERT /.test(text) || /^last drift \(/.test(text)) continue
    const key = `brain:${norm(text).slice(0, 120)}`
    if (!other.has(key)) other.set(key, { key, priority: 2, title: `Brain: ${text.slice(0, 100)}`, note: text, events: [`brain:${text}`], lines: [text],
      body: `\`bin/brain status\` reports:\n\n> ${text}\n\nThis item closes itself when the line is gone.` })
  }
  return [{ prefix: 'alert:', problems: alerts }, { prefix: 'drift', sticky: true, problems: drift }, { prefix: 'brain:', problems: [...other.values()] }]
}

/** Last part of a file: enough for the last run of every job. */
function tail(file, bytes = 64 * 1024) {
  const fd = fs.openSync(file, 'r')
  try { const size = fs.fstatSync(fd).size, n = Math.min(size, bytes), b = Buffer.alloc(n); fs.readSync(fd, b, 0, n, size - n); return b.toString('utf8') } finally { fs.closeSync(fd) }
}
// The machine's projects (mm ls), once per run. Throwaway test projects (mm new --throwaway) raise nothing, and
// neither do projects mm no longer lists (an archived throwaway's errors linger in the logs for a while), apart
// from mm itself and this board.
let listedCache = null
const listed = () => (listedCache ||= JSON.parse(run(MM, ['ls', '-o', 'json'])))
const quiet = (project) => {
  let all; try { all = listed() } catch { return false } // no list: report everything rather than nothing
  const p = all.find((x) => x.project === project)
  return p ? !!p.throwaway : project !== 'mm' && project !== SELF
}

function cron() {
  const problems = []
  for (const p of listed()) {
    if (p.throwaway) continue
    const project = p.project, log = path.join(expand(p.root), '.run', 'logs', 'cron.log')
    if (!fs.existsSync(log)) continue
    const last = {}
    for (const line of tail(log).split('\n')) { try { const r = JSON.parse(line); if (r.job) last[r.job] = r } catch {} }
    for (const [job, r] of Object.entries(last)) {
      if (!r.exit_code || (project === SELF && job === 'sentinel')) continue // own runs: board down = health's
      problems.push({ key: `cron:${project}/${job}`, priority: 1, title: `${project}: scheduled job ${job} failed`, note: norm(r.msg), lines: [String(r.msg)], at: ms(r.time) || NOW,
        body: `The last run of \`${job}\` in **${project}** failed at ${r.time} (exit ${r.exit_code}):\n\n${fence(String(r.msg).slice(0, 1500))}\n\nLog: \`${log.replace(os.homedir(), '~')}\`, or \`mm obs logs 'project:"${project}" service:cron'\`. This item closes itself after the next good run.` })
    }
  }
  return [{ prefix: 'cron:', problems }]
}

function errors() {
  const rows = JSON.parse(run(MM, ['obs', 'errors', '--by', 'service', '--since', '15m', '-o', 'json']))
  const seen = {}
  for (const r of rows) {
    const id = `${r.project}/${r.service}`
    if ((r.kind === 'log' && r.service === 'cron') || id === `${SELF}/sentinel` || quiet(r.project)) continue // cron: its own source
    const fps = (r.sample || []).map((m) => norm(m).slice(0, 200))
    const s = (seen[id] ||= { n: 0, last: 0, fps: new Set() })
    s.n += r.n; s.last = Math.max(s.last, ms(r.last)); fps.forEach((f) => s.fps.add(f))
  }
  const problems = [], onBoard = Object.keys(open).filter((k) => k.startsWith('errors:')).map((k) => k.slice(7))
  for (const id of new Set([...Object.keys(seen), ...Object.keys(state.errors), ...onBoard])) {
    const st = (state.errors[id] ||= { streak: 0, quiet: 0, last: 0, fps: [], open: onBoard.includes(id) }), s = seen[id]
    if (s && s.last > st.last) { st.streak += 1; st.quiet = 0; st.last = s.last; st.fps = [...new Set([...st.fps, ...s.fps])].slice(0, 20) }
    else { st.streak = 0; st.quiet += 1 }
    if (st.quiet >= QUIET || (!st.open && st.streak === 0)) { delete state.errors[id]; continue } // cleared, or a blip that passed
    if (!st.open && st.streak < STREAK) continue
    st.open = true
    const project = id.split('/')[0]
    problems.push({ key: `errors:${id}`, priority: 2, title: `${id} keeps logging errors`, note: st.fps.slice().sort().join('\n'), lines: st.fps, at: st.last || NOW,
      body: `**${id}** logged errors or failed operations on ${STREAK} checks in a row (every 5 min); last at ${new Date(st.last).toISOString()}. What it says (ids and numbers replaced):\n\n${fence(st.fps.join('\n'))}\n\nLook: \`mm obs errors -p ${project} --since 1h\`, \`mm obs logs 'project:"${project}" level:error'\`. If the cause is inside a project, file it on that project's board (\`project-item\`). This item closes itself after ${QUIET * 5} min without errors.` })
  }
  return [{ prefix: 'errors:', problems }]
}

function obs() {
  try { run(MM, ['obs', 'status'], 30000); return [{ prefix: 'obs:', problems: [] }] } catch (e) {
    if (typeof e.status !== 'number') throw e // mm did not run at all
    return [{ prefix: 'obs:', problems: [{ key: 'obs:stack', priority: 1, title: 'Observability stores are down', note: 'down',
      body: `\`mm obs status\` failed:\n\n${fence(String(e.stdout || e.stderr || '').slice(0, 1200))}\n\nUntil they answer, error-based incidents are not raised. Check \`mm obs status\` and the process manager (namespace mm). This item closes itself when they are back.` }] }]
  }
}

/** Each assistant's chat session, as `paseo run` starts it (sy-6dk: Paseo has no per-run tool kill), audited by
 *  bin/assist itself from the session's configuration files (sy-la6o: no Claude Code, MCP server or hook runs here);
 *  exit 5 = a tool beyond Skill, an MCP server with unverified tools, a plugin, a start hook. Any other failure fails
 *  the source. Step 2 (not built): audit what Paseo actually starts, once it exposes its start arguments. */
function assistants() {
  const dir = path.join(ROOT, 'assistants'), problems = [], errs = []
  const users = fs.existsSync(dir) ? fs.readdirSync(dir).filter((u) => u !== '_template' && fs.existsSync(path.join(dir, u, 'CLAUDE.md'))).sort() : []
  for (const user of users) {
    let mode = 'always'; try { mode = fs.readFileSync(path.join(dir, user, 'mode'), 'utf8').trim() || mode } catch {}
    if (mode === 'off') continue
    let out = '', code = 0
    try { out = run('node', [path.join(ROOT, 'bin', 'assist'), 'tools', user, '--chat'], 90000) } catch (e) { out = String(e.stdout || ''); code = typeof e.status === 'number' ? e.status : -1; if (code !== 5) { errs.push(`${user}: ${String(e.stderr || e.message || e).trim().split('\n').pop()}`); continue } }
    if (code !== 5) continue
    let r = {}; try { r = JSON.parse(out.trim().split('\n').pop()) } catch {}
    const extra = String(r.error || '').replace(/^.*allowlist: /, '') || 'unknown'
    problems.push({ key: `assist:${user}`, priority: 1, title: `Assistant for ${user}: its chat session has tools beyond Skill`, note: extra,
      body: `\`bin/assist tools ${user} --chat\` (its conversation agent's configuration, read without starting anything) gives more than Skill: **${extra}**.\n\nAll its tools: ${fence((r.tools || []).join(', ') || '?')}\nMCP servers: ${(r.mcp || []).join(', ') || 'none'} (unverified: ${(r.unverified || []).join(', ') || 'none'})\nHooks: ${(r.hooks || []).join(', ') || 'none'}\n\n\`paseo run\` cannot stop a tool once the session has it: archive its agent now (\`bin/assist stop ${user}\`), then find what added the tool (its \`.claude/settings.json\` and \`.mcp.json\`, \`bin/config-check --render\`, the Claude folder's settings and MCP servers; an MCP server passes only when its allow list names its tools one by one). \`bin/assist chat ${user}\` refuses to start it until this clears; this item closes itself when it does.` })
  }
  if (errs.length) throw new Error(`bin/assist tools --chat failed for ${errs.join('; ')}`)
  return [{ prefix: 'assist:', problems }]
}

// ---------- reconcile with the board ----------
const open = {} // key -> item (the board is the truth)
for (const it of (await bd('GET', '/v0/beads/issues?label=sentinel&limit=500')).items || []) {
  const k = KEY_LINE.exec(it.description || '')?.[1]
  if (k && it.status !== 'closed') open[k] = it
}
const results = [], failed = []
for (const [name, fn] of Object.entries({ brain, cron, errors, obs, assistants })) {
  try { results.push(...fn()) } catch (e) { failed.push({ name, err: String(e.stderr || e.message || e).trim().split('\n').slice(-3).join(' | ').slice(0, 500) }) }
}
results.push({ prefix: 'sentinel:', problems: failed.map((f) => ({ key: `sentinel:${f.name}`, priority: 2, title: `Sentinel cannot read its ${f.name} source`, note: norm(f.err),
  body: `The sentinel could not read **${f.name}**:\n\n${fence(f.err)}\n\nThat source's items are left as they are until it reads again; then this item closes itself.` })) })

let opened = 0, updated = 0, closed = 0
for (const src of results) {
  // through the table first: a routine problem is not present (no item; an open one clears); its next and verify are
  // logged once per episode
  const verdicts = new Map(src.problems.map((p) => [p.key, verdict(p)]))
  for (const [k, v] of verdicts) if (v.routine && v.first) console.log(`${k}: routine, no item: ${caseLine(v.case)}`)
  const present = new Map(src.problems.filter((p) => !verdicts.get(p.key).routine).map((p) => [p.key, p]))
  const seen = new Set(src.problems.map((p) => p.key))
  for (const p of present.values()) {
    const v = verdicts.get(p.key)
    const it = open[p.key]
    if (it) { // open: comment what changed (events always; conditions at most hourly)
      if (state.notes[p.key] === undefined && !src.sticky) { state.notes[p.key] = p.note; state.said[p.key] = NOW; continue } // state lost: adopt
      if (state.notes[p.key] !== p.note && (src.sticky || NOW - (state.said[p.key] || 0) >= COMMENT_EVERY)) {
        await bd('POST', `/v0/beads/issues/${it.id}/comments`, { author: ACTOR, text: `${src.sticky ? 'More' : 'Changed'} at ${now}:\n\n${fence(String(p.note).slice(0, 1500))}` })
        state.notes[p.key] = p.note; state.said[p.key] = NOW; updated++
      }
      continue
    }
    if (!src.sticky) {
      if (state.muted[p.key]) continue
      if (state.notes[p.key] !== undefined) { state.muted[p.key] = now; console.log(`${p.key}: closed by someone while still there; quiet until it clears`); continue }
    }
    const why = `**Unexpected:** ${v.why}.${v.case ? `\n\nIts case: ${caseLine(v.case)}` : ''}`
    const r = await bd('POST', '/v0/beads/issues', { title: p.title, issue_type: 'bug', priority: p.priority, assignee: ASSIGNEE, labels: ['incident', 'act:incident', 'sentinel', UNEXPECTED],
      actor: ACTOR, owner: ACTOR, description: `${TASK}\n\n${p.body}\n\n${why}\n\nsentinel key: \`${p.key}\`` })
    if (r.id) { state.notes[p.key] = p.note; state.said[p.key] = NOW; opened++; console.log(`${p.key}: unexpected (${v.why}); opened ${r.id}`) }
  }
  // a routine problem that is gone ends its episode (its count in 24 h stays, for bounds.times); an event (drift) is
  // one episode each time
  for (const [k, st] of Object.entries(state.routine)) {
    if (!k.startsWith(src.prefix) || (seen.has(k) && !src.sticky)) continue
    st.since = null; st.eps = st.eps.filter((t) => NOW - t < 24 * 3600e3)
    if (!st.eps.length) delete state.routine[k]
  }
  // gone, from a source that read fine: close (conditions) or forget (events, once closed)
  for (const k of new Set([...Object.keys(open), ...Object.keys(state.notes), ...Object.keys(state.muted)])) {
    if (!k.startsWith(src.prefix) || present.has(k)) continue
    if (src.sticky) { if (!open[k]) { delete state.notes[k]; delete state.said[k] } continue }
    if (open[k]) {
      await bd('POST', `/v0/beads/issues/${open[k].id}/comments`, { author: ACTOR, text: `Cleared at ${now}: the sentinel no longer sees it.` })
      await bd('POST', `/v0/beads/issues/${open[k].id}:close`, { actor: ACTOR, reason: 'cleared (sentinel)' })
      closed++; console.log(`${k}: cleared; closed ${open[k].id}`)
    }
    delete state.notes[k]; delete state.muted[k]; delete state.said[k]
  }
}

fs.writeFileSync(STATE, JSON.stringify(state, null, 1))
// a failed source is on the board (sentinel:<source>); exit 0 so it is not reported twice
console.log(`sentinel: ${Object.keys(open).length + opened - closed} open, ${opened} opened, ${updated} updated, ${closed} closed${failed.length ? `; could not read: ${failed.map((f) => `${f.name} (${f.err.slice(0, 120)})`).join(', ')}` : ''}`)
