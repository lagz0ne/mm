# ---------- build ----------

BUILD = {'--quiet': ('q', False), '--tag': ('t', True), '--file': ('f', True), '--build-arg': (None, True)}


def copy_context(src, dst, c):
    """The caller's build folder, copied as checked: only folders and plain files of the caller's own (each opened
    without following a symlink, its owner read from the open file), nothing else. The build reads the copy, so a
    file swapped in later is never read."""
    total = 0
    for top, dirs, files in os.walk(src, followlinks=False):
        rel = os.path.relpath(top, src)
        for d in dirs:
            st = os.lstat(os.path.join(top, d))
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != c['uid']:
                refuse(f'build: {show(os.path.join(rel, d))} is not a folder of the owner\'s')
            os.mkdir(os.path.join(dst, rel, d), 0o755)
        for f in files:
            p = os.path.join(top, f)
            try:
                fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
            except OSError:
                refuse(f'build: {show(os.path.join(rel, f))} is not a plain file of the owner\'s')
            with os.fdopen(fd, 'rb') as fh:
                st = os.fstat(fh.fileno())
                if not stat.S_ISREG(st.st_mode) or st.st_uid != c['uid'] or st.st_nlink != 1:
                    refuse(f'build: {show(os.path.join(rel, f))} is not a plain file of the owner\'s')
                total += st.st_size
                if total > c['max_context']:
                    refuse('build: the folder is too big')
                with open(os.path.join(dst, rel, f), 'xb') as out:
                    shutil.copyfileobj(fh, out)
                os.chmod(os.path.join(dst, rel, f), st.st_mode & 0o755)


def check_build(args, c):
    opts, pos = parse(args, BUILD, interspersed=True)
    if len(pos) != 1:
        refuse('build: one folder')
    tag = one(opts, '--tag')
    if tag is None or not IMAGE.fullmatch(tag):
        refuse(f'build: tag {show(tag)}: only mm-box, mm-egress or mm-doop (box/doop/build.sh)')
    for a in every(opts, '--build-arg'):
        k, _, v = a.partition('=')
        if a not in (f'UID={c["uid"]}', f'HOME_DIR={c["home"]}') and not (k == 'BASE' and (IMAGE.fullmatch(v) or DIGEST.fullmatch(v))):
            refuse(f'build: --build-arg {show(a)}: only UID and HOME_DIR (the owner\'s), and BASE (one of mm\'s images)')
    ctx = pos[0]
    if not ctx.startswith('/'):
        refuse('build: the folder as an absolute path')
    try:
        real = os.path.realpath(ctx, strict=True)
    except OSError:
        refuse(f'build: {show(ctx)} does not exist')
    st = os.lstat(real)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != c['uid'] or st.st_mode & 0o022 \
            or not re.fullmatch(r'mm-box-build-[A-Za-z0-9_]{1,40}', os.path.basename(real)):
        refuse(f'build: {show(ctx)} is not mm\'s build folder (mm-box-build-*, the owner\'s, not writable by others)')
    f = one(opts, '--file')
    rel = 'Dockerfile'
    if f is not None:
        fr = os.path.realpath(f) if f.startswith('/') else os.path.realpath(os.path.join(real, f))
        if not inside(fr, real):
            refuse(f'build: -f {show(f)} is outside the build folder')
        rel = fr[len(real) + 1:]
    return real, rel, opts


def run_build(args, c):
    real, rel, opts = check_build(args, c)
    tmp = tempfile.mkdtemp(prefix='mm-docker-build-', dir='/var/tmp' if c['root'] else None)
    try:
        ctx = os.path.join(tmp, 'ctx')
        os.mkdir(ctx, 0o755)
        copy_context(real, ctx, c)
        if not os.path.isfile(os.path.join(ctx, rel)):
            refuse(f'build: no {show(rel)} in the folder')
        argv = c['docker'] + ['build'] + emit(opts, skip=('--file',)) + [f'--file={os.path.join(ctx, rel)}', ctx]
        return subprocess.run(argv, env=env(c), stdin=subprocess.DEVNULL).returncode
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ---------- the small ones ----------

def check_small(sub, args, c):
    if sub == 'inspect':
        opts, pos = parse(args, {'--format': ('f', True)}, interspersed=True)
        if not pos:
            refuse('inspect: a name')
        for n in pos:
            if not (CONTAINER.fullmatch(n) or NETWORK.fullmatch(n)):
                refuse(f'inspect: {show(n)} is not one of mm\'s containers or networks')
        template(one(opts, '--format') or '')
        return ['inspect'] + emit(opts) + pos
    if sub == 'container':
        if not args or args[0] != 'inspect':
            refuse('container: only inspect')
        opts, pos = parse(args[1:], {'--format': ('f', True)}, interspersed=True)
        if len(pos) != 1:
            refuse('container inspect: one container')
        container(pos[0])
        template(one(opts, '--format') or '')
        return ['container', 'inspect'] + emit(opts) + pos
    if sub in ('rm', 'restart', 'stop'):
        spec = {'--force': ('f', False)} if sub == 'rm' else {'--timeout': ('t', True), '--time': (None, True)}
        opts, pos = parse(args, spec, interspersed=True)
        if not pos:
            refuse(f'{sub}: a container')
        for n in pos:
            container(n)
        for n, v in opts:
            if n != '--force' and not re.fullmatch(r'\d{1,3}', v):
                refuse(f'{sub}: {n} {show(v)}')
        return [sub] + emit(opts) + pos
    if sub == 'kill':
        opts, pos = parse(args, {'--signal': ('s', True)}, interspersed=True)
        if not pos:
            refuse('kill: a container')
        for n in pos:
            container(n)
        sig = one(opts, '--signal')
        if sig is not None and sig.upper().removeprefix('SIG') not in SIGNALS:
            refuse(f'kill: --signal {show(sig)}: only {", ".join(sorted(SIGNALS))}')
        return ['kill'] + emit(opts) + pos
    if sub == 'ps':
        opts, pos = parse(args, {'--all': ('a', False), '--quiet': ('q', False), '--format': (None, True),
                                 '--no-trunc': (None, False), '--filter': ('f', True)}, interspersed=True)
        if pos:
            refuse('ps: no names')
        for f in every(opts, '--filter'):
            if not re.fullmatch(r'(label|name|status|id|network|ancestor|health)=[A-Za-z0-9._:/=*-]{1,200}', f):
                refuse(f'ps: --filter {show(f)}')
        template(one(opts, '--format') or '')
        return ['ps'] + emit(opts)
    if sub == 'images':
        opts, pos = parse(args, {'--all': ('a', False), '--quiet': ('q', False), '--digests': (None, False),
                                 '--no-trunc': (None, False), '--format': (None, True), '--filter': ('f', True)},
                          interspersed=True)
        if len(pos) > 1 or (pos and not REPO.fullmatch(pos[0])):
            refuse('images: at most one image name')
        for f in every(opts, '--filter'):
            if not re.fullmatch(r'dangling=(true|false)|(reference|label|before|since)=[A-Za-z0-9._:/=*-]{1,200}', f):
                refuse(f'images: --filter {show(f)}')
        template(one(opts, '--format') or '')
        return ['images'] + emit(opts) + pos
    if sub == 'rmi':
        opts, pos = parse(args, {'--force': ('f', False), '--no-prune': (None, False)}, interspersed=True)
        if not pos:
            refuse('rmi: an image')
        for n in pos:
            if not IMAGE.fullmatch(n):
                refuse(f'rmi: {show(n)}: only mm\'s own images, by name (mm-box, mm-egress, mm-doop[:<tag>])')
        return ['rmi'] + emit(opts) + pos
    if sub == 'port':
        opts, pos = parse(args, {}, interspersed=True)
        if len(pos) not in (1, 2) or (len(pos) == 2 and not re.fullmatch(r'\d{1,5}(/(tcp|udp|sctp))?', pos[1])):
            refuse('port: one container [and a port]')
        container(pos[0])
        return ['port'] + pos
    if sub == 'pull':
        opts, pos = parse(args, {'--quiet': ('q', False)}, interspersed=True)
        if len(pos) != 1 or not NAMED_DIGEST.fullmatch(pos[0]):
            refuse('pull: one image, by digest (<name>@sha256:<64 hex>)')
        return ['pull'] + emit(opts) + pos
    if sub == 'image':
        if not args or args[0] != 'inspect':
            refuse('image: only inspect')
        opts, pos = parse(args[1:], {'--format': ('f', True)}, interspersed=True)
        if len(pos) != 1:
            refuse('image inspect: one image')
        image(pos[0])
        template(one(opts, '--format') or '')
        return ['image', 'inspect'] + emit(opts) + pos
    if sub == 'network':
        what, rest = (args[0], args[1:]) if args else ('', [])
        if what == 'ls':
            opts, pos = parse(rest, {'--quiet': ('q', False), '--format': (None, True)}, interspersed=True)
            if pos:
                refuse('network ls: no names')
            template(one(opts, '--format') or '')
            return ['network', 'ls'] + emit(opts)
        if what == 'inspect':
            opts, pos = parse(rest, {'--format': ('f', True)}, interspersed=True)
            if not pos:
                refuse('network inspect: a name')
            for n in pos:
                if not (NETWORK.fullmatch(n) or NET_ID.fullmatch(n) or n == 'bridge'):
                    refuse(f'network inspect: {show(n)} is not one of mm\'s networks, the default bridge or a network id')
            template(one(opts, '--format') or '')
            return ['network', 'inspect'] + emit(opts) + pos
        if what == 'rm':
            opts, pos = parse(rest, {}, interspersed=True)
            if not pos:
                refuse('network rm: a network')
            for n in pos:
                network(n)
            return ['network', 'rm'] + pos
        if what == 'create':
            opts, pos = parse(rest, {'--internal': (None, False), '--subnet': (None, True), '--gateway': (None, True),
                                     '--label': (None, True)}, interspersed=True)
            if len(pos) != 1:
                refuse('network create: one name')
            kind, project = network(pos[0])
            o = '231' if kind == 'box' else '232'
            sub_, gw = one(opts, '--subnet'), one(opts, '--gateway')
            m = re.fullmatch(rf'10\.{o}\.(\d{{1,3}})\.0/24', sub_ or '')
            if one(opts, '--internal') is None or not m or gw != f'10.{o}.{m.group(1)}.1':
                refuse(f'network create: only --internal, 10.{o}.<n>.0/24 and its .1')
            labels = sorted(every(opts, '--label'))
            want = sorted([f'mm.project={project}'] + (['mm.service=doop'] if kind == 'doop' else []))
            if labels != want:
                refuse(f'network create: labels only {", ".join(want)}')
            return ['network', 'create'] + emit(opts) + pos
        if what == 'connect':
            opts, pos = parse(rest, {'--ip': (None, True)}, interspersed=True)
            if len(pos) != 2:
                refuse('network connect: a network and a container')
            nk, np = network(pos[0])
            ck, cp = container(pos[1], kinds=('egress', 'box'))
            ip = one(opts, '--ip')
            if nk != 'box' or np != cp or (ip is not None and not re.fullmatch(r'10\.231\.\d{1,3}\.\d{1,3}', ip)):
                refuse('network connect: only a project\'s own container to its own network')
            return ['network', 'connect'] + emit(opts) + pos
        refuse(f'network {show(what)}: only ls, inspect, create, connect, rm')
    refuse(f'{show(sub)}: not a docker call mm makes')


def main(argv):
    c = load_conf()
    if not argv:
        refuse('no docker subcommand')
    sub, args = argv[0], argv[1:]
    if sub.startswith('-'):
        refuse(f'{show(sub)}: no global options{reason(sub.split("=")[0])}')
    if sub == 'build':
        return run_build(args, c)
    if sub == 'cp':
        return run_cp(args, c)
    if sub in ('run', 'create'):
        out, fds = check_run(args, c, sub=sub)
    elif sub == 'exec':
        out, fds = check_exec(args, c)
    elif sub == 'logs':
        out, fds = check_logs(args, c), []
    else:
        out, fds = check_small(sub, args, c), []
    argv2 = c['docker'] + out
    sys.stdout.flush()
    os.execve(shutil.which(argv2[0], path=SAFE_PATH) if '/' not in argv2[0] else argv2[0], argv2, env(c))


if __name__ == '__main__':
    try:
        sys.exit(main(sys.argv[1:]))
    except Refused as e:
        print(f'mm-docker: refused: {e}', file=sys.stderr)
        sys.exit(REFUSED)
