#!/usr/bin/python3 -I
# mm-docker: the only way mm reaches Docker once the host owner has no blanket sudo (plans/host-hardening.md step 3).
# Installed root-owned (root:root 0755, e.g. /usr/local/libexec/mm-docker), with one sudoers entry that names only it;
# mm calls it through its config: box.docker = "sudo -n /usr/local/libexec/mm-docker" (docs/mm-docker.md).
#
# It runs only the docker calls mm itself makes (src/box.ts, template/bin/doop-run, src/doctor.ts), and those of mm's
# container tests and the system board's leads (sy-e6t3: cp, create, logs, port, kill, images, rmi), each on mm's own
# containers, images and folders (or a test's, in the config's test area). Each subcommand is
# an allowlist of exact options, each option's value is checked, and docker gets a command line the wrapper writes
# itself (long options, `--opt=value`), never the caller's words: what was checked is what docker runs.
# It refuses, among the rest: --privileged; a mount of a host path outside the project's own folders (after realpath,
# so `..` and symlinks lead nowhere else); --pid/--ipc/--uts/--userns, --network host; root in a container and any
# --cap-add (root_containers = no, the default: every container mm runs is its own uid, 100000 and up, with no
# capabilities); --device, --mount, --volumes-from; any --sysctl but one, net.ipv4.ip_local_reserved_ports as one range
# inside mm's ports (38000-38999: a port-0 listener in a box never takes one of them); --security-opt other than
# no-new-privileges (always added); global options (-H, --context, --config) and DOCKER_HOST (docker gets a clean
# environment); exec into a container that is not mm's (its name and its mm.project label, then exec by its id); a build whose context is not a folder of the caller's own
# files (copied, as checked, into a private folder first), or whose tag is not mm's; a cp with a container that has
# mounts, or with a host path outside its project (the host side read and written as the owner, never as root).
#
# Config (root's, not the caller's): /etc/mm-docker.conf, `key = value` lines (docs/mm-docker.md). Run as a user
# other than root (no sudo), the wrapper is in test mode: MM_DOCKER_CONF names its config, and it gives no right
# that user doesn't already have.
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile

CONF = '/etc/mm-docker.conf'
REFUSED = 125  # docker's own exit code for its errors: mm sees a failed call
SAFE_PATH = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'


class Refused(Exception):
    pass


def refuse(msg):
    raise Refused(msg)


def show(s):
    """A word for a message: printable, short (a refused value may be anything)."""
    s = str(s)
    s = ''.join(c if c.isprintable() else '?' for c in s)
    return s if len(s) <= 120 else s[:117] + '...'


# ---------- who calls, and the config ----------

def load_conf():
    root = os.geteuid() == 0
    path = CONF if root else os.environ.get('MM_DOCKER_CONF', '')
    if not path:
        refuse('test mode (not root) needs MM_DOCKER_CONF')
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as e:
        refuse(f'no config {path} ({e.strerror})')
    with os.fdopen(fd) as f:
        st = os.fstat(f.fileno())
        if root and (st.st_uid != 0 or st.st_mode & 0o022):
            refuse(f'{path} must be root-owned and writable by root only')
        conf = {}
        for line in f:
            line = line.split('#', 1)[0].strip()
            if not line:
                continue
            k, sep, v = line.partition('=')
            if not sep:
                refuse(f'{path}: not "key = value": {show(line)}')
            conf[k.strip()] = v.strip()
    if root:
        if 'SUDO_UID' not in os.environ or 'SUDO_GID' not in os.environ:
            refuse('run through sudo by the owner (as root, use docker itself)')
        uid, gid = int(os.environ['SUDO_UID']), int(os.environ['SUDO_GID'])
    else:
        uid, gid = os.getuid(), os.getgid()
    try:
        pw = pwd.getpwuid(uid)
    except KeyError:
        refuse(f'uid {uid} has no account')
    if root and conf.get('user', '') != pw.pw_name:
        refuse(f'{pw.pw_name} is not the user in {path}')
    if uid == 0:
        refuse('the caller is root')
    mm = conf.get('mm_home') or os.path.join(pw.pw_dir, '.mm')
    c = {
        'root': root, 'uid': uid, 'gid': gid, 'home': pw.pw_dir,
        'docker': (conf.get('docker') or '/usr/bin/docker').split(),
        'mm': os.path.realpath(mm),
        'projects': os.path.realpath(conf.get('projects') or os.path.join(mm, 'projects')),
        'secrets': os.path.realpath(conf.get('secrets') or f'/run/user/{uid}/mm/secrets'),
        'root_containers': conf.get('root_containers', 'no') == 'yes',
        'max_context': mb(conf, 'max_context_mb', '64'),
        'max_cp': mb(conf, 'max_cp_mb', '512'),
        # the tests' own area (sy-e6t3): a folder <test_root>/<name>/ belongs to the throwaway project <name>, and only
        # a name that starts with test_prefix (none: no test area)
        'test_root': os.path.realpath(conf['test_root']) if conf.get('test_root') else None,
        'test_prefix': conf.get('test_prefix') or 'mmt-',
        # an --env-file goes to docker as the open file (/dev/fd/<n>); `path` (test mode only): as its checked path
        'env_file_by_path': conf.get('env_file', 'fd') == 'path',
    }
    if conf.get('env_file', 'fd') not in ('fd', 'path') or (root and c['env_file_by_path']):
        refuse('env_file: fd (path only in test mode)')
    if not re.fullmatch(r'[a-z][a-z0-9-]{1,20}-', c['test_prefix']):
        refuse(f'test_prefix = {show(c["test_prefix"])}: a short name that ends with -')
    for k in ('mm', 'projects', 'secrets', 'test_root'):
        if c[k] is not None and c[k] in ('/', '/home', '/root', '/etc', '/usr', '/var', '/run', '/tmp', '/var/tmp', pw.pw_dir):
            refuse(f'{k} = {c[k]} is too wide')
    if c['test_root'] and any(c[k] == c['test_root'] or inside(c[k], c['test_root']) or inside(c['test_root'], c[k])
                              for k in ('mm', 'projects', 'secrets')):
        refuse(f'test_root = {c["test_root"]}: apart from mm\'s home, the projects and the secrets')
    return c


def mb(conf, key, default):
    v = conf.get(key, default)
    if not re.fullmatch(r'\d{1,5}', v):
        refuse(f'{key}: a number')
    return int(v) * 1024 * 1024


def env(c):
    e = {'PATH': SAFE_PATH, 'LANG': 'C.UTF-8', 'HOME': '/root' if c['root'] else c['home']}
    t = os.environ.get('TERM', '')
    if re.fullmatch(r'[A-Za-z0-9.+_-]{1,40}', t):
        e['TERM'] = t
    return e


# ---------- names ----------

P = r'[a-z][a-z0-9-]{0,62}'  # a project's name (src/lifecycle.ts)
CONTAINER = re.compile(rf'mm-(box|egress|doop)-({P})')
NETWORK = re.compile(rf'mm-(doop-net|net)-({P})')
# a network's id: docker's own (hex, 12 or 64) or a swarm network's (base 36, 12 or 25: Dokploy's overlay networks);
# mm lists every network by id to learn the machine's docker subnets (box.ts dockerSubnets, the egress deny list)
NET_ID = re.compile(r'[0-9a-f]{12}|[0-9a-f]{64}|[0-9a-z]{12}|[0-9a-z]{25}')
IMAGE = re.compile(r'mm-(box|egress|doop)(:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?')
NAMED_DIGEST = re.compile(r'[a-z0-9][a-z0-9._/-]{0,200}(:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?@sha256:[0-9a-f]{64}')
DIGEST = re.compile(rf'sha256:[0-9a-f]{{64}}|{NAMED_DIGEST.pattern}')
ID = re.compile(r'[0-9a-f]{64}')
REPO = re.compile(r'[a-z0-9][a-z0-9._/-]{0,127}(:[A-Za-z0-9_][A-Za-z0-9._-]{0,127})?')
SIGNALS = {'TERM', 'KILL', 'INT', 'HUP', 'QUIT', 'USR1', 'USR2'}
TEMPLATE_MAX = 400


def container(name, kinds=('box', 'egress', 'doop')):
    m = CONTAINER.fullmatch(name)
    if not m or m.group(1) not in kinds:
        refuse(f'{show(name)} is not one of mm\'s containers ({", ".join("mm-" + k + "-<project>" for k in kinds)})')
    return m.group(1), m.group(2)


def network(name):
    m = NETWORK.fullmatch(name)
    if not m:
        refuse(f'{show(name)} is not one of mm\'s networks (mm-net-<project>, mm-doop-net-<project>)')
    return ('doop' if m.group(1) == 'doop-net' else 'box'), m.group(2)


def image(ref):
    if not (IMAGE.fullmatch(ref) or DIGEST.fullmatch(ref)):
        refuse(f'image {show(ref)}: only mm\'s own (mm-box, mm-egress, mm-doop) or one pinned by digest')
    return ref


def template(t):
    if len(t) > TEMPLATE_MAX or '\n' in t:
        refuse('a --format template longer than one short line')
    return t


# ---------- options, as docker (pflag) reads them ----------
# spec: long name -> (short or None, takes a value). Returns [(long, value or True)], positionals.

def parse(args, spec, interspersed):
    shorts = {s: n for n, (s, _) in spec.items() if s}
    opts, pos, i = [], [], 0
    while i < len(args):
        a = args[i]
        i += 1
        if a == '--':
            pos += args[i:]
            break
        if a.startswith('--'):
            name, eq, val = a.partition('=')
            if name not in spec:
                refuse(f'{show(name)} is not allowed{reason(name)}')
            if spec[name][1]:
                if not eq:
                    if i >= len(args):
                        refuse(f'{name} needs a value')
                    val = args[i]
                    i += 1
                opts.append((name, val))
            else:
                if eq:
                    refuse(f'{name} takes no value')
                opts.append((name, True))
        elif a.startswith('-') and a != '-':
            j = 1
            while j < len(a):
                ch = a[j]
                name = shorts.get(ch)
                if not name:
                    refuse(f'-{show(ch)} is not allowed{reason("-" + ch)}')
                j += 1
                if spec[name][1]:
                    val = a[j:]
                    if val.startswith('='):
                        val = val[1:]
                    if not val:
                        if i >= len(args):
                            refuse(f'-{ch} needs a value')
                        val = args[i]
                        i += 1
                    opts.append((name, val))
                    break
                opts.append((name, True))
        else:
            pos.append(a)
            if not interspersed:
                pos += args[i:]
                break
    return opts, pos


WHY = {
    '--privileged': ': a privileged container is root on the host',
    '--pid': ': it would share a namespace with the host', '--ipc': ': it would share a namespace with the host',
    '--uts': ': it would share a namespace with the host', '--userns': ': it would share a namespace with the host',
    '--cgroupns': ': it would share a namespace with the host', '--net': ': use --network (mm\'s networks only)',
    '--device': ': no host devices', '--device-cgroup-rule': ': no host devices', '--gpus': ': no host devices',
    '--mount': ': mounts only as -v, checked', '--volumes-from': ': mounts only as -v, checked',
    '--volume-driver': ': mounts only as -v, checked', '-H': ': docker\'s own daemon only',
    '--host': ': docker\'s own daemon only', '--context': ': docker\'s own daemon only', '-c': ': docker\'s own daemon only',
    '--config': ': docker\'s own config only', '-p': ': nothing is published on the host',
    '--publish': ': nothing is published on the host', '-P': ': nothing is published on the host',
    '--publish-all': ': nothing is published on the host', '--sysctl': ': no kernel settings',
    '--runtime': ': docker\'s own runtime only', '--cgroup-parent': ': no host cgroups',
    '--log-driver': ': docker\'s own log driver only', '--log-opt': ': docker\'s own log driver only',
    '--secret': ': no host files in a build', '--ssh': ': no host keys in a build',
    '--build-context': ': no host folders in a build', '--output': ': a build writes no host files',
    '-o': ': no output or driver options', '--opt': ': no driver options', '--iidfile': ': a build writes no host files',
    '--cache-to': ': a build writes no host files', '--cache-from': ': no host folders in a build',
    '--allow': ': no build entitlements', '--network': ': not here',
}


def reason(name):
    return WHY.get(name, ' (not an option mm uses here)')


def emit(opts, skip=()):
    return [f'{n}={v}' if v is not True else n for n, v in opts if n not in skip]


def one(opts, name):
    vals = [v for n, v in opts if n == name]
    if len(vals) > 1:
        refuse(f'{name} given twice')
    return vals[0] if vals else None


def every(opts, name):
    return [v for n, v in opts if n == name]


# ---------- host paths ----------

def answers_project(d, c):
    """The project named in d/.mm-answers.yaml (the caller's own file, never followed through a symlink)."""
    try:
        fd = os.open(os.path.join(d, '.mm-answers.yaml'), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except OSError:
        return None
    with os.fdopen(fd, 'rb') as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != c['uid']:
            return None
        m = re.search(rb'^project:[ \t]*["\']?([a-z][a-z0-9-]{0,62})["\']?[ \t]*$', f.read(65536), re.M)
    return m.group(1).decode() if m else None


def inside(p, root):
    return p.startswith(root + '/')


def owner_project(real, c):
    """Which project a host path belongs to, or None: inside one project's folder (its .mm-answers.yaml names it), or
    under mm's per-project folders (box/, paseo/, claude/, egress/ in mm's home; the opened secrets' folder), or a
    test's own folder (<test_root>/<test_prefix>...)."""
    if c['test_root'] and inside(real, c['test_root']):
        name = real[len(c['test_root']) + 1:].split('/')[0]
        return name if re.fullmatch(P, name) and name.startswith(c['test_prefix']) else None
    for base in [os.path.join(c['mm'], k) for k in ('box', 'paseo', 'claude', 'egress')] + [c['secrets']]:
        if inside(real, base):
            name = real[len(base) + 1:].split('/')[0]
            return name if re.fullmatch(P, name) else None
    if inside(real, c['projects']):
        d = real
        while inside(d, c['projects']):
            got = answers_project(d, c)
            if got:
                return got
            d = os.path.dirname(d)
    return None


def host_path(src, project, c, what):
    """A host path a container may get: real (realpath, it must exist), a folder or a plain file, and one of the
    project's own. Returns (real path, project)."""
    if not src.startswith('/'):
        refuse(f'{what} {show(src)}: only an absolute host path (no named volumes)')
    try:
        real = os.path.realpath(src, strict=True)
    except OSError:
        refuse(f'{what} {show(src)} does not exist (docker would make it, as root)')
    st = os.lstat(real)
    if not (stat.S_ISDIR(st.st_mode) or stat.S_ISREG(st.st_mode)):
        refuse(f'{what} {show(src)}: only a folder or a plain file')
    if stat.S_ISREG(st.st_mode) and st.st_nlink != 1:
        refuse(f'{what} {show(src)}: a file with other hard links')
    got = owner_project(real, c)
    if not got:
        refuse(f'{what} {show(src)} (really {show(real)}) is outside the project\'s own folders')
    if project and got != project:
        refuse(f'{what} {show(src)} belongs to {got}, not {project}')
    return real, got


# ---------- run ----------

RUN = {
    '--detach': ('d', False), '--rm': (None, False), '--init': (None, False), '--read-only': (None, False),
    '--name': (None, True), '--hostname': (None, True), '--label': ('l', True), '--network': (None, True),
    '--ip': (None, True), '--restart': (None, True), '--dns': (None, True), '--user': ('u', True),
    '--tmpfs': (None, True), '--cap-drop': (None, True), '--cap-add': (None, True), '--security-opt': (None, True),
    '--pids-limit': (None, True), '--memory': ('m', True), '--cpus': (None, True), '--env': ('e', True),
    '--env-file': (None, True), '--group-add': (None, True), '--volume': ('v', True), '--workdir': ('w', True),
    '--entrypoint': (None, True), '--sysctl': (None, True),
}
EGRESS_CAPS = {'SETUID', 'SETGID'}
# mm's own ports (src/project.ts MM_PORTS): a box may keep them out of its kernel's random ports (sy-gld3), nothing else
MM_PORTS = (38000, 38999)
SYSCTL = 'net.ipv4.ip_local_reserved_ports'
CHOWN_CAPS = {'CHOWN', 'FOWNER', 'DAC_OVERRIDE'}


def check_run(args, c, sub='run'):
    """run, and create (sy-e6t3: the same checks; a created container always has its name)."""
    opts, pos = parse(args, RUN, interspersed=False)
    if not pos:
        refuse(f'{sub}: no image')
    img, cmd = image(pos[0]), pos[1:]
    name = one(opts, '--name')
    kind, project = container(name) if name is not None else (None, None)
    # labels: the project's, and Doop's service label on Doop's container
    for lab in every(opts, '--label'):
        k, _, v = lab.partition('=')
        if k == 'mm.project' and re.fullmatch(P, v) and (project is None or v == project):
            project = v
        elif lab == 'mm.service=doop' and kind == 'doop':
            pass
        else:
            refuse(f'label {show(lab)}: only mm.project=<its project> (and mm.service=doop on Doop)')
    if name is not None and f'mm.project={project}' not in every(opts, '--label'):
        refuse(f'{name} needs its label mm.project={project}')
    if name is None and sub == 'create':
        refuse('create: a created container has its name (mm-<kind>-<project>) and its label')
    if name is None and one(opts, '--rm') is None:
        refuse('run: a container mm keeps has its name (mm-<kind>-<project>); a nameless one is --rm')
    # capabilities: all dropped; added back only in mm's two fixed sets (below)
    if every(opts, '--cap-drop') != ['ALL']:
        refuse('run: --cap-drop ALL, once')
    caps = set(every(opts, '--cap-add'))
    if caps and not c['root_containers']:
        refuse(f'--cap-add {show(",".join(sorted(caps)))}: no capabilities in any container (root_containers = no)')
    for so in every(opts, '--security-opt'):
        if so not in ('no-new-privileges', 'no-new-privileges=true', 'no-new-privileges:true'):
            refuse(f'--security-opt {show(so)}: only no-new-privileges (seccomp, apparmor, label stay docker\'s)')
    # the network: none, or the project's own. None given: docker would put the container on its default bridge (a way
    # out to the internet), so the wrapper adds --network none (sy-rjwg 4), and a call that left it out by mistake still
    # gets no way out (refusing would break nothing safer, and would stop an older mm's one-shot helpers). The one
    # container that keeps docker's default when it gives none is mm's egress proxy (mm-egress-<p>, mm's own image):
    # it is a box's only way out, by design, and its own checks (names, addresses) are the egress list
    net = one(opts, '--network')
    default_none = net is None and kind != 'egress'
    if net is not None and (net in ('host', 'bridge', 'default') or net.startswith('container:') or net.startswith('ns:')):
        refuse(f'--network {show(net)}: it would share the host\'s (or another container\'s) network')
    if net is not None and net != 'none':
        nk, np = network(net)
        if project is None or np != project:
            refuse(f'--network {show(net)}: not the network of {project or "this container"}')
        if (nk == 'doop') != (kind == 'doop'):
            refuse(f'--network {show(net)}: not this container\'s kind of network')
    ip = one(opts, '--ip')
    if ip is not None and (net is None or net == 'none' or not re.fullmatch(r'10\.23[12]\.\d{1,3}\.\d{1,3}', ip)):
        refuse(f'--ip {show(ip)}: only an address on the project\'s own network')
    dns = one(opts, '--dns')
    if dns is not None and dns != '127.0.0.1':
        refuse('--dns: only 127.0.0.1 (no lookups out)')
    restart = one(opts, '--restart')
    if restart is not None and restart not in ('no', 'unless-stopped'):
        refuse(f'--restart {show(restart)}: only no or unless-stopped')
    for g in every(opts, '--group-add'):
        if g != str(c['gid']):
            refuse(f'--group-add {show(g)}: only the owner\'s own group ({c["gid"]})')
    for k, rx in (('--pids-limit', r'[1-9]\d{0,5}'), ('--memory', r'[1-9]\d{0,6}[bkmgBKMG]?'), ('--cpus', r'\d{1,3}(\.\d{1,3})?'),
                  ('--hostname', r'[a-z0-9][a-z0-9.-]{0,62}'), ('--workdir', r'/[^\0\n]{0,4000}')):
        v = one(opts, k)
        if v is not None and not re.fullmatch(rx, v):
            refuse(f'{k} {show(v)}')
    for t in every(opts, '--tmpfs'):
        if not re.fullmatch(r'/[A-Za-z0-9._/-]{0,4000}(:[A-Za-z0-9=,._/-]{0,200})?', t):
            refuse(f'--tmpfs {show(t)}')
    for e in every(opts, '--env'):
        if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]{0,127}=[^\0]*', e, re.S):
            refuse(f'--env {show(e)}: only NAME=value')
    # sysctls: only the one that keeps mm's ports out of the box's random ports (a box has its own network namespace,
    # so it is the box's); one range inside mm's
    sysctl = one(opts, '--sysctl')
    if sysctl is not None:
        k, _, v = sysctl.partition('=')
        if k != SYSCTL:
            refuse(f'--sysctl {show(sysctl)}: only {SYSCTL}=<a-b> (mm\'s ports)')
        m = re.fullmatch(r'(\d{5})-(\d{5})', v)
        if not m or not (MM_PORTS[0] <= int(m.group(1)) <= int(m.group(2)) <= MM_PORTS[1]):
            refuse(f'--sysctl {show(sysctl)}: only one range a-b inside {MM_PORTS[0]}-{MM_PORTS[1]}')
    entry = one(opts, '--entrypoint')
    if entry is not None and entry not in ('sh', 'chown'):
        refuse(f'--entrypoint {show(entry)}: only sh (Doop) or chown (mm\'s helper)')
    # who it runs as: a box's, its egress proxy's or Doop's own uid (never a real account, never root) with the owner's
    # group; or, only with root_containers = yes (an older mm), root in exactly one of its two fixed shapes
    user = one(opts, '--user')
    if user is not None and user != '0:0' and not re.fullmatch(r'[1-9]\d{0,9}:\d{1,10}', user):
        refuse(f'--user {show(user)}: only <uid>:<gid>, by number')
    as_root = user is None or user == '0:0'
    if not as_root:
        u, g = (int(x) for x in user.split(':'))
        if u < 100000 or g != c['gid']:
            refuse(f'--user {show(user)}: only a box\'s own uid (100000 and up) with the owner\'s group ({c["gid"]})')
        try:
            pwd.getpwuid(u)
            refuse(f'--user {u}: a real account on this machine')
        except KeyError:
            pass
        if caps:
            refuse(f'--cap-add {",".join(sorted(caps))}: not for a box\'s own uid')
        if entry == 'chown':
            refuse('--entrypoint chown: only mm\'s chown helper')
    # mounts, each one of the project's own folders (realpath)
    vols = []
    for v in every(opts, '--volume'):
        parts = v.split(':')
        if len(parts) not in (2, 3) or (len(parts) == 3 and parts[2] not in ('ro', 'rw')):
            refuse(f'-v {show(v)}: only <host path>:<path>[:ro]')
        if not re.fullmatch(r'/[^\0\n]{0,4000}', parts[1]):
            refuse(f'-v {show(v)}: the path in the container is absolute')
        real, project = host_path(parts[0], project, c, '-v')
        vols.append((real, parts[1], parts[2] if len(parts) == 3 else ''))
    env_file = one(opts, '--env-file')
    keep_fds = []
    if env_file is not None:
        try:
            fd = os.open(env_file, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        except OSError:
            refuse(f'--env-file {show(env_file)}: not a plain file of the owner\'s')
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != c['uid'] or st.st_nlink != 1:
            refuse(f'--env-file {show(env_file)}: not a plain file of the owner\'s')
        real = os.readlink(f'/proc/self/fd/{fd}')
        if owner_project(real, c) is None or (project and owner_project(real, c) != project):
            refuse(f'--env-file {show(env_file)}: outside the project\'s own folders')
        os.set_inheritable(fd, True)
        keep_fds.append(fd)
        # test mode only (no right to gain): its docker may be `sudo -n docker`, and sudo closes every fd above 2
        env_file = real if c['env_file_by_path'] else f'/dev/fd/{fd}'
    if as_root:
        if not c['root_containers']:
            refuse('run: this would run as root in the container (root_containers = no: every container runs as '
                   'its own uid, 100000 and up, with --user <uid>:<the owner\'s group>)')
        # root_containers = yes: only for an mm older than sy-58fo (it ran these two as root); not a root boundary
        if user is None and kind == 'egress' and caps <= EGRESS_CAPS and net is None and IMAGE.fullmatch(img) \
                and img.startswith('mm-egress') and entry is None:
            pass  # the egress proxy (src/box.ts up): root in its image, it drops to its own user itself
        elif user == '0:0' and name is None and net == 'none' and caps <= CHOWN_CAPS and entry == 'chown' \
                and IMAGE.fullmatch(img) and img.startswith('mm-box') and not every(opts, '--env') and env_file is None:
            # mm's chown helper (src/box.ts giveBack): the owner gets back what the box made, in its mounts only
            dirs = cmd[3:]
            if cmd[:3] != ['-R', '--no-dereference', f'{c["uid"]}:{c["gid"]}'] or not dirs \
                    or sorted(dirs) != sorted(dst for _, dst, _ in vols):
                refuse('chown helper: only chown -R --no-dereference <owner> <its own mounts>')
            for real, dst, mode in vols:
                if mode == 'ro':
                    refuse('chown helper: its mounts are read-write')
        else:
            refuse('run: as root, or with capabilities, only mm\'s egress proxy and chown helper (exactly)')
    out = [sub, '--pull=never', '--security-opt=no-new-privileges'] + (['--network=none'] if default_none else [])
    for n, val in opts:
        if n in ('--security-opt', '--volume', '--env-file'):
            continue
        out.append(f'{n}={val}' if val is not True else n)
    for real, dst, mode in vols:
        out.append(f'--volume={real}:{dst}' + (f':{mode}' if mode else ''))
    if env_file is not None:
        out.append(f'--env-file={env_file}')
    return out + [img] + cmd, keep_fds


# ---------- exec ----------

EXEC = {'--interactive': ('i', False), '--tty': ('t', False), '--workdir': ('w', True), '--env': ('e', True)}


def check_exec(args, c):
    opts, pos = parse(args, EXEC, interspersed=False)
    if len(pos) < 2:
        refuse('exec: a container and a command')
    name, cmd = pos[0], pos[1:]
    _, project = container(name, kinds=('box', 'doop'))
    for e in every(opts, '--env'):
        if not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]{0,127}=[^\0]*', e, re.S):
            refuse(f'--env {show(e)}: only NAME=value')
    w = one(opts, '--workdir')
    if w is not None and not re.fullmatch(r'/[^\0\n]{0,4000}', w):
        refuse(f'--workdir {show(w)}')
    return ['exec'] + emit(opts) + [mm_container('exec', name, project, c)[0]] + cmd, []


def mm_container(what, name, project, c):
    """Is it really mm's? Its own name and its project's label, by docker. Returns (its full id, how many mounts it
    has): the call then names it by its id, not a name that could change in between."""
    r = subprocess.run(c['docker'] + ['container', 'inspect', '--format',
                                      '{{.Id}}|{{.Name}}|{{index .Config.Labels "mm.project"}}|{{len .Mounts}}', name],
                       env=env(c), stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=60)
    got = r.stdout.strip().split('|') if r.returncode == 0 else []
    if len(got) != 4 or not ID.fullmatch(got[0]) or got[1] != '/' + name or got[2] != project \
            or not re.fullmatch(r'\d{1,4}', got[3]):
        refuse(f'{what}: {show(name)} is not labelled as mm\'s (mm.project={project})')
    return got[0], int(got[3])


# ---------- cp (sy-e6t3) ----------
# Only between the host and an mm container that has no mounts at all: docker cp mounts a container's host folders
# again, by their path, as root (CVE-2018-15664: a folder swapped for a symlink in between is followed), so a container
# with a mount is refused. The host side is `-` (a tar stream, the caller's own), or a path in the container's own
# project folder (or its test's), read or written by a process of the owner's (never as root). What goes into a
# container is copied again by the wrapper, as checked: folders, plain files and links only, no setuid/setgid bits.

OWNER_TAR = '''import os, sys, tarfile
p = sys.argv[1]
with tarfile.open(fileobj=sys.stdout.buffer, mode="w|") as t:
    t.add(p, arcname=os.path.basename(p))
'''
OWNER_UNTAR = '''import sys, tarfile
with tarfile.open(fileobj=sys.stdin.buffer, mode="r|") as t:
    t.extractall(sys.argv[1], filter="tar")
'''


def as_owner(c):
    """subprocess options: the child runs as the owner, with the owner's own groups only (in test mode: already)."""
    if not c['root']:
        return {}
    return {'user': c['uid'], 'group': c['gid'], 'extra_groups': os.getgrouplist(pwd.getpwuid(c['uid']).pw_name, c['gid'])}


def cp_side(s):
    if s == '-':
        return '-', None, None
    if s.startswith('/'):
        return 'host', None, s
    name, sep, path = s.partition(':')
    if not sep or not re.fullmatch(r'/[^\0\n]{0,4000}', path):
        refuse(f'cp: {show(s)}: an absolute host path, -, or <container>:<absolute path>')
    return 'ctr', name, path


def rel_ok(n):
    return n and not n.startswith('/') and '..' not in n.split('/') and '\0' not in n


def clean_tar(inp, out, limit):
    """Copy a tar stream, as checked: names inside it, folders, plain files and links (as the container sees them),
    modes without setuid, setgid or sticky, owned by the container's root. Anything else refuses the whole copy."""
    import tarfile
    try:
        copy_tar(tarfile, inp, out, limit)
    except (tarfile.TarError, EOFError, UnicodeError) as e:
        refuse(f'cp: not a tar stream mm-docker reads ({show(e)})')


def copy_tar(tarfile, inp, out, limit):
    total = 0
    with tarfile.open(fileobj=inp, mode='r|') as tin, tarfile.open(fileobj=out, mode='w|', format=tarfile.PAX_FORMAT) as tout:
        for m in tin:
            if not rel_ok(m.name.rstrip('/')) and m.name not in ('.', './'):
                refuse(f'cp: {show(m.name)} in the copy leads out of its folder')
            n = tarfile.TarInfo(m.name)
            n.mode, n.mtime, n.uid, n.gid = m.mode & 0o777, m.mtime, 0, 0
            if m.isreg():
                total += m.size
                if total > limit:
                    refuse('cp: the copy is too big (max_cp_mb)')
                n.size = m.size
                tout.addfile(n, tin.extractfile(m))
            elif m.isdir():
                n.type = tarfile.DIRTYPE
                tout.addfile(n)
            elif m.issym() or m.islnk():
                if m.islnk() and not rel_ok(m.linkname):
                    refuse(f'cp: the hard link {show(m.name)} leads out of the copy')
                n.type, n.linkname = m.type, m.linkname
                tout.addfile(n)
            else:
                refuse(f'cp: {show(m.name)} is not a folder, a plain file or a link')


def run_cp(args, c):
    opts, pos = parse(args, {'--quiet': ('q', False)}, interspersed=True)
    if len(pos) != 2:
        refuse('cp: a source and a destination')
    (sk, sname, spath), (dk, dname, dpath) = cp_side(pos[0]), cp_side(pos[1])
    if [sk, dk].count('ctr') != 1:
        refuse('cp: between the host and one of mm\'s containers only')
    name, cpath = (sname, spath) if sk == 'ctr' else (dname, dpath)
    _, project = container(name)
    cid, mounts = mm_container('cp', name, project, c)
    if mounts:
        refuse(f'cp: {show(name)} has mounts (docker cp would mount their host folders again, as root, by their path)')
    host = dpath if sk == 'ctr' else spath
    if host is not None:
        try:
            real = os.path.realpath(host, strict=True)
        except OSError:
            refuse(f'cp: {show(host)} does not exist')
        got = owner_project(real, c)
        if got != project:
            refuse(f'cp: {show(host)} (really {show(real)}) is not a folder of {project}\'s own')
        if sk == 'ctr' and not os.path.isdir(real):
            refuse(f'cp: {show(host)}: copied into an existing folder only')
    docker, e = c['docker'] + ['cp'] + emit(opts), env(c)
    if sk == 'ctr' and dk == '-':
        return subprocess.run(docker + [f'{cid}:{cpath}', '-'], env=e, stdin=subprocess.DEVNULL).returncode
    if sk == 'ctr':
        d = subprocess.Popen(docker + [f'{cid}:{cpath}', '-'], env=e, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE)
        x = subprocess.run([sys.executable, '-I', '-c', OWNER_UNTAR, real], env=e, stdin=d.stdout, cwd='/', **as_owner(c))
        d.stdout.close()
        rd = d.wait()
        return rd or x.returncode
    with tempfile.TemporaryFile(dir='/var/tmp' if c['root'] else None) as buf:
        if sk == '-':
            clean_tar(sys.stdin.buffer, buf, c['max_cp'])
        else:
            t = subprocess.Popen([sys.executable, '-I', '-c', OWNER_TAR, real], env=e, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.PIPE, cwd='/', **as_owner(c))
            try:
                clean_tar(t.stdout, buf, c['max_cp'])
            finally:
                t.stdout.close()
                rt = t.wait()
            if rt:
                refuse(f'cp: {show(spath)} could not be read as the owner')
        buf.seek(0)
        return subprocess.run(docker + ['-', f'{cid}:{cpath}'], env=e, stdin=buf).returncode


