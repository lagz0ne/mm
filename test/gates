#!/bin/sh
# test/gates <base>..<head> [--list] [--out <file>] [--item <id>] [--no-live] [--bin <mm>] [--jobs <n>] [--keep] [--no-rerun]
# The changed files of the range decide the suites (test/gates.map); they run on the head's content in a throwaway
# worktree, and one result file names each suite's outcome and its whole log. See test/lib/gates.mjs.
exec node "$(dirname "$0")/lib/gates.mjs" "$@"
